bleCell","Children":[{"Type":"NodeText","Data":"名称"}]},{"Type":"NodeTableCell","TableCellAlign":2,"Children":[{"Type":"NodeText","Data":"主要简介"}]}]}]},{"Type":"NodeTableRow","TableAligns":[2,0,2],"Children":[{"Type":"NodeTableCell","TableCellAlign":2,"Children":[{"Type":"NodeText","Data":"1"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260207111751-bdk1agj","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"TransFormer"}]},{"Type":"NodeTableCell","TableCellAlign":2}]},{"Type":"NodeTableRow","TableAligns":[2,0,2],"Children":[{"Type":"NodeTableCell","TableCellAlign":2,"Children":[{"Type":"NodeText","Data":"2"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260207111816-bwo195j","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"Vision in TransFormer"}]},{"Type":"NodeTableCell","TableCellAlign":2}]},{"Type":"NodeTableRow","TableAligns":[2,0,2],"Children":[{"Type":"NodeTableCell","TableCellAlign":2,"Children":[{"Type":"NodeText","Data":"3"}]},{"Type":"NodeTableCell","Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260207105800-v8xfwhy","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"DETR"}]},{"Type":"NodeTableCell","TableCellAlign":2}]}]},{"ID":"20260207111849-vjnsuwo","Type":"NodeParagraph","Properties":{"id":"20260207111849-vjnsuwo","updated":"20260207111849"}}]}