NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"1\\times1"},{"Type":"NodeText","Data":" 卷积 来增强非线性表达能力并降低维度；二是使用 全局平均池化 替代最后的全连接层，大幅减少了参数量并防止过拟合。这两项设计对后来的 GoogLeNet 和 ResNet 产生了深远影响。"}]}]},{"Type":"NodeTableRow","TableAligns":[2,0,2],"Children":[{"Type":"NodeTableCell","TableCellAlign":2,"Properties":{"colspan":"1","rowspan":"2"},"Children":[{"Type":"NodeKramdownSpanIAL","Data":"{: colspan=\"1\" rowspan=\"2\"}"},{"Type":"NodeText","Data":"7"},{"Type":"NodeBr"}]},{"Type":"NodeTableCell","Properties":{"colspan":"1","rowspan":"2"},"Children":[{"Type":"NodeKramdownSpanIAL","Data":"{: colspan=\"1\" rowspan=\"2\"}"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260206202357-gdymd2a","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"DenseNet"},{"Type":"NodeBr"}]},{"Type":"NodeTableCell","TableCellAlign":2,"Properties":{"colspan":"1","rowspan":"2"},"Children":[{"Type":"NodeKramdownSpanIAL","Data":"{: colspan=\"1\" rowspan=\"2\"}"},{"Type":"NodeText","Data":"DenseNet 极致的特征重用。CVPR 2017 最佳论文。其核心是密集连接，在一个模块内，每一层都直接接收前面所有层的输出作为输入。这种设计最大化了信息流和梯度传播，缓解了梯度消失问题，且相比 ResNet，它能以更少的参数量实现极高的性能，显著提升了特征利用率。"},{"Type":"NodeBr"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"assets/AxMath-20260303130727-gi7zqb1.exe","TextMarkTextContent":"AxMath.exe"}]}]},{"Type":"NodeTableRow","TableAligns":[2,0,2],"Children":[{"Type":"NodeTableCell","TableCellAlign":2,"Properties":{"class":"fn__none"},"Children":[{"Type":"NodeKramdownSpanIAL","Data":"{: class=\"fn__none\"}"}]},{"Type":"NodeTableCell","Properties":{"class":"fn__none"},"Children":[{"Type":"NodeKramdownSpanIAL","Data":"{: class=\"fn__none\"}"}]},{"Type":"NodeTableCell","TableCellAlign":2,"Properties":{"class":"fn__none"},"Children":[{"Type":"NodeKramdownSpanIAL","Data":"{: class=\"fn__none\"}"}]}]}]},{"ID":"20260206195059-9sk3bbk","Type":"NodeThematicBreak","Properties":{"id":"20260206195059-9sk3bbk","updated":"20260206195059"}},{"ID":"20260206203822-2ceq7pn","Type":"NodeHeading