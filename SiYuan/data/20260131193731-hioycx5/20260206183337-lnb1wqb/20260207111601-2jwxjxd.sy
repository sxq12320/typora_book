09140240-jkkxd14","updated":"20260209140318"},"Children":[{"Type":"NodeText","Data":"之前是先进行全连接，然后再进行reshape的操作变成了"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"7\\times 7\\times 30"},{"Type":"NodeText","Data":"的矩阵。"}]},{"ID":"20260209140339-fui5evo","Type":"NodeParagraph","Properties":{"id":"20260209140339-fui5evo","updated":"20260209140651"},"Children":[{"Type":"NodeText","Data":"同时这个网络经过了五次下采样也就是表格中的MaxPool，经过五次下采样之后他的图片的长宽分别变成了原本的三十二分之一。"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"h'=\\frac{h}{32};w'=\\frac{w}{32}"},{"Type":"NodeText","Data":"。同时作者让网络的输出为4"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"412\\times412_esc_newline_"},{"Type":"NodeText","Data":"大小的图片。最终的图片就是"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"13\\times 13 "},{"Type":"NodeText","Data":"大小的图片。"}]},{"ID":"20260209135811-4i17b5c","Type":"NodeParagraph","Properties":{"id":"20260209135811-4i17b5c","updated":"20260209140731"},"Children":[{"Type":"NodeText","Data":"这个网络还起了一个新名字，称作为DarkNet-19。它借鉴了"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260206192147-45jp7aq","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"VGGNet"},{"Type":"NodeText","Data":"以及"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260206192508-7vlgudd","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"ResNet"},{"Type":"NodeText","Data":"的思想。"}]},{"ID":"20260209140657-llnxsa5","Type":"NodeParagraph","Properties":{"id":"20260209140657-llnxsa5","updated":"20260209140808"},"Children":[{"Type":"NodeText","Data":"他的网络架构基本上都是采用了"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"3\\times3"},{"Type":"NodeText","Data":"的卷积，这个是借鉴了"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260206192147-45jp7aq","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"VGGNet"},{"Type":"NodeText","Data":"​"}]},{"ID":"20260209140802-xwpmue9","Type":"NodeParagraph","Properties":{"id":"20260209140802-xwpmue9","updated":"20260209140852"},"Children":[{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"1\\times1"},{"Type":"NodeText","Data":"卷积的使用主要就是为了节省参数，降低参数量的问题。"}]},{"ID":"20260209140903-vnxqjqd","Type":"NodeCallout","Properties":{"id":"20260209140903-vnxqjqd","updated":"20260209141027"},"CalloutType":"CAUTION","CalloutTitle":"Caution","CalloutIcon":"🚨","Children":[{"ID":"20260209140911-mldvc7h","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20260209140911-mldvc7h","updated":"20260209141027"},"Children":[{"ID":"20260209140914-27dfvwm","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20260209140914-27dfvwm","updated":"20260209141026"},"Children":[{"ID":"20260209140914-eg0kw13","Type":"NodeParagraph","Properties":{"id":"20260209140914-eg0kw13","updated":"20260209141026"},"Children":[{"Type":"NodeText","Data":"核心层全部为卷积或池化层不存在全连接层；"}]}]},{"ID":"20260209140927-m4dctl2","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260209140927-m4dctl2","updated":"20260209141025"},"Children":[{"ID":"20260209140927-kr6g359","Type":"NodeParagraph","Properties":{"id":"20260209140927-kr6g359","updated":"20260209141025"},"Children":[{"Type":"NodeText","Data":"卷积核都使用较小的卷积核，比较好，感受野比较大一些；"}]}]},{"ID":"20260209140942-5nfzcwo","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20260209140942-5nfzcwo","updated":"20260209141027"},"Children":[{"ID":"20260209140942-th3qttn","Type":"NodeParagraph","Properties":{"id":"20260209140942-th3qttn","updated":"20260209141027"},"Children":[{"Type":"NodeText","Data":"巧妙的使用1×1卷积，降低参数量。"}]}]}]}]},{"ID":"20260209141531-12dz191","Type":"NodeParagraph","Properties":{"id":"20260209141531-12dz191","updated":"20260209141531"}}]}