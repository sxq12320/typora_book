Data":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260309150653-ap6h8jd","updated":"20260309150653"},"Children":[{"ID":"20260309150653-kzcwasa","Type":"NodeParagraph","Properties":{"id":"20260309150653-kzcwasa","updated":"20260309150659"},"Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260213110830-e0g7dxq","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"YoLoV5"}]}]}]}]}]}]},{"ID":"20260309145729-mppmse7","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260309145729-mppmse7","updated":"20260309151400"},"Children":[{"ID":"20260309145729-l1zon8x","Type":"NodeParagraph","Properties":{"id":"20260309145729-l1zon8x","updated":"20260309151052"},"Children":[{"Type":"NodeText","Data":"DETR系列：Deformable DETR、RT-DETR\n这个系列我超级喜欢，毕竟融合了现阶段最重要的TransFormer的目标检测模块"}]},{"ID":"20260309151023-2xqln4l","Type":"NodeList","ListData":{},"Properties":{"id":"20260309151023-2xqln4l","updated":"20260309151400"},"Children":[{"ID":"20260309151023-uarr93e","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260309151023-uarr93e","updated":"20260309151400"},"Children":[{"ID":"20260309151023-1iuvaf8","Type":"NodeParagraph","Properties":{"id":"20260309151023-1iuvaf8","updated":"20260309151400"},"Children":[{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260207105800-v8xfwhy","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"DETR"},{"Type":"NodeText","Data":"\n"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"核心灵魂：匈牙利匹配算法 (Bipartite Matching Loss)"},{"Type":"NodeText","Data":"除了架构，DETR 的训练能跑通，全靠它独特的损失函数设计。也就是我们在最开始聊到的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"一对一分配"},{"Type":"NodeText","Data":"。它使用匈牙利算法，在 100 个预测框和几个真实的 Ground-truth 框之间，找到一个唯一的、全局代价最小的匹配方案，强制要求网络直接输出最终结果，不留冗余。"}]},{"ID":"20260309151214-b39c7oy","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20260309151214-b39c7oy