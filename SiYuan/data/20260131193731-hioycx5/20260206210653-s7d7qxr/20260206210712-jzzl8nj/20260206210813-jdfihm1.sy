0260206210813-ojyjlfq","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLO（You Only Look Once）是一组实时目标检测机器学习算法。目标检测是一种"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E8%AE%A1%E7%AE%97%E6%9C%BA%E8%A7%86%E8%A7%89\u0026amp;zhida_source=entity","TextMarkTextContent":"计算机视觉"},{"Type":"NodeText","Data":"任务，它使用"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E7%A5%9E%E7%BB%8F%E7%BD%91%E7%BB%9C\u0026amp;zhida_source=entity","TextMarkTextContent":"神经网络"},{"Type":"NodeText","Data":"来定位和分类图像中的物体。这项任务有广泛的应用，从"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E5%8C%BB%E5%AD%A6%E6%88%90%E5%83%8F\u0026amp;zhida_source=entity","TextMarkTextContent":"医学成像"},{"Type":"NodeText","Data":"到"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E8%87%AA%E5%8A%A8%E9%A9%BE%E9%A9%B6%E6%B1%BD%E8%BD%A6\u0026amp;zhida_source=entity","TextMarkTextContent":"自动驾驶汽车"},{"Type":"NodeText","Data":"。多种机器学习算法用于目标检测，其中一种是"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E5%8D%B7%E7%A7%AF%E7%A5%9E%E7%BB%8F%E7%BD%91%E7%BB%9C\u0026amp;zhida_source=entity","TextMarkTextContent":"卷积神经网络"},{"Type":"NodeText","Data":" (CNN)。"}]},{"ID":"20260206210813-e79g017","Type":"NodeParagraph","Properties":{"id":"20260206210813-e79g017","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"CNN 是任何 YOLO 模型的基础，研究人员和工程师使用这些模型来完成目标检测和分割等任务。YOLO 模型是开源的，并且在该领域得到广泛应用。这些模型从一个版本到另一个版本都在不断改进，从而提高了准确性、性能和附加功能。本文将探索整个 YOLO 系列，我们将从原始版本开始到最新版本，探索它们的架构、用例和演示。"}]},{"ID":"20260206210813-80iymow","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260206210813-80iymow","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv1 初版"}]},{"ID":"20260206210813-ml3r2x7","Type":"NodeParagraph","Properties":{"id":"20260206210813-ml3r2x7","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"在推出 YOLO 目标检测之前，研究人员使用了基于卷积神经网络(CNN) 的方法，如 R-CNN 和Fast R-CNN。这些方法使用两步流程，先预测"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E8%BE%B9%E7%95%8C%E6%A1%86\u0026amp;zhida_source=entity","TextMarkTextContent":"边界框"},{"Type":"NodeText","Data":"，然后使用回归对这些框中的物体进行分类。这种方法速度慢且耗资源，但 YOLO 模型彻底改变了目标检测。2016 年，"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Joseph Redmon"},{"Type":"NodeText","Data":" 和 "},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"Ali Farhadi"},{"Type":"NodeText","Data":" 两位大神开发了第一个 YOLO，它通过新的增强架构克服了传统"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E7%9B%AE%E6%A0%87%E6%A3%80%E6%B5%8B%E7%AE%97%E6%B3%95\u0026amp;zhida_source=entity","TextMarkTextContent":"目标检测算法"},{"Type":"NodeText","Data":"的大多数问题。"}]},{"ID":"20260206210813-snhorp1","Type":"NodeParagraph","Properties":{"id":"20260206210813-snhorp1","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"style":"width: 1370px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/v2-b4e9feb98cb510ad782e56c3ad77544a_r-20260206210813-ehfnudk.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1370px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210813-0zq9p6m","Type":"NodeParagraph","Properties":{"id":"20260206210813-0zq9p6m","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"图片来源：YOLO论文的网络结构"}]},{"ID":"20260206210813-1peq3q1","Type":"NodeParagraph","Properties":{"id":"20260206210813-1peq3q1","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"最初的 YOLO 架构由 24 个"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E5%8D%B7%E7%A7%AF%E5%B1%82\u0026amp;zhida_source=entity","TextMarkTextContent":"卷积层"},{"Type":"NodeText","Data":"和 2 个"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E5%85%A8%E8%BF%9E%E6%8E%A5%E5%B1%82\u0026amp;zhida_source=entity","TextMarkTextContent":"全连接层"},{"Type":"NodeText","Data":"组成，灵感来自用于"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E5%9B%BE%E5%83%8F%E5%88%86%E7%B1%BB\u0026amp;zhida_source=entity","TextMarkTextContent":"图像分类"},{"Type":"NodeText","Data":"的GoogLeNet模型。YOLOv1 方法是当时的首创方法。"}]},{"ID":"20260206210813-05qzoa9","Type":"NodeParagraph","Properties":{"id":"20260206210813-05qzoa9","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"网络的初始卷积层从图像中提取特征，而全连接层则预测输出概率和坐标。这意味着边界框和分类都发生在一个步骤中。这一步过程简化了操作并实现了实时效率。此外，YOLO 架构还使用了以下"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E4%BC%98%E5%8C%96%E6%8A%80%E6%9C%AF\u0026amp;zhida_source=entity","TextMarkTextContent":"优化技术"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260206210813-4v4xzhh","Type":"NodeList","ListData":{},"Properties":{"id":"20260206210813-4v4xzhh","updated":"20260206210813"},"Children":[{"ID":"20260206210813-tfqa8xm","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-tfqa8xm","updated":"20260206210813"},"Children":[{"ID":"20260206210813-3140a3q","Type":"NodeParagraph","Properties":{"id":"20260206210813-3140a3q","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"Leaky ReLU 激活：Leaky ReLU 有助于防止"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E7%A5%9E%E7%BB%8F%E5%85%83\u0026amp;zhida_source=entity","TextMarkTextContent":"神经元"},{"Type":"NodeText","Data":"在训练期间可能卡在非活动状态。"}]}]},{"ID":"20260206210813-1hb60s1","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-1hb60s1","updated":"20260206210813"},"Children":[{"ID":"20260206210813-sgwea29","Type":"NodeParagraph","Properties":{"id":"20260206210813-sgwea29","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"Dropout "},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E6%AD%A3%E5%88%99%E5%8C%96\u0026amp;zhida_source=entity","TextMarkTextContent":"正则化"},{"Type":"NodeText","Data":"：YOLOv1 在第一个全连接层之后应用 Dropout 正则化，以防止"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E8%BF%87%E6%8B%9F%E5%90%88\u0026amp;zhida_source=entity","TextMarkTextContent":"过拟合"},{"Type":"NodeText","Data":"。"}]}]},{"ID":"20260206210813-by1847y","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-by1847y","updated":"20260206210813"},"Children":[{"ID":"20260206210813-npnv82x","Type":"NodeParagraph","Properties":{"id":"20260206210813-npnv82x","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"数据增强"}]}]}]},{"ID":"20260206210813-m537m7a","Type":"NodeParagraph","Properties":{"id":"20260206210813-m537m7a","updated":"20260206210813"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"工作原理"}]},{"ID":"20260206210813-t2u9553","Type":"NodeParagraph","Properties":{"id":"20260206210813-t2u9553","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLO 模型的本质是将目标检测视为回归问题。YOLO 方法是将卷积神经网络 (CNN) 应用于整个图像。该网络将图像划分为区域并预测每个区域的边界框和概率。"}]},{"ID":"20260206210813-kn8qiq2","Type":"NodeParagraph","Properties":{"id":"20260206210813-kn8qiq2","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"这些边界框由预测概率加权。然后可以对这些权重进行阈值处理，以仅显示高分检测。"}]},{"ID":"20260206210813-8p1cplf","Type":"NodeParagraph","Properties":{"id":"20260206210813-8p1cplf","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"style":"width: 1060px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/v2-55956a351af15f9c9ac80c24052d0250_r-20260206210813-95bmy5s.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1060px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210813-670j82a","Type":"NodeParagraph","Properties":{"id":"20260206210813-670j82a","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"图片来源；YOLO论文中的检测过程"}]},{"ID":"20260206210813-siioigx","Type":"NodeParagraph","Properties":{"id":"20260206210813-siioigx","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv1 将输入图像划分为网格 (SxS)，每个网格单元负责预测边界框和其中对象的类别概率。每个边界框预测都包含一个置信度score，表示目标出现在框中的可能性。使用"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E4%BA%A4%E5%B9%B6%E6%AF%94\u0026amp;zhida_source=entity","TextMarkTextContent":"交并比"},{"Type":"NodeText","Data":"(IOU) 等技术计算"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=2\u0026amp;q=%E7%BD%AE%E4%BF%A1%E5%BA%A6\u0026amp;zhida_source=entity","TextMarkTextContent":"置信度"},{"Type":"NodeText","Data":"score，这些技术可用于过滤部分预测。尽管 YOLO 方法新颖且速度快，但它也面临一些限制，例如："}]},{"ID":"20260206210813-liz7jmb","Type":"NodeList","ListData":{},"Properties":{"id":"20260206210813-liz7jmb","updated":"20260206210813"},"Children":[{"ID":"20260206210813-chbxzx8","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-chbxzx8","updated":"20260206210813"},"Children":[{"ID":"20260206210813-mlgbvj1","Type":"NodeParagraph","Properties":{"id":"20260206210813-mlgbvj1","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv1 很难准确检测训练中未见到的新物体。"}]}]},{"ID":"20260206210813-oa9kn6x","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-oa9kn6x","updated":"20260206210813"},"Children":[{"ID":"20260206210813-tz4331a","Type":"NodeParagraph","Properties":{"id":"20260206210813-tz4331a","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"空间约束：在 YOLOv1 中，每个网格单元仅预测两个框并且只能有一个类，这使得它很难处理成群出现的小物体，例如鸟群。"}]}]},{"ID":"20260206210813-ijqll50","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-ijqll50","updated":"20260206210813"},"Children":[{"ID":"20260206210813-174ny4f","Type":"NodeParagraph","Properties":{"id":"20260206210813-174ny4f","updated":"20260206210813"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E6%8D%9F%E5%A4%B1%E5%87%BD%E6%95%B0\u0026amp;zhida_source=entity","TextMarkTextContent":"损失函数"},{"Type":"NodeText","Data":"的局限性：YOLOv1 损失函数对小边界框和大边界框中的误差的处理方式相同。大边界框中的小误差通常没问题，但小误差对 IOU 的影响要大得多。"}]}]},{"ID":"20260206210813-p0la1yt","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-p0la1yt","updated":"20260206210813"},"Children":[{"ID":"20260206210813-gvwote0","Type":"NodeParagraph","Properties":{"id":"20260206210813-gvwote0","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"定位错误：YOLOv1 的一个主要问题是准确性，它经常会错误定位图像中物体的位置。"}]}]}]},{"ID":"20260206210813-d6bs1ik","Type":"NodeParagraph","Properties":{"id":"20260206210813-d6bs1ik","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"现在我们已经了解了 YOLO 的基本机制，让我们看看研究人员在下一个版本中如何升级该模型的功能。"}]},{"ID":"20260206210813-up5awk1","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260206210813-up5awk1","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv2（YOLO9000）"}]},{"ID":"20260206210813-p42x2y3","Type":"NodeParagraph","Properties":{"id":"20260206210813-p42x2y3","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLO9000 是在 YOLOv1 发布一年后推出的，旨在解决当时目标"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E6%A3%80%E6%B5%8B%E6%95%B0%E6%8D%AE%E9%9B%86\u0026amp;zhida_source=entity","TextMarkTextContent":"检测数据集"},{"Type":"NodeText","Data":"的局限性。YOLO9000 之所以这样命名，是因为它可以检测超过 9000 个不同的物体类别。这在准确性和泛化方面具有变革性。"}]},{"ID":"20260206210813-kh7wjpn","Type":"NodeParagraph","Properties":{"id":"20260206210813-kh7wjpn","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLO9000 背后的研究人员提出了一种独特的联合训练算法，该算法利用检测和分类数据训练目标检测器。该方法利用标记的检测图像来学习精确定位物体，并使用分类图像来增加其"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E9%B2%81%E6%A3%92%E6%80%A7\u0026amp;zhida_source=entity","TextMarkTextContent":"鲁棒性"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260206210813-y4wiptp","Type":"NodeParagraph","Properties":{"id":"20260206210813-y4wiptp","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"style":"width: 727px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/v2-ff540a5e0d4253e3520b93cada4b622e_r-20260206210813-bmgp4dj.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 727px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210813-gn2l7yk","Type":"NodeParagraph","Properties":{"id":"20260206210813-gn2l7yk","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"图片来源：YOLO9000论文，使用 WordTree 层次结构组合数据集"}]},{"ID":"20260206210813-f89uq0a","Type":"NodeParagraph","Properties":{"id":"20260206210813-f89uq0a","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"通过结合不同数据集的特征，无论是分类还是检测，YOLO9000 都比其前身 YOLOv1 有了很大的改进。YOLO9000 被宣称为更好、更强大、更快。"}]},{"ID":"20260206210813-16gs5uq","Type":"NodeList","ListData":{},"Properties":{"id":"20260206210813-16gs5uq","updated":"20260206210813"},"Children":[{"ID":"20260206210813-cjbf3u8","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-cjbf3u8","updated":"20260206210813"},"Children":[{"ID":"20260206210813-x1znx22","Type":"NodeParagraph","Properties":{"id":"20260206210813-x1znx22","updated":"20260206210813"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E5%B1%82%E6%AC%A1%E5%88%86%E7%B1%BB\u0026amp;zhida_source=entity","TextMarkTextContent":"层次分类"},{"Type":"NodeText","Data":"：YOLO9000 中使用的基于 WordTree 结构的方法，可以增强对未见物体的泛化，并增加物体的词汇量或范围。"}]}]},{"ID":"20260206210813-kh45e91","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-kh45e91","updated":"20260206210813"},"Children":[{"ID":"20260206210813-6pvkran","Type":"NodeParagraph","Properties":{"id":"20260206210813-6pvkran","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"架构变化：YOLO9000 引入了一些变化，例如使用批量归一化来加快训练速度和稳定性、使用锚框或滑动窗口方法，并使用 Darknet-19 作为 backbone。Darknet-19 是一个具有 19 层的 CNN，旨在实现准确和快速。"}]}]},{"ID":"20260206210813-ry587pd","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-ry587pd","updated":"20260206210813"},"Children":[{"ID":"20260206210813-jgt49ug","Type":"NodeParagraph","Properties":{"id":"20260206210813-jgt49ug","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"联合训练：一种允许模型利用分层分类框架并从COCO和ImageNet等分类和检测数据集中学习的算法。"}]}]}]},{"ID":"20260206210813-pxdjmfr","Type":"NodeParagraph","Properties":{"id":"20260206210813-pxdjmfr","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"不过YOLO家族还在不断的完善，接下来我们来看看YOLOv3。"}]},{"ID":"20260206210813-2lo6hri","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260206210813-2lo6hri","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv3 变化虽小，效果却很大"}]},{"ID":"20260206210813-2xbxhwa","Type":"NodeParagraph","Properties":{"id":"20260206210813-2xbxhwa","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"几年后，YOLO 背后的研究人员推出了下一个版本YOLOv3。虽然 YOLO9000 是一个最先进的模型，但目标检测总体上还是有其局限性。提高准确率和速度始终是目标检测模型的目标之一，这也是 YOLOv3 的目标，通过一些小小的调整，我们得到了一个性能更好的模型。"}]},{"ID":"20260206210813-3d9ie4a","Type":"NodeParagraph","Properties":{"id":"20260206210813-3d9ie4a","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"改进从边界框开始，虽然它仍然使用"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=2\u0026amp;q=%E6%BB%91%E5%8A%A8%E7%AA%97%E5%8F%A3\u0026amp;zhida_source=entity","TextMarkTextContent":"滑动窗口"},{"Type":"NodeText","Data":"方法，但 YOLOv3 也有一些增强。YOLOv3 引入了多尺度预测，它可以预测三个不同尺度的边界框。这意味着它可以更有效地检测不同大小的物体。除了其他改进之外，这一改进使 YOLO 重新回到最先进模型的行列，并在速度和准确性之间取得平衡。"}]},{"ID":"20260206210813-d61rq69","Type":"NodeParagraph","Properties":{"id":"20260206210813-d61rq69","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"style":"width: 1060px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/v2-3e29991ffc7acad7f5b3953b9393b912_r-20260206210813-p2upv17.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1060px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210813-87dmf8w","Type":"NodeParagraph","Properties":{"id":"20260206210813-87dmf8w","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"图片来源：YOLOv3论文，与当时其他最先进模型的比较"}]},{"ID":"20260206210813-ph7zayt","Type":"NodeParagraph","Properties":{"id":"20260206210813-ph7zayt","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"如图所示，YOLOv3 使用平均精度(mAP-50) 指标提供了最佳速度和准确度之一。此外，YOLOv3 还引入了以下其他改进。"}]},{"ID":"20260206210813-3phlw85","Type":"NodeList","ListData":{},"Properties":{"id":"20260206210813-3phlw85","updated":"20260206210813"},"Children":[{"ID":"20260206210813-26ou0r0","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-26ou0r0","updated":"20260206210813"},"Children":[{"ID":"20260206210813-a3nhx8x","Type":"NodeParagraph","Properties":{"id":"20260206210813-a3nhx8x","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"backbone：YOLOv3 使用更好、更大的 CNN backbone，即由 53 层组成的 Darknet-53，是 Darknet-19 和深度学习"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E6%AE%8B%E5%B7%AE%E7%BD%91%E7%BB%9C\u0026amp;zhida_source=entity","TextMarkTextContent":"残差网络"},{"Type":"NodeText","Data":"（Resnets）的混合方法，但比 ResNet-101 或 ResNet-152 更高效。"}]}]},{"ID":"20260206210813-emoz9dt","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-emoz9dt","updated":"20260206210813"},"Children":[{"ID":"20260206210813-hlp9k4k","Type":"NodeParagraph","Properties":{"id":"20260206210813-hlp9k4k","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"跨尺度预测：YOLOv3 以三种不同的尺度预测边界框，类似于"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E7%89%B9%E5%BE%81%E9%87%91%E5%AD%97%E5%A1%94%E7%BD%91%E7%BB%9C\u0026amp;zhida_source=entity","TextMarkTextContent":"特征金字塔网络"},{"Type":"NodeText","Data":"。这使模型能够更有效地检测各种尺寸的物体。"}]}]},{"ID":"20260206210813-uwr7nnh","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-uwr7nnh","updated":"20260206210813"},"Children":[{"ID":"20260206210813-bqqaynt","Type":"NodeParagraph","Properties":{"id":"20260206210813-bqqaynt","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"分类器：使用独立的逻辑分类器代替softmax函数，允许每个盒子有多个标签。"}]}]},{"ID":"20260206210813-qa5pq7x","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-qa5pq7x","updated":"20260206210813"},"Children":[{"ID":"20260206210813-fe8930w","Type":"NodeParagraph","Properties":{"id":"20260206210813-fe8930w","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"数据集：研究人员仅在 COCO 数据集上训练 YOLOv3。"}]}]}]},{"ID":"20260206210813-l4h2osl","Type":"NodeParagraph","Properties":{"id":"20260206210813-l4h2osl","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"此外，虽然影响不大，但 YOLOv3 修复了 YOLOv2 中的一个小数据加载错误，这帮助提高了 2 个 mAP 点。接下来，让我们看看 YOLO 模型是如何演变成 YOLOv4 的。"}]},{"ID":"20260206210813-mqegfxt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260206210813-mqegfxt","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv4"}]},{"ID":"20260206210813-e3garkr","Type":"NodeParagraph","Properties":{"id":"20260206210813-e3garkr","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv4继承了 YOLO 家族的精髓，进行了多项改进和优化。让我们深入了解 YOLOv4 的机制。"}]},{"ID":"20260206210813-xb552nl","Type":"NodeParagraph","Properties":{"id":"20260206210813-xb552nl","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"最显著的变化是 3 部分架构，虽然 YOLOv4 仍然是单阶段对象检测网络，但该架构涉及 3 个主要组件，即 backbone、head 和 neck。这种架构拆分是 YOLO 演进过程中非常重要的一步。在 YOLO 中，backbone、head 和 neck 各有自己的功能。"}]},{"ID":"20260206210813-vptl4he","Type":"NodeParagraph","Properties":{"id":"20260206210813-vptl4he","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"backbone 是"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E7%89%B9%E5%BE%81%E6%8F%90%E5%8F%96\u0026amp;zhida_source=entity","TextMarkTextContent":"特征提取"},{"Type":"NodeText","Data":"部分，通常是跨层学习特征的 CNN。然后，neck 细化并组合从 backbone 的不同层提取的特征，从而创建丰富且信息丰富的特征表示。最后，head 进行实际预测，并输出边界框、"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E7%B1%BB%E6%A6%82%E7%8E%87\u0026amp;zhida_source=entity","TextMarkTextContent":"类概率"},{"Type":"NodeText","Data":"和对象性分数。"}]},{"ID":"20260206210813-m5v1hfp","Type":"NodeParagraph","Properties":{"id":"20260206210813-m5v1hfp","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"style":"width: 1296px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/v2-7e80a68130301dffefa336141c07ef17_r-20260206210813-35vb2ix.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1296px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210813-26nerfh","Type":"NodeParagraph","Properties":{"id":"20260206210813-26nerfh","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"对于 YOLOv4，研究人员使用了以下组件作为backbone、neck 和 head。"}]},{"ID":"20260206210813-rckoecv","Type":"NodeList","ListData":{},"Properties":{"id":"20260206210813-rckoecv","updated":"20260206210813"},"Children":[{"ID":"20260206210813-mdvoofl","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-mdvoofl","updated":"20260206210813"},"Children":[{"ID":"20260206210813-7ebp6xy","Type":"NodeParagraph","Properties":{"id":"20260206210813-7ebp6xy","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"backbone：CSPDarknet53 是一个卷积神经网络和用于对象检测的 backbone，它使用采用跨阶段部分网络 (CSPNet) 策略的 DarkNet-53。"}]}]},{"ID":"20260206210813-32sieot","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-32sieot","updated":"20260206210813"},"Children":[{"ID":"20260206210813-mnylok0","Type":"NodeParagraph","Properties":{"id":"20260206210813-mnylok0","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"neck：YOLOv4 采用了改进的空间金字塔池化 (SPP) 和"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E8%B7%AF%E5%BE%84%E8%81%9A%E5%90%88%E7%BD%91%E7%BB%9C\u0026amp;zhida_source=entity","TextMarkTextContent":"路径聚合网络"},{"Type":"NodeText","Data":" (PAN)，使得特征提取更"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E7%BB%86%E7%B2%92%E5%BA%A6\u0026amp;zhida_source=entity","TextMarkTextContent":"细粒度"},{"Type":"NodeText","Data":"，训练效果更佳，性能更佳。"}]}]},{"ID":"20260206210813-pka0e0i","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-pka0e0i","updated":"20260206210813"},"Children":[{"ID":"20260206210813-3aal1xk","Type":"NodeParagraph","Properties":{"id":"20260206210813-3aal1xk","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"head：YOLOv4 采用 YOLOv3 的 (基于锚点的) 架构作为 YOLOv4 的 head。"}]}]}]},{"ID":"20260206210813-k7t3007","Type":"NodeParagraph","Properties":{"id":"20260206210813-k7t3007","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"这并不是 YOLOv4 所引入的全部内容，在优化和选择正确的方法和技术方面还有很多工作要做，接下来让我们来探索一下。"}]},{"ID":"20260206210813-r9553n3","Type":"NodeParagraph","Properties":{"id":"20260206210813-r9553n3","updated":"20260206210813"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"优化"}]},{"ID":"20260206210813-cqmbcdt","Type":"NodeParagraph","Properties":{"id":"20260206210813-cqmbcdt","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"正如研究人员在论文中介绍的那样，YOLOv4 模型附带了两种方法包：Bag of Freebies (BoF) 和 Bag of Specials (BoS)。这些方法对 YOLOv4 的性能起到了重要作用，在本节中，我们将探讨研究人员使用的重要方法。"}]},{"ID":"20260206210813-3tf9z4f","Type":"NodeList","ListData":{},"Properties":{"id":"20260206210813-3tf9z4f","updated":"20260206210813"},"Children":[{"ID":"20260206210813-nt0ky8z","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-nt0ky8z","updated":"20260206210813"},"Children":[{"ID":"20260206210813-8g6wbrn","Type":"NodeParagraph","Properties":{"id":"20260206210813-8g6wbrn","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"马赛克数据增强：这种数据增强方法将 4 张训练图像合并为一张，使模型能够学习在更广泛的环境中检测物体，并减少对大批量大小的需求。研究人员将其用作 BoF 的一部分，用于 backbone 训练。"}]}]},{"ID":"20260206210813-bx73dah","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-bx73dah","updated":"20260206210813"},"Children":[{"ID":"20260206210813-r1yz984","Type":"NodeParagraph","Properties":{"id":"20260206210813-r1yz984","updated":"20260206210813"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E8%87%AA%E5%AF%B9%E6%8A%97%E8%AE%AD%E7%BB%83\u0026amp;zhida_source=entity","TextMarkTextContent":"自对抗训练"},{"Type":"NodeText","Data":" (SAT)：一种两阶段数据增强技术，其中网络欺骗自己并修改输入图像以认为没有物体。然后，它在此修改后的图像上进行训练以提高鲁棒性和"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E6%B3%9B%E5%8C%96%E8%83%BD%E5%8A%9B\u0026amp;zhida_source=entity","TextMarkTextContent":"泛化能力"},{"Type":"NodeText","Data":"。研究人员将其用作检测器或网络 head 的 BoF 的一部分。"}]}]},{"ID":"20260206210813-jer4321","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-jer4321","updated":"20260206210813"},"Children":[{"ID":"20260206210813-g3b5tvm","Type":"NodeParagraph","Properties":{"id":"20260206210813-g3b5tvm","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"交叉小批量标准化 (CmBN)：交叉迭代批量标准化 (CBN) 的修改版本，使训练更适合单个 GPU。研究人员将其用作检测器 BoF 的一部分。"}]}]},{"ID":"20260206210813-yc5rtp9","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-yc5rtp9","updated":"20260206210813"},"Children":[{"ID":"20260206210813-3937flo","Type":"NodeParagraph","Properties":{"id":"20260206210813-3937flo","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"改进的空间注意力模块（SAM）：研究人员将原来的 SAM 从空间注意力（spatial-wisetention）修改为点注意力（point-wisetention），在不增加"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E8%AE%A1%E7%AE%97%E6%88%90%E6%9C%AC\u0026amp;zhida_source=entity","TextMarkTextContent":"计算成本"},{"Type":"NodeText","Data":"的情况下增强了模型对重要特征的关注能力。用作 BoS 的一部分，作为网络检测器的附加块。"}]}]}]},{"ID":"20260206210813-dipusjj","Type":"NodeParagraph","Properties":{"id":"20260206210813-dipusjj","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"然而，这还不是全部，YOLOv4 在 BoS 和 BoF 中使用了许多其他技术，例如 Mish 激活和作为 BoS 一部分的 backbone 的跨阶段部分连接 (CSP)。所有这些优化修改使 YOLOv4 的性能达到了最佳水平，尤其是在速度方面，而且在准确性方面也达到了最佳水平。"}]},{"ID":"20260206210813-1x7avxd","Type":"NodeParagraph","Properties":{"id":"20260206210813-1x7avxd","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"style":"width: 639px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/v2-e547d287d49585ac628eb3496fc717e1_r-20260206210813-acs7m66.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 639px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210813-xyy193x","Type":"NodeParagraph","Properties":{"id":"20260206210813-xyy193x","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"在准确率相当的情况下，YOLOv4 的运行速度是 EfficientDet 的两倍"}]},{"ID":"20260206210813-f26wwnj","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260206210813-f26wwnj","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv5"}]},{"ID":"20260206210813-ct3xor0","Type":"NodeParagraph","Properties":{"id":"20260206210813-ct3xor0","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"虽然YOLOv5没有专门的研究论文，但这个模型给所有开发人员、工程师和研究人员留下了深刻的印象。YOLOv5 是在 YOLOv4 发布几个月后推出的，虽然没有太大的改进，但速度稍快一些。Ultralytics 设计的 YOLOv5 更易于实施，文档更详细，支持多种语言，最值得注意的是 YOLOv5 是基于Pytorch构建的，开发人员可以轻松使用它。"}]},{"ID":"20260206210813-af4yiqm","Type":"NodeParagraph","Properties":{"id":"20260206210813-af4yiqm","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"与此同时，它的前身实现起来稍微困难一些。Ultralytics 宣布 YOLOv5 是世界上最受欢迎的视觉 AI，此外，YOLOv5 还具有一些很棒的功能，例如用于导出模型的不同格式、用于在您自己的数据上进行训练的训练脚本，以及多种训练技巧，例如测试时间增强 (TTA) 和"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E6%A8%A1%E5%9E%8B%E9%9B%86%E6%88%90\u0026amp;zhida_source=entity","TextMarkTextContent":"模型集成"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260206210813-l3dflvc","Type":"NodeParagraph","Properties":{"id":"20260206210813-l3dflvc","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"style":"width: 1060px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/v2-f9bc9d615858b67d9fd1500bc60ec7ab_r-20260206210813-3poyosf.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1060px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210813-y1hzdsh","Type":"NodeParagraph","Properties":{"id":"20260206210813-y1hzdsh","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"不同 YOLOv5 变体的性能"}]},{"ID":"20260206210813-ytbvx0r","Type":"NodeParagraph","Properties":{"id":"20260206210813-ytbvx0r","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"由于 YOLOv5 在架构和"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E5%B7%A5%E4%BD%9C%E6%9C%BA%E5%88%B6\u0026amp;zhida_source=entity","TextMarkTextContent":"工作机制"},{"Type":"NodeText","Data":"上与 YOLOv4 非常相似，但实现起来更简单，因此我们可以轻松尝试。本节将在我们的图像上测试预先训练的 YOLOv5 模型。此实现将在带有 Pytorch 的 Google Colab 笔记本上完成，对于初学者来说很容易。让我们开始吧。"}]},{"ID":"20260206210813-7it9kp9","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20260206210813-7it9kp9","updated":"20260206210813"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"dGV4dA=="},{"Type":"NodeCodeBlockCode","Data":"import torch\nmodel = torch.hub.load('ultralytics/yolov5', 'yolov5s', force_reload=True, trust_repo=True)\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20260206210813-6b0zg1v","Type":"NodeParagraph","Properties":{"id":"20260206210813-6b0zg1v","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"首先，我们导入 Pytorch 并使用以下方法加载模型torch.hub.load，我们将使用 YOLOv5s 模型，这是一个紧凑且非常快的模型。现在我们有了模型，让我们加载一些测试图像并进行推理。"}]},{"ID":"20260206210813-v4t4ja9","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20260206210813-v4t4ja9","updated":"20260206210813"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"dGV4dA=="},{"Type":"NodeCodeBlockCode","Data":"im = '/content/n09835506_ballplayer.jpeg'  # file, Path, PIL.Image, OpenCV, nparray, list\nresults = model(im)  # inference\nresults.save() #or .print(), .show(), .save(), .crop(), .pandas()\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20260206210813-bbta50u","Type":"NodeParagraph","Properties":{"id":"20260206210813-bbta50u","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"我将使用 ImageNet 数据集中的一些样本图像，该模型大约需要 17 毫秒（包括"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E9%A2%84%E5%A4%84%E7%90%86\u0026amp;zhida_source=entity","TextMarkTextContent":"预处理"},{"Type":"NodeText","Data":"）来预测样本图像。以下是 3 个样本的结果。"}]},{"ID":"20260206210813-dz4ifw3","Type":"NodeParagraph","Properties":{"id":"20260206210813-dz4ifw3","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"style":"width: 1060px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/v2-65f6fd7682781392b5302891ac1797e3_r-20260206210813-dq3fkfq.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1060px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210813-qdcctuk","Type":"NodeParagraph","Properties":{"id":"20260206210813-qdcctuk","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv5 small 的样本结果"}]},{"ID":"20260206210813-eramhhw","Type":"NodeParagraph","Properties":{"id":"20260206210813-eramhhw","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"易于使用、持续更新、庞大的社区和良好的文档使 YOLOv5 成为完美的紧凑型模型，可在轻量级硬件上运行，并且几乎实时地提供不错的准确性。YOLO 模型在 YOLOv5 到 YOLOv6 之后不断发展，让我们在下一节中探讨这一点。"}]},{"ID":"20260206210813-v4cc5ry","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260206210813-v4cc5ry","updated":"20260206210855"},"Children":[{"Type":"NodeText","Data":"YOLOv6 工业品质"}]},{"ID":"20260206210813-kba7blw","Type":"NodeParagraph","Properties":{"id":"20260206210813-kba7blw","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv6是 YOLO 系列的一次重大改进，它引入了一些关键的架构和训练变化，以在速度和准确性之间实现更好的平衡。值得注意的是，YOLOv6 以专注于工业应用而脱颖而出。这种工业重点提供了可部署的网络，并更好地考虑了现实环境的限制。"}]},{"ID":"20260206210813-ggsgwhc","Type":"NodeParagraph","Properties":{"id":"20260206210813-ggsgwhc","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"由于速度和准确度之间实现了平衡，它可以在常用硬件上运行，例如 Tesla T4 GPU，这使得在工业环境中部署目标检测变得前所未有的容易。YOLOv6 并不是当时唯一可用的模型，YOLOv5、YOLOX和 YOLOv7 都是部署高效检测器的竞争候选者。现在，让我们讨论一下 YOLOv6 引入的变化。"}]},{"ID":"20260206210813-xkz8cum","Type":"NodeParagraph","Properties":{"id":"20260206210813-xkz8cum","updated":"20260206210855"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"style":"width: 1337px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/v2-1abf9181cb22397b01bc642c7d31128d_r-20260206210813-yz7r2op.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1337px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210813-zg1szd1","Type":"NodeParagraph","Properties":{"id":"20260206210813-zg1szd1","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLO家族，YOLOv6架构"}]},{"ID":"20260206210813-2lkzfem","Type":"NodeList","ListData":{},"Properties":{"id":"20260206210813-2lkzfem","updated":"20260206210813"},"Children":[{"ID":"20260206210813-nas922f","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-nas922f","updated":"20260206210813"},"Children":[{"ID":"20260206210813-hgpya2v","Type":"NodeParagraph","Properties":{"id":"20260206210813-hgpya2v","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"backbone：研究人员使用 EfficientRep 构建 backbone，这是一个硬件感知的 CNN，具有用于小型模型（N 和 S）的 RepBlock 和用于大型模型（M 和 L）的 CSPStackRep Block。"}]}]},{"ID":"20260206210813-vug59gd","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-vug59gd","updated":"20260206210813"},"Children":[{"ID":"20260206210813-w5y9nu6","Type":"NodeParagraph","Properties":{"id":"20260206210813-w5y9nu6","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"neck：使用 "},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=Rep-PAN\u0026amp;zhida_source=entity","TextMarkTextContent":"Rep-PAN"},{"Type":"NodeText","Data":" 拓扑，通过 RepBlocks 或 CSPStackRep Blocks 增强了 YOLOv4 和 YOLOv5 中修改后的 PAN 拓扑。这可以从 backbone 的不同层级更高效地聚合特征。"}]}]},{"ID":"20260206210813-dzuc8w8","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-dzuc8w8","updated":"20260206210813"},"Children":[{"ID":"20260206210813-65fnlqn","Type":"NodeParagraph","Properties":{"id":"20260206210813-65fnlqn","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"head：YOLOv6 引入了高效解耦 head，简化了设计以提高效率。它采用混合通道策略，减少中间 3×3 卷积层的数量，并与 backbone 和 neck 一起缩放宽度。"}]}]}]},{"ID":"20260206210813-x5g1022","Type":"NodeParagraph","Properties":{"id":"20260206210813-x5g1022","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv6 还结合了其他几种技术来增强性能。"}]},{"ID":"20260206210813-5trxljb","Type":"NodeList","ListData":{},"Properties":{"id":"20260206210813-5trxljb","updated":"20260206210813"},"Children":[{"ID":"20260206210813-jb9dtuf","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-jb9dtuf","updated":"20260206210813"},"Children":[{"ID":"20260206210813-mkbx2wy","Type":"NodeParagraph","Properties":{"id":"20260206210813-mkbx2wy","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"标签分配：利用任务对齐学习（TAL）来解决分类和框回归任务之间的不一致问题。"}]}]},{"ID":"20260206210813-f8rz2v5","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-f8rz2v5","updated":"20260206210813"},"Children":[{"ID":"20260206210813-4zvvrek","Type":"NodeParagraph","Properties":{"id":"20260206210813-4zvvrek","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"自我提炼：它将自我提炼应用于分类和回归任务，进一步提高准确性。"}]}]},{"ID":"20260206210813-8nyu06k","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-8nyu06k","updated":"20260206210813"},"Children":[{"ID":"20260206210813-m36kj8n","Type":"NodeParagraph","Properties":{"id":"20260206210813-m36kj8n","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"损失函数：它采用 VariFocal Loss 进行分类，并采用 SIoU 和 GIoU Loss 的组合进行回归。"}]}]}]},{"ID":"20260206210813-3fmwrm3","Type":"NodeParagraph","Properties":{"id":"20260206210813-3fmwrm3","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"style":"width: 800px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/v2-1bab1601ac40423b27fe3bc31b6c051e_r-20260206210813-d2zvk4q.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 800px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210813-tjlmqmj","Type":"NodeParagraph","Properties":{"id":"20260206210813-tjlmqmj","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv6性能"}]},{"ID":"20260206210813-1gb0f5v","Type":"NodeParagraph","Properties":{"id":"20260206210813-1gb0f5v","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv6 代表了一种经过改进和增强的对象检测方法，它借鉴了前代产品的优势，同时引入了创新解决方案来应对实际部署的挑战。它注重效率、准确性和工业适用性，使其成为工业应用的宝贵工具。"}]},{"ID":"20260206210813-qcg2z9o","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260206210813-qcg2z9o","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv7"}]},{"ID":"20260206210813-p1ro1mn","Type":"NodeParagraph","Properties":{"id":"20260206210813-p1ro1mn","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"虽然从技术上讲，YOLOv6 是在YOLOv7之前推出的，但 YOLOv6 的生产版本是在 YOLOv7 之后推出的，并且在性能上超越了 YOLOv7。然而，YOLOv7 引入了一个新概念，称为可训练免费包 (BoF)。这包括一系列细粒度的改进，而不是彻底的改革。"}]},{"ID":"20260206210813-zua54b6","Type":"NodeParagraph","Properties":{"id":"20260206210813-zua54b6","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"这些改进主要集中在优化训练过程和增强模型学习有效表征的能力，而不会显著增加计算成本。以下是 YOLOv7 引入的一些关键特性。"}]},{"ID":"20260206210813-b1kqk8w","Type":"NodeList","ListData":{},"Properties":{"id":"20260206210813-b1kqk8w","updated":"20260206210813"},"Children":[{"ID":"20260206210813-b99o1df","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-b99o1df","updated":"20260206210813"},"Children":[{"ID":"20260206210813-aetpabg","Type":"NodeParagraph","Properties":{"id":"20260206210813-aetpabg","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"模型重新"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E5%8F%82%E6%95%B0%E5%8C%96\u0026amp;zhida_source=entity","TextMarkTextContent":"参数化"},{"Type":"NodeText","Data":"：YOLOv7提​​出了计划的重新参数化模型，这是一种利用梯度传播路径的概念适用于不同"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E7%BD%91%E7%BB%9C%E5%B1%82\u0026amp;zhida_source=entity","TextMarkTextContent":"网络层"},{"Type":"NodeText","Data":"的策略。"}]}]},{"ID":"20260206210813-gbkud0q","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-gbkud0q","updated":"20260206210813"},"Children":[{"ID":"20260206210813-3ysxld5","Type":"NodeParagraph","Properties":{"id":"20260206210813-3ysxld5","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"动态标签分配：具有多个输出层的模型的训练提出了一个新问题：“如何为不同分支的输出分配动态目标？”为了解决这个问题，YOLOv7 引入了一种新的标签分配方法，称为由粗到细的引导标签分配。"}]}]},{"ID":"20260206210813-cfgs0p9","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-cfgs0p9","updated":"20260206210813"},"Children":[{"ID":"20260206210813-qp0ngd2","Type":"NodeParagraph","Properties":{"id":"20260206210813-qp0ngd2","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"扩展和复合缩放：YOLOv7 为对象检测器提出了“扩展”和“复合缩放”方法，可以有效利用参数和计算。"}]}]}]},{"ID":"20260206210813-6iilwm1","Type":"NodeParagraph","Properties":{"id":"20260206210813-6iilwm1","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"style":"width: 1920px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/v2-cd775c8cef675aad039799b1ddda7e68_r-20260206210813-vyllyba.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1920px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210813-9v3l80t","Type":"NodeParagraph","Properties":{"id":"20260206210813-9v3l80t","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv7和其他实时目标检测器对比"}]},{"ID":"20260206210813-de6rrgo","Type":"NodeParagraph","Properties":{"id":"20260206210813-de6rrgo","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv7 专注于细粒度改进和优化策略，以提高实时目标检测器的性能。它强调可训练的 bag-of-freebies、深度监督和架构改进，从而在不牺牲速度的情况下显著提高了准确率，使其成为 YOLO 系列的一项宝贵进步。然而，进化仍在继续，产生了我们接下来要讨论的 YOLOv8。"}]},{"ID":"20260206210813-j457i9a","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260206210813-j457i9a","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv8"}]},{"ID":"20260206210813-bh2yj4d","Type":"NodeParagraph","Properties":{"id":"20260206210813-bh2yj4d","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv8是 YOLO 系列实时目标检测器的迭代版本，在准确度和速度方面具有尖端性能。然而，YOLOv8 没有官方论文，但与 YOLOv5 类似，这是一个用户友好的增强型 YOLO 目标检测模型。由 Ultralytics 开发的 YOLOv8 引入了新功能和优化，使其成为广泛应用中各种目标检测任务的理想选择。以下是其功能的简要概述。"}]},{"ID":"20260206210813-ewyswci","Type":"NodeList","ListData":{},"Properties":{"id":"20260206210813-ewyswci","updated":"20260206210813"},"Children":[{"ID":"20260206210813-e41k0b4","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-e41k0b4","updated":"20260206210813"},"Children":[{"ID":"20260206210813-u50tt7q","Type":"NodeParagraph","Properties":{"id":"20260206210813-u50tt7q","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"先进的 backbone 和 neck 架构"}]}]},{"ID":"20260206210813-r1byqwu","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-r1byqwu","updated":"20260206210813"},"Children":[{"ID":"20260206210813-5023orn","Type":"NodeParagraph","Properties":{"id":"20260206210813-5023orn","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"无锚分割 Ultralytics head：YOLOv8 采用无锚分割 Ultralytics head，与基于锚的方法相比，这有助于提高准确性和提高检测过程的效率。"}]}]},{"ID":"20260206210813-5abccx8","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-5abccx8","updated":"20260206210813"},"Children":[{"ID":"20260206210813-rrrwutl","Type":"NodeParagraph","Properties":{"id":"20260206210813-rrrwutl","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"优化准确度与速度之间的平衡"}]}]}]},{"ID":"20260206210813-ebebems","Type":"NodeParagraph","Properties":{"id":"20260206210813-ebebems","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"除此之外，YOLOv8 还是 Ultralytics 精心维护的模型，提供多种模型，每种模型都专门用于计算机视觉中的特定任务，如检测、分割、分类和姿势检测。由于 YOLOv8 通过 Ultralytics 库易于使用，让我们在演示中尝试一下。"}]},{"ID":"20260206210813-vkrmwvi","Type":"NodeParagraph","Properties":{"id":"20260206210813-vkrmwvi","updated":"20260206210813"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"演示"}]},{"ID":"20260206210813-hrh4avk","Type":"NodeParagraph","Properties":{"id":"20260206210813-hrh4avk","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"本演示将简单使用 Python 中的 Ultralytics 库来推断 YOLOv8 模型。推断 YOLO 模型的方法和选项有很多，以下是预测选项的文档。"}]},{"ID":"20260206210813-56sriz4","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20260206210813-56sriz4","updated":"20260206210813"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"dGV4dA=="},{"Type":"NodeCodeBlockCode","Data":"from ultralytics import YOLO\n# Load a COCO-pretrained YOLOv8s model\nmodel = YOLO(\"yolov8s.pt\")\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20260206210813-dgil9x1","Type":"NodeParagraph","Properties":{"id":"20260206210813-dgil9x1","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"这将导入 Ultralytics 库并加载 YOLOv8 小模型，该模型在准确性和速度之间取得了良好的平衡，如果尚未安装 Ultralytics 库，请确保使用以下命令将其安装在您的笔记本上：!pip 安装 ultralytics。现在，让我们在一些图像上测试一下。"}]},{"ID":"20260206210813-gcj4kjy","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"Properties":{"id":"20260206210813-gcj4kjy","updated":"20260206210813"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```"},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"dGV4dA=="},{"Type":"NodeCodeBlockCode","Data":"results = model(\"/content/city.jpg\", save=True, conf=0.5)\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```"}]},{"ID":"20260206210813-yq7l9m5","Type":"NodeParagraph","Properties":{"id":"20260206210813-yq7l9m5","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"这将运行检测任务，保存结果，并且仅包含至少 0.5 置信度的边界框。下面是我使用的样本图像的结果。"}]},{"ID":"20260206210813-cfgckc7","Type":"NodeParagraph","Properties":{"id":"20260206210813-cfgckc7","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"style":"width: 1060px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/v2-8929fa516486b29ff207140641c04888_r-20260206210813-6wyzglg.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1060px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210813-10rrfrs","Type":"NodeParagraph","Properties":{"id":"20260206210813-10rrfrs","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"图片来源：YOLOv8 结果"}]},{"ID":"20260206210813-5i4zupp","Type":"NodeParagraph","Properties":{"id":"20260206210813-5i4zupp","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"使用 YOLOv8 进行推理的示例。"}]},{"ID":"20260206210813-3f2rgac","Type":"NodeParagraph","Properties":{"id":"20260206210813-3f2rgac","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv8 模型在各种基准数据集上都取得了 SOTA 性能。例如，YOLOv8n 模型在 COCO 数据集上实现了 37.3 的 mAP（平均精度），在 A100 TensorRT 上实现了 0.99 毫秒的速度。接下来，让我们看看 YOLO 家族如何通过 YOLOv9 进一步发展。"}]},{"ID":"20260206210813-1swc0mr","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260206210813-1swc0mr","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv9：精确学习"}]},{"ID":"20260206210813-kbl55r9","Type":"NodeParagraph","Properties":{"id":"20260206210813-kbl55r9","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv9与其前代产品相比采用了不同的方法，直接解决了深度神经网络中的信息丢失问题。它引入了可编程梯度信息 (PGI) 的概念和一种称为广义高效层聚合网络 (GELAN) 的新架构，以解决信息瓶颈问题并确保训练期间可靠的梯度流。"}]},{"ID":"20260206210813-y0tu7wc","Type":"NodeParagraph","Properties":{"id":"20260206210813-y0tu7wc","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"研究人员之所以推出 YOLOv9，是因为现有方法忽略了输入数据在经过逐层特征提取和空间变换时会丢失大量信息，导致梯度不可靠，阻碍模型学习准确表征的能力。"}]},{"ID":"20260206210813-moktgk7","Type":"NodeParagraph","Properties":{"id":"20260206210813-moktgk7","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv9 引入了 PGI，这是一种使用辅助可逆分支生成可靠梯度的新方法。此辅助分支为计算"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E7%9B%AE%E6%A0%87%E5%87%BD%E6%95%B0\u0026amp;zhida_source=entity","TextMarkTextContent":"目标函数"},{"Type":"NodeText","Data":"提供了完整的输入信息，从而确保用于更新网络权重的梯度更具信息量。辅助分支的可逆性质确保在前馈过程中不会丢失任何信息。"}]},{"ID":"20260206210813-to84iv3","Type":"NodeParagraph","Properties":{"id":"20260206210813-to84iv3","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"style":"width: 1368px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/v2-08c4fa54939e8c6d04ac4c3aab264607_r-20260206210813-m255fno.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1368px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210813-xtk2boo","Type":"NodeParagraph","Properties":{"id":"20260206210813-xtk2boo","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"PGI 及相关网络架构和方法"}]},{"ID":"20260206210813-xmybr2g","Type":"NodeParagraph","Properties":{"id":"20260206210813-xmybr2g","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv9 还提出了 GELAN，这是一种新的轻量级架构，旨在最大化信息流并促进获取相关信息进行预测。GELAN 是 ELAN 架构的通用版本，可以利用任何计算块，同时尽可能保持效率和性能。研究人员基于梯度路径"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E8%A7%84%E5%88%92%E8%AE%BE%E8%AE%A1\u0026amp;zhida_source=entity","TextMarkTextContent":"规划设计"},{"Type":"NodeText","Data":"了它，确保信息在网络中高效流动。"}]},{"ID":"20260206210813-i26m1fe","Type":"NodeParagraph","Properties":{"id":"20260206210813-i26m1fe","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"style":"width: 1324px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/v2-6127e4fe0de3356e97499db8144d2fc5_r-20260206210813-ysv78u4.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1324px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210813-y58wv0n","Type":"NodeParagraph","Properties":{"id":"20260206210813-y58wv0n","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"不同网络架构的随机初始权重输出特征图的可视化结果"}]},{"ID":"20260206210813-kt2ue0k","Type":"NodeParagraph","Properties":{"id":"20260206210813-kt2ue0k","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv9 通过关注信息流和梯度质量，为目标检测提供了全新的视角。PGI 和 GELAN 的引入使 YOLOv9 有别于其前代产品。这种对深度神经网络中信息处理基础的关注，可以提高性能，并更好地解释目标检测中的学习过程。"}]},{"ID":"20260206210813-vsgxl3y","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260206210813-vsgxl3y","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv10 实时目标检测"}]},{"ID":"20260206210813-e80y9bz","Type":"NodeParagraph","Properties":{"id":"20260206210813-e80y9bz","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv10的推出对于实时端到端目标检测具有革命性意义。YOLOv10 超越了之前所有的速度和准确度基准，实现了真正的实时目标检测。YOLOv10 通过 NMS-Free 检测消除了非最大抑制 (NMS) "},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=%E5%90%8E%E5%A4%84%E7%90%86\u0026amp;zhida_source=entity","TextMarkTextContent":"后处理"},{"Type":"NodeText","Data":"的需要。"}]},{"ID":"20260206210813-vnte3cu","Type":"NodeParagraph","Properties":{"id":"20260206210813-vnte3cu","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"这不仅提高了推理速度，还简化了部署过程。YOLOv10 引入了一些关键功能，例如 NMS-Free 训练和整体设计方法，使其在所有指标上都表现出色。"}]},{"ID":"20260206210813-ntslvl8","Type":"NodeParagraph","Properties":{"id":"20260206210813-ntslvl8","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"style":"width: 1060px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/v2-6832eaba918ecb41b7615d66da3538d2_r-20260206210813-7kfip5c.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1060px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210813-5w8f2fx","Type":"NodeParagraph","Properties":{"id":"20260206210813-5w8f2fx","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLO、YOLOv10 性能基准 在延迟-准确度方面与其他产品的比较"}]},{"ID":"20260206210813-1l9isws","Type":"NodeList","ListData":{},"Properties":{"id":"20260206210813-1l9isws","updated":"20260206210813"},"Children":[{"ID":"20260206210813-lhpv6rj","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-lhpv6rj","updated":"20260206210813"},"Children":[{"ID":"20260206210813-xtbwk3g","Type":"NodeParagraph","Properties":{"id":"20260206210813-xtbwk3g","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"NMS–Free 检测：YOLOv10 基于一致的双重分配提供了一种新颖的 NMS-Free 训练策略。它采用双重标签分配（一对多和一对一）和一致的匹配度量，在训练期间提供丰富的监督，同时在推理期间消除 NMS。在推理过程中，仅使用一对一的 head，从而实现 NMS-Free 检测。"}]}]},{"ID":"20260206210813-kxz0b96","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-kxz0b96","updated":"20260206210813"},"Children":[{"ID":"20260206210813-hgp3vy1","Type":"NodeParagraph","Properties":{"id":"20260206210813-hgp3vy1","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"整体效率-准确度驱动设计：YOLOv10 采用整体方法进行模型设计，优化各个组件以提高效率和准确度。它引入了轻量级分类 head、空间通道解耦下采样和等级引导块设计，以降低计算成本。"}]}]}]},{"ID":"20260206210813-zjrojtf","Type":"NodeParagraph","Properties":{"id":"20260206210813-zjrojtf","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"style":"width: 1342px;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/v2-bc6514429987175482232ea4fdc0aabc_r-20260206210813-851z7x6.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"width: 1342px;\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210813-9dt2p3e","Type":"NodeParagraph","Properties":{"id":"20260206210813-9dt2p3e","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLOv10 架构"}]},{"ID":"20260206210813-4d33d02","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260206210813-4d33d02","updated":"20260206210813"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://zhida.zhihu.com/search?content_id=251721224\u0026amp;content_type=Article\u0026amp;match_order=1\u0026amp;q=YOLO11\u0026amp;zhida_source=entity","TextMarkTextContent":"YOLO11"},{"Type":"NodeText","Data":"：架构增强"}]},{"ID":"20260206210813-1ou6tln","Type":"NodeParagraph","Properties":{"id":"20260206210813-1ou6tln","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLO11于 2024 年 9 月发布。它经历了一系列架构改进，并专注于在不牺牲准确性的情况下提高计算效率。"}]},{"ID":"20260206210813-8nflori","Type":"NodeParagraph","Properties":{"id":"20260206210813-8nflori","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"它引入了 C3k2 块和 C2PSA 块等新组件，有助于改进特征提取和处理。这导致性能略有提高，但模型的参数却少得多。以下是 YOLO11 的主要功能。"}]},{"ID":"20260206210813-soxfrg5","Type":"NodeList","ListData":{},"Properties":{"id":"20260206210813-soxfrg5","updated":"20260206210813"},"Children":[{"ID":"20260206210813-0nudb1e","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-0nudb1e","updated":"20260206210813"},"Children":[{"ID":"20260206210813-2v234ne","Type":"NodeParagraph","Properties":{"id":"20260206210813-2v234ne","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"C3k2 块：YOLO11 引入了 C3k2 块，这是跨阶段部分 (CSP) 瓶颈的计算高效实现。它取代了 backbone 和 neck 中的 C2f 块，并使用两个较小的卷积代替一个大卷积，从而缩短了处理时间。"}]}]},{"ID":"20260206210813-3c8cn56","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-3c8cn56","updated":"20260206210813"},"Children":[{"ID":"20260206210813-iwjmzhm","Type":"NodeParagraph","Properties":{"id":"20260206210813-iwjmzhm","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"C2PSA 块：在空间金字塔池化 - 快速 (SPPF) 块之后引入跨阶段部分空间注意 (C2PSA) 块，以增强空间注意。这种注意机制使模型能够更有效地关注图像中的重要区域，从而有可能提高检测准确性。"}]}]}]},{"ID":"20260206210813-bnh7oyg","Type":"NodeParagraph","Properties":{"id":"20260206210813-bnh7oyg","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"至此，我们讨论了整个 YOLO 系列目标检测模型。但有一些东西告诉我，进化不会就此止步，创新将继续，我们将在未来看到更好的表现。"}]},{"ID":"20260206210813-wpjabwd","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260206210813-wpjabwd","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLO 模型的未来"}]},{"ID":"20260206210813-arf56be","Type":"NodeParagraph","Properties":{"id":"20260206210813-arf56be","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLO 系列一直在不断突破计算机视觉的界限。它从一个简单的架构发展成为一个复杂的系统。每个版本都引入了新功能并扩展了支持的任务范围。"}]},{"ID":"20260206210813-8r4dxbu","Type":"NodeParagraph","Properties":{"id":"20260206210813-8r4dxbu","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"展望未来，准确性、速度和多任务能力不断提高的趋势可能会持续下去。潜在的发展领域包括以下方面。"}]},{"ID":"20260206210813-vqom6ss","Type":"NodeList","ListData":{},"Properties":{"id":"20260206210813-vqom6ss","updated":"20260206210813"},"Children":[{"ID":"20260206210813-7r5owdc","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-7r5owdc","updated":"20260206210813"},"Children":[{"ID":"20260206210813-ibwvsuo","Type":"NodeParagraph","Properties":{"id":"20260206210813-ibwvsuo","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"提高可解释性：使模型的决策过程更加透明。"}]}]},{"ID":"20260206210813-nxup0cq","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-nxup0cq","updated":"20260206210813"},"Children":[{"ID":"20260206210813-34031bq","Type":"NodeParagraph","Properties":{"id":"20260206210813-34031bq","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"增强的稳健性：使模型更能适应具有挑战性的条件。"}]}]},{"ID":"20260206210813-hjog38d","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260206210813-hjog38d","updated":"20260206210813"},"Children":[{"ID":"20260206210813-sc63w00","Type":"NodeParagraph","Properties":{"id":"20260206210813-sc63w00","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"高效部署：针对各种硬件平台优化模型。"}]}]}]},{"ID":"20260206210813-cpun8mn","Type":"NodeParagraph","Properties":{"id":"20260206210813-cpun8mn","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLO 模型的进步对各个行业都有重大影响。YOLO 执行实时目标检测的能力有可能改变我们与视觉世界的互动方式。然而，解决道德问题和潜在偏见也很重要。确保公平、问责和透明对于负责任的创新至关重要。"}]},{"ID":"20260206210813-qdz0ze2","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260206210813-qdz0ze2","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"参考资料"}]},{"ID":"20260206210813-rxagoci","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20260206210813-rxagoci","updated":"20260206210813"},"Children":[{"ID":"20260206210813-38ue8hd","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20260206210813-38ue8hd","updated":"20260206210813"},"Children":[{"ID":"20260206210813-oic9kts","Type":"NodeParagraph","Properties":{"id":"20260206210813-oic9kts","updated":"20260206210813"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://link.zhihu.com/?target=https%3A//cloud.tencent.com/developer/article/2406045","TextMarkTextContent":"YOLO系列算法全家桶——YOLOv1-YOLOv9详细介绍 ！！-腾讯云开发者社区-腾讯云"}]}]}]},{"ID":"20260206210813-2hn1imd","Type":"NodeParagraph","Properties":{"id":"20260206210813-2hn1imd","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"YOLO算法"}]},{"ID":"20260206210813-t28lgv1","Type":"NodeParagraph","Properties":{"id":"20260206210813-t28lgv1","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"目标检测"}]},{"ID":"20260206210813-t2sqaxc","Type":"NodeParagraph","Properties":{"id":"20260206210813-t2sqaxc","updated":"20260206210813"},"Children":[{"Type":"NodeText","Data":"人工智能"}]}]}