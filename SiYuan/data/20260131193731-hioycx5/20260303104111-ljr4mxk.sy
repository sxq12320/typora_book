limiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20260304135743-xmglitr","updated":"20260304135955"},"Children":[{"ID":"20260304135743-1k93itz","Type":"NodeParagraph","Properties":{"id":"20260304135743-1k93itz","updated":"20260304135955"},"Children":[{"Type":"NodeText","Data":"在写的时候，官方无论是v1还是多少的版本均是使用自己的一种写法来写的"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":" - [-1, 1, Conv, [32, 3, 1]]"},{"Type":"NodeText","Data":"​，这个语法规则是："},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[from, number, module, args]"},{"Type":"NodeText","Data":"​"}]},{"ID":"20260304135953-n89bly0","Type":"NodeList","ListData":{},"Properties":{"id":"20260304135953-n89bly0","updated":"20260304135953"},"Children":[{"ID":"20260304135953-r84lyy1","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260304135953-r84lyy1","updated":"20260304135953"},"Children":[{"ID":"20260304135953-kxjbfhr","Type":"NodeParagraph","Properties":{"id":"20260304135953-kxjbfhr","updated":"20260304135953"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"from"},{"Type":"NodeText","Data":"​: 输入特征图的来源。"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"-1"},{"Type":"NodeText","Data":"​ 表示接收上一层的输出，如果是具体的数字（如 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[-1, 8]"},{"Type":"NodeText","Data":"​），则表示接收上一层和第 8 层的输出。"}]}]},{"ID":"20260304135953-n6t6zq7","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260304135953-n6t6zq7","updated":"20260304135953"},"Children":[{"ID":"20260304135953-beqe9p5","Type":"NodeParagraph","Properties":{"id":"20260304135953-beqe9p5","updated":"20260304135953"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"number"},{"Type":"NodeText","Data":"​: 该模块重复的次数。"}]}]},{"ID":"20260304135953-u58dcdu","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260304135953-u58dcdu","updated":"20260304135953"},"Children":[{"ID":"20260304135953-n2oiwsg","Type":"NodeParagraph","Properties":{"id":"20260304135953-n2oiwsg","updated":"20260304135953"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"module"},{"Type":"NodeText","Data":"​: 调用的网络模块名称（如 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Conv"},{"Type":"NodeText","Data":"​ 卷积层, "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Bottleneck"},{"Type":"NodeText","Data":"​ 残差块, "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"Concat"},{"Type":"NodeText","Data":"​ 拼接层等）。"}]}]},{"ID":"20260304135953-hew91cr","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260304135953-hew91cr","updated":"20260304135953"},"Children":[{"ID":"20260304135953-1smzr3y","Type":"NodeParagraph","Properties":{"id":"20260304135953-1smzr3y","updated":"20260304135953"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"args"},{"Type":"NodeText","Data":"​: 传递给该模块的具体参数，通常是 "},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"[输出通道数, 卷积核大小, 步长]"},{"Type":"NodeText","Data":"​。"}]}]}]}]}]},{"ID":"20260304135938-9jwdlgp","Type":"NodeParagraph","Properties":{"id":"20260304135938-9jwdlgp","updated":"20260304135938"}}]}