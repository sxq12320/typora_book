26quot;title\u0026quot;:\u0026quot;image.png\u0026quot;,\u0026quot;isLocal\u0026quot;:false,\u0026quot;blockId\u0026quot;:\u0026quot;\u0026quot;\u0026#125;\u0026#125;","id":"20260202093525-t8pxku0","title":"YoLoV1","type":"doc","updated":"20260203095252"},"Children":[{"ID":"20260202203242-0gm3mgg","Type":"NodeBlockquote","Properties":{"id":"20260202203242-0gm3mgg","updated":"20260203093743"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20260202203834-ogvwwcq","Type":"NodeParagraph","Properties":{"id":"20260202203834-ogvwwcq","updated":"20260202203845"},"Children":[{"Type":"NodeText","Data":"You Can Only Look Once"}]},{"ID":"20260203093541-ctcmmq4","Type":"NodeParagraph","Properties":{"id":"20260203093541-ctcmmq4","updated":"20260203093546"},"Children":[{"Type":"NodeText","Data":"之前的RCNN算法："}]},{"ID":"20260203093546-10kvbgy","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20260203093546-10kvbgy","updated":"20260203093550"},"Children":[{"ID":"20260203093550-5hssb1z","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20260203093550-5hssb1z","updated":"20260203093550"},"Children":[{"ID":"20260203093550-qe2xoej","Type":"NodeParagraph","Properties":{"id":"20260203093550-qe2xoej","updated":"20260203093607"},"Children":[{"Type":"NodeText","Data":"使用提案生成超级多的待检测框框"}]}]},{"ID":"20260203093607-27dvhl6","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260203093607-27dvhl6","updated":"20260203093607"},"Children":[{"ID":"20260203093607-23ahwi3","Type":"NodeParagraph","Properties":{"id":"20260203093607-23ahwi3","updated":"20260203093620"},"Children":[{"Type":"NodeText","Data":"使用分类器对这些框框进行物品类别的判定"}]}]},{"ID":"20260203093620-pvu31fx","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20260203093620-pvu31fx","updated":"20260203093620"},"Children":[{"ID":"20260203093620-v19rzi6","Type":"NodeParagraph","Properties":{"id":"20260203093620-v19rzi6","updated":"20260203093631"},"Children":[{"Type":"NodeText","Data":"使用回归器对框框的位置进行调整"}]}]}]},{"ID":"20260203093631-q48ncdb","Type":"NodeParagraph","Properties":{"id":"20260203093631-q48ncdb","updated":"20260203093743"},"Children":[{"Type":"NodeText","Data":"现在YoLo算法：将目标检测问题变成了一个回归问题，通过一个神经网络就实现了直接输出整个框框以及框框内包含的物品类别。是一种端到端的算法。"}]}]},{"ID":"20260203094252-g8jb9de","Type":"NodeThematicBreak","Properties":{"id":"20260203094252-g8jb9de","updated":"20260203094252"}},{"ID":"20260202203608-mqdgfgi","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20260202203608-mqdgfgi","updated":"20260203095252"},"Children":[{"Type":"NodeText","Data":"1 创作背景"}]},{"ID":"20260203094255-8vtlk4u","Type":"NodeParagraph","Properties":{"id":"20260203094255-8vtlk4u","updated":"20260203094336"},"Children":[{"Type":"NodeText","Data":"这里主要聚焦于目标检测相关的领域，因此对图像分类的相关背景不多做阐述。"}]},{"ID":"20260203094336-3h3b6e6","Type":"NodeParagraph","Properties":{"id":"20260203094336-3h3b6e6","updated":"20260203094432"},"Children":[{"Type":"NodeText","Data":"当时目标检测主要有两种主流的方式：一种是采用以RCNN为基本的神经网络架构，而另一种是采用传统的"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"SIFT"},{"Type":"NodeText","Data":"等当时进行的滑动窗口模式。"}]},{"ID":"20260203094428-eze0aqu","Type":"NodeParagraph","Properties":{"id":"20260203094428-eze0aqu","updated":"20260203094545"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"传统滑动窗口模式"},{"Type":"NodeText","Data":"的算法就不再多进行赘述了，这个算法的缺陷已经在"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260203094519-qxx8y9q","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"R-CNN"},{"Type":"NodeText","Data":"一文种阐述的非常清晰。"}]},{"ID":"20260203094537-x9dbkeq","Type":"NodeParagraph","Properties":{"id":"20260203094537-x9dbkeq","updated":"20260203094754"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"现在主流的算法"},{"Type":"NodeText","Data":"就是"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260203094519-qxx8y9q","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"R-CNN"},{"Type":"NodeText","Data":"，以及"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260203094519-qxx8y9q","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"R-CNN"},{"Type":"NodeText","Data":"的增强版本"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260203094626-3i6imtu","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"Fast R-CNN"},{"Type":"NodeText","Data":"，不过当年其实也已经提出了更加厉害的算法也就是R-CNN的集大成之作"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260203094726-7rhefqi","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"Faster R-CNN"},{"Type":"NodeText","Data":"。那么现在就说一说这几个算法共同的一些问题。"}]},{"ID":"20260203094750-st5cao9","Type":"NodeCallout","Properties":{"id":"20260203094750-st5cao9","updated":"20260203095252"},"CalloutType":"NOTE","CalloutTitle":"Note","CalloutIcon":"✏️","Children":[{"ID":"20260203094817-sfrx02h","Type":"NodeParagraph","Properties":{"id":"20260203094817-sfrx02h","updated":"20260203095011"},"Children":[{"Type":"NodeText","Data":"这几个算法都不是端到端的学习算法，同时都是使用重用分类器来执行检测，他们全都是两步走的思路，甚至有几个还三步走的，效率太慢了。"}]},{"ID":"20260203094927-94f1pvz","Type":"NodeParagraph","Properties":{"id":"20260203094927-94f1pvz","updated":"20260203095252"},"Children":[{"Type":"NodeText","Data":"这些方法"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"首先"},{"Type":"NodeText","Data":"需要在图像中生成有可能的边界框框也就是所谓的"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Region Proposal"},{"Type":"NodeText","Data":"(候选区域)；"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"然后"},{"Type":"NodeText","Data":"在这些框框之上使用分类器进行分类，确定好他们的所属物品类别，是前景还是背景，是猫还是狗；"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"最后"},{"Type":"NodeText","Data":"还需要使用一个处理的方法，对这些边框进行打分，并且将边框进行不断的修正达到比较好的效果。"}]}]},{"ID":"20260203094844-geae774","Type":"NodeParagraph","Properties":{"id":"20260203094844-geae774","updated":"20260203094844"}}]}