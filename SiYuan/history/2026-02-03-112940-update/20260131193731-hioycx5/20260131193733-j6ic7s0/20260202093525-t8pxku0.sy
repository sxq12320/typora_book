26quot;title\u0026quot;:\u0026quot;image.png\u0026quot;,\u0026quot;isLocal\u0026quot;:false,\u0026quot;blockId\u0026quot;:\u0026quot;\u0026quot;\u0026#125;,\u0026quot;d93925624d5153fe32bf4ae28412b4e4\u0026quot;:\u0026#123;\u0026quot;name\u0026quot;:\u0026quot;image-20260203103453-g8v9zcs.png\u0026quot;,\u0026quot;hash\u0026quot;:\u0026quot;d93925624d5153fe32bf4ae28412b4e4\u0026quot;,\u0026quot;originUrl\u0026quot;:\u0026quot;assets/image-20260203103453-g8v9zcs.png\u0026quot;,\u0026quot;url\u0026quot;:\u0026quot;https://raw.githubusercontent.com/sxq12320/typora_book/main//img_20260203103519052.png\u0026quot;,\u0026quot;alt\u0026quot;:\u0026quot;image.png\u0026quot;,\u0026quot;title\u0026quot;:\u0026quot;image.png\u0026quot;,\u0026quot;isLocal\u0026quot;:false,\u0026quot;blockId\u0026quot;:\u0026quot;\u0026quot;\u0026#125;,\u0026quot;30be8208dacab5508e572b8d87932f3a\u0026quot;:\u0026#123;\u0026quot;name\u0026quot;:\u0026quot;image-20260203110935-yx5qka7.png\u0026quot;,\u0026quot;hash\u0026quot;:\u0026quot;30be8208dacab5508e572b8d87932f3a\u0026quot;,\u0026quot;originUrl\u0026quot;:\u0026quot;assets/image-20260203110935-yx5qka7.png\u0026quot;,\u0026quot;url\u0026quot;:\u0026quot;https://raw.githubusercontent.com/sxq12320/typora_book/main//img_20260203110936419.png\u0026quot;,\u0026quot;alt\u0026quot;:\u0026quot;image.png\u0026quot;,\u0026quot;title\u0026quot;:\u0026quot;image.png\u0026quot;,\u0026quot;isLocal\u0026quot;:false,\u0026quot;blockId\u0026quot;:\u0026quot;\u0026quot;\u0026#125;\u0026#125;","id":"20260202093525-t8pxku0","title":"YoLoV1","type":"doc","updated":"20260203112923"},"Children":[{"ID":"20260202203242-0gm3mgg","Type":"NodeBlockquote","Properties":{"id":"20260202203242-0gm3mgg","updated":"20260203093743"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e"},{"ID":"20260202203834-ogvwwcq","Type":"NodeParagraph","Properties":{"id":"20260202203834-ogvwwcq","updated":"20260202203845"},"Children":[{"Type":"NodeText","Data":"You Can Only Look Once"}]},{"ID":"20260203093541-ctcmmq4","Type":"NodeParagraph","Properties":{"id":"20260203093541-ctcmmq4","updated":"20260203093546"},"Children":[{"Type":"NodeText","Data":"之前的RCNN算法："}]},{"ID":"20260203093546-10kvbgy","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20260203093546-10kvbgy","updated":"20260203093550"},"Children":[{"ID":"20260203093550-5hssb1z","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20260203093550-5hssb1z","updated":"20260203093550"},"Children":[{"ID":"20260203093550-qe2xoej","Type":"NodeParagraph","Properties":{"id":"20260203093550-qe2xoej","updated":"20260203093607"},"Children":[{"Type":"NodeText","Data":"使用提案生成超级多的待检测框框"}]}]},{"ID":"20260203093607-27dvhl6","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260203093607-27dvhl6","updated":"20260203093607"},"Children":[{"ID":"20260203093607-23ahwi3","Type":"NodeParagraph","Properties":{"id":"20260203093607-23ahwi3","updated":"20260203093620"},"Children":[{"Type":"NodeText","Data":"使用分类器对这些框框进行物品类别的判定"}]}]},{"ID":"20260203093620-pvu31fx","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20260203093620-pvu31fx","updated":"20260203093620"},"Children":[{"ID":"20260203093620-v19rzi6","Type":"NodeParagraph","Properties":{"id":"20260203093620-v19rzi6","updated":"20260203093631"},"Children":[{"Type":"NodeText","Data":"使用回归器对框框的位置进行调整"}]}]}]},{"ID":"20260203093631-q48ncdb","Type":"NodeParagraph","Properties":{"id":"20260203093631-q48ncdb","updated":"20260203093743"},"Children":[{"Type":"NodeText","Data":"现在YoLo算法：将目标检测问题变成了一个回归问题，通过一个神经网络就实现了直接输出整个框框以及框框内包含的物品类别。是一种端到端的算法。"}]}]},{"ID":"20260203094252-g8jb9de","Type":"NodeThematicBreak","Properties":{"id":"20260203094252-g8jb9de","updated":"20260203094252"}},{"ID":"20260202203608-mqdgfgi","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20260202203608-mqdgfgi","updated":"20260203094247"},"Children":[{"Type":"NodeText","Data":"1 创作背景"}]},{"ID":"20260203094255-8vtlk4u","Type":"NodeParagraph","Properties":{"id":"20260203094255-8vtlk4u","updated":"20260203094336"},"Children":[{"Type":"NodeText","Data":"这里主要聚焦于目标检测相关的领域，因此对图像分类的相关背景不多做阐述。"}]},{"ID":"20260203094336-3h3b6e6","Type":"NodeParagraph","Properties":{"id":"20260203094336-3h3b6e6","updated":"20260203094432"},"Children":[{"Type":"NodeText","Data":"当时目标检测主要有两种主流的方式：一种是采用以RCNN为基本的神经网络架构，而另一种是采用传统的"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"SIFT"},{"Type":"NodeText","Data":"等当时进行的滑动窗口模式。"}]},{"ID":"20260203094428-eze0aqu","Type":"NodeParagraph","Properties":{"id":"20260203094428-eze0aqu","updated":"20260203094545"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"传统滑动窗口模式"},{"Type":"NodeText","Data":"的算法就不再多进行赘述了，这个算法的缺陷已经在"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260203094519-qxx8y9q","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"R-CNN"},{"Type":"NodeText","Data":"一文种阐述的非常清晰。"}]},{"ID":"20260203094537-x9dbkeq","Type":"NodeParagraph","Properties":{"id":"20260203094537-x9dbkeq","updated":"20260203094754"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"现在主流的算法"},{"Type":"NodeText","Data":"就是"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260203094519-qxx8y9q","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"R-CNN"},{"Type":"NodeText","Data":"，以及"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260203094519-qxx8y9q","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"R-CNN"},{"Type":"NodeText","Data":"的增强版本"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260203094626-3i6imtu","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"Fast R-CNN"},{"Type":"NodeText","Data":"，不过当年其实也已经提出了更加厉害的算法也就是R-CNN的集大成之作"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260203094726-7rhefqi","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"Faster R-CNN"},{"Type":"NodeText","Data":"。那么现在就说一说这几个算法共同的一些问题。"}]},{"ID":"20260203094750-st5cao9","Type":"NodeCallout","Properties":{"id":"20260203094750-st5cao9","updated":"20260203095252"},"CalloutType":"NOTE","CalloutTitle":"Note","CalloutIcon":"✏️","Children":[{"ID":"20260203094817-sfrx02h","Type":"NodeParagraph","Properties":{"id":"20260203094817-sfrx02h","updated":"20260203095011"},"Children":[{"Type":"NodeText","Data":"这几个算法都不是端到端的学习算法，同时都是使用重用分类器来执行检测，他们全都是两步走的思路，甚至有几个还三步走的，效率太慢了。"}]},{"ID":"20260203094927-94f1pvz","Type":"NodeParagraph","Properties":{"id":"20260203094927-94f1pvz","updated":"20260203095252"},"Children":[{"Type":"NodeText","Data":"这些方法"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"首先"},{"Type":"NodeText","Data":"需要在图像中生成有可能的边界框框也就是所谓的"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Region Proposal"},{"Type":"NodeText","Data":"(候选区域)；"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"然后"},{"Type":"NodeText","Data":"在这些框框之上使用分类器进行分类，确定好他们的所属物品类别，是前景还是背景，是猫还是狗；"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"最后"},{"Type":"NodeText","Data":"还需要使用一个处理的方法，对这些边框进行打分，并且将边框进行不断的修正达到比较好的效果。"}]}]},{"ID":"20260203094844-geae774","Type":"NodeParagraph","Properties":{"id":"20260203094844-geae774","updated":"20260203103253"},"Children":[{"Type":"NodeText","Data":"因此基于这上面的一些问题，作者就提出了YoLo算法。将目标检测作为单个回归问题，直接算出边框以及框内物品的类别，一次即可出答案。这就是"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"you only look once"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260203103255-4io3929","Type":"NodeParagraph","Properties":{"id":"20260203103255-4io3929","updated":"20260203103523"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"https://raw.githubusercontent.com/sxq12320/typora_book/main//img_20260203103519052.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260203103249-z8d2syt","Type":"NodeThematicBreak","Properties":{"id":"20260203103249-z8d2syt","updated":"20260203103249"}},{"ID":"20260203103804-5fwtr8f","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20260203103804-5fwtr8f","updated":"20260203112923"},"Children":[{"Type":"NodeText","Data":"2 网络架构设计"}]},{"ID":"20260203111555-s8dbki5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260203111555-s8dbki5","updated":"20260203112923"},"Children":[{"Type":"NodeText","Data":"2.1 网络训练环节"}]},{"ID":"20260203110945-lcdeiws","Type":"NodeParagraph","Properties":{"id":"20260203110945-lcdeiws","updated":"20260203111013"},"Children":[{"Type":"NodeText","Data":"下面这个图片就代表了YOLO-V1的整体思想，也可以说是最终的原理。"}]},{"ID":"20260203111002-bzjedce","Type":"NodeParagraph","Properties":{"id":"20260203111002-bzjedce","updated":"20260203111002"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"https://raw.githubusercontent.com/sxq12320/typora_book/main//img_20260203110936419.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260203111016-j7jejcx","Type":"NodeParagraph","Properties":{"id":"20260203111016-j7jejcx","updated":"20260203111025"},"Children":[{"Type":"NodeText","Data":"那么就简单对这个图片叙述一下："}]},{"ID":"20260203111028-vyithyv","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20260203111028-vyithyv","updated":"20260203111545"},"Children":[{"ID":"20260203111028-rksl6zm","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20260203111028-rksl6zm","updated":"20260203111545"},"Children":[{"ID":"20260203111028-6x2c59i","Type":"NodeParagraph","Properties":{"id":"20260203111028-6x2c59i","updated":"20260203111516"},"Children":[{"Type":"NodeText","Data":"首先我们输入一张任意的图片,现在第一步就是将整个输入的图片切分成"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"S\\times S_esc_newline_"},{"Type":"NodeText","Data":"大小的网格，每个网络我们称之为"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Cell"},{"Type":"NodeText","Data":"。有了这些"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Cell"},{"Type":"NodeText","Data":"之后进行判定，如果某个"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"物体的中心"},{"Type":"NodeText","Data":"落到了某个网格之中，那么该网格也就是该"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Cell"},{"Type":"NodeText","Data":"就负责对该物体进行检测。"}]},{"ID":"20260203111412-tbspekw","Type":"NodeCallout","Properties":{"id":"20260203111412-tbspekw","updated":"20260203111545"},"CalloutType":"TIP","CalloutTitle":"Tip","CalloutIcon":"💡","Children":[{"ID":"20260203111439-urem21a","Type":"NodeParagraph","Properties":{"id":"20260203111439-urem21a","updated":"20260203111545"},"Children":[{"Type":"NodeText","Data":"注意一下，这里的物体中心并非是计算而来的，是人工标注出来的真实值决定的。咱们到现在位置说的全是网络训练环节算法。"}]}]}]}]},{"ID":"20260203111427-d4mc6o1","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20260203111427-d4mc6o1","updated":"20260203112923"},"Children":[{"ID":"20260203111609-du4pin2","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260203111609-du4pin2","updated":"20260203111609"},"Children":[{"ID":"20260203111609-3f8t51s","Type":"NodeParagraph","Properties":{"id":"20260203111609-3f8t51s","updated":"20260203111731"},"Children":[{"Type":"NodeText","Data":"第二部就是需要计算一些数据，也就是最重要的检测部分了，他分成两个步骤来计算出一组向量，这组向量包含两种类型的信息："}]},{"ID":"20260203111643-o9032fr","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20260203111643-o9032fr","updated":"20260203111643"},"Children":[{"ID":"20260203111642-g1ezqzc","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20260203111642-g1ezqzc","updated":"20260203111642"},"Children":[{"ID":"20260203111642-j2qenu5","Type":"NodeParagraph","Properties":{"id":"20260203111642-j2qenu5","updated":"20260203112202"},"Children":[{"Type":"NodeText","Data":"确定框的位置和大小信息，以及框的准确度信息。这里的每个网格都需要预测B个候选框，同时对每个框框都需要求出5个数据分别是："},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"x,y,w,h,confidence"},{"Type":"NodeText","Data":"，这几个数据分别对应了框的中心位置、框的宽度和高度、框的置信度。\n"}]},{"ID":"20260203112205-y6ynhf1","Type":"NodeCallout","Properties":{"id":"20260203112205-y6ynhf1","updated":"20260203112205"},"CalloutType":"TIP","CalloutTitle":"Tip","CalloutIcon":"💡","Children":[{"ID":"20260203112205-s9xuhej","Type":"NodeParagraph","Properties":{"id":"20260203112205-s9xuhej","updated":"20260203112330"},"Children":[{"Type":"NodeText","Data":"框的置信度，代表了两层含义，分别是这个格子里面"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"有没有物体"},{"Type":"NodeText","Data":"，如果有物体那么就是1，若没有那么就是0；其次预测框和真实的框之间的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"重合度"},{"Type":"NodeText","Data":"IOU有多大。"}]},{"ID":"20260203112431-tfxmn0e","Type":"NodeParagraph","Properties":{"id":"20260203112431-tfxmn0e","updated":"20260203112448"},"Children":[{"Type":"NodeText","Data":"这里的框并非是"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Cell而是Proposals"}]}]}]},{"ID":"20260203112334-g4zlxrt","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260203112334-g4zlxrt","updated":"20260203112334"},"Children":[{"ID":"20260203112334-4pv4d9r","Type":"NodeParagraph","Properties":{"id":"20260203112334-4pv4d9r","updated":"20260203112558"},"Children":[{"Type":"NodeText","Data":"判定类别的概率。每个格子"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Cell"},{"Type":"NodeText","Data":"，都需要对应一种条件概率，用来判定如果这个格子里面有物品，那么物品是某个类别的概率究竟是多少。"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"P(Class_i|Object)"},{"Type":"NodeText","Data":"\n"}]}]}]}]},{"ID":"20260203112604-eft09jj","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20260203112604-eft09jj","updated":"20260203112604"},"Children":[{"ID":"20260203112604-nwyswlw","Type":"NodeParagraph","Properties":{"id":"20260203112604-nwyswlw","updated":"20260203112813"},"Children":[{"Type":"NodeText","Data":"那么最后就是将这两个分数相乘即可我们将之前的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"条件概率"},{"Type":"NodeText","Data":"、每个格子都有框框都有一个"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"置信度"},{"Type":"NodeText","Data":"，将条件概率和单个框的置信度相乘，这样的分数，不仅仅包含了是否存在物品的可能性也包含了位置和类别的准确度信息。"}]}]},{"ID":"20260203112816-snmoom2","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20260203112816-snmoom2","updated":"20260203112923"},"Children":[{"ID":"20260203112816-e9fipbn","Type":"NodeParagraph","Properties":{"id":"20260203112816-e9fipbn","updated":"20260203112923"},"Children":[{"Type":"NodeText","Data":"最后使用非极大值抑制的方法，把重叠的、得分低的框去掉，得到得分最高的那个，就是图片中最后的预测结果啦。"}]}]}]},{"ID":"20260203111836-os0zs9n","Type":"NodeParagraph","Properties":{"id":"20260203111836-os0zs9n","updated":"20260203111836"}}]}