203093607"},"Children":[{"Type":"NodeText","Data":"使用提案生成超级多的待检测框框"}]}]},{"ID":"20260203093607-27dvhl6","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260203093607-27dvhl6","updated":"20260203093607"},"Children":[{"ID":"20260203093607-23ahwi3","Type":"NodeParagraph","Properties":{"id":"20260203093607-23ahwi3","updated":"20260203093620"},"Children":[{"Type":"NodeText","Data":"使用分类器对这些框框进行物品类别的判定"}]}]},{"ID":"20260203093620-pvu31fx","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20260203093620-pvu31fx","updated":"20260203093620"},"Children":[{"ID":"20260203093620-v19rzi6","Type":"NodeParagraph","Properties":{"id":"20260203093620-v19rzi6","updated":"20260203093631"},"Children":[{"Type":"NodeText","Data":"使用回归器对框框的位置进行调整"}]}]}]},{"ID":"20260203093631-q48ncdb","Type":"NodeParagraph","Properties":{"id":"20260203093631-q48ncdb","updated":"20260203093743"},"Children":[{"Type":"NodeText","Data":"现在YoLo算法：将目标检测问题变成了一个回归问题，通过一个神经网络就实现了直接输出整个框框以及框框内包含的物品类别。是一种端到端的算法。"}]}]},{"ID":"20260203094252-g8jb9de","Type":"NodeThematicBreak","Properties":{"id":"20260203094252-g8jb9de","updated":"20260203094252"}},{"ID":"20260202203608-mqdgfgi","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20260202203608-mqdgfgi","updated":"20260203095252"},"Children":[{"Type":"NodeText","Data":"1 创作背景"}]},{"ID":"20260203094255-8vtlk4u","Type":"NodeParagraph","Properties":{"id":"20260203094255-8vtlk4u","updated":"20260203094336"},"Children":[{"Type":"NodeText","Data":"这里主要聚焦于目标检测相关的领域，因此对图像分类的相关背景不多做阐述。"}]},{"ID":"20260203094336-3h3b6e6","Type":"NodeParagraph","Properties":{"id":"20260203094336-3h3b6e6","updated":"20260203094432"},"Children":[{"Type":"NodeText","Data":"当时目标检测主要有两种主流的方式：一种是采用以RCNN为基本的神经网络架构，而另一种是采用传统的"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"SIFT"},{"Type":"NodeText","Data":"等当时进行的滑动窗口模式。"}]},{"ID":"20260203094428-eze0aqu","Type":"NodeParagraph","Properties":{"id":"20260203094428-eze0aqu","updated":"20260203094545"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"传统滑动窗口模式"},{"Type":"NodeText","Data":"的算法就不再多进行赘述了，这个算法的缺陷已经在"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260203094519-qxx8y9q","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"R-CNN"},{"Type":"NodeText","Data":"一文种阐述的非常清晰。"}]},{"ID":"20260203094537-x9dbkeq","Type":"NodeParagraph","Properties":{"id":"20260203094537-x9dbkeq","updated":"20260203094754"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"现在主流的算法"},{"Type":"NodeText","Data":"就是"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260203094519-qxx8y9q","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"R-CNN"},{"Type":"NodeText","Data":"，以及"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260203094519-qxx8y9q","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"R-CNN"},{"Type":"NodeText","Data":"的增强版本"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260203094626-3i6imtu","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"Fast R-CNN"},{"Type":"NodeText","Data":"，不过当年其实也已经提出了更加厉害的算法也就是R-CNN的集大成之作"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260203094726-7rhefqi","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"Faster R-CNN"},{"Type":"NodeText","Data":"。那么现在就说一说这几个算法共同的一些问题。"}]},{"ID":"20260203094750-st5cao9","Type":"NodeCallout","Properties":{"id":"20260203094750-st5cao9","updated":"20260203095252"},"CalloutType":"TIP","CalloutTitle":"Tip","CalloutIcon":"💡","Children":[{"ID":"20260203094817-sfrx02h","Type":"NodeParagraph","Properties":{"id":"20260203094817-sfrx02h","updated":"20260203095011"},"Children":[{"Type":"NodeText","Data":"这几个算法都不是端到端的学习算法，同时都是使用重用分类器来执行检测，他们全都是两步走的思路，甚至有几个还三步走的，效率太慢了。"}]},{"ID":"20260203094927-94f1pvz","Type":"NodeParagraph","Properties":{"id":"20260203094927-94f1pvz","updated":"20260203095252"},"Children":[{"Type":"NodeText","Data":"这些方法"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"首先"},{"Type":"NodeText","Data":"需要在图像中生成有可能的边界框框也就是所谓的"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Region Proposal"},{"Type":"NodeText","Data":"(候选区域)；"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"然后"},{"Type":"NodeText","Data":"在这些框框之上使用分类器进行分类，确定好他们的所属物品类别，是前景还是背景，是猫还是狗；"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"最后"},{"Type":"NodeText","Data":"还需要使用一个处理的方法，对这些边框进行打分，并且将边框进行不断的修正达到比较好的效果。"}]}]},{"ID":"20260203094844-geae774","Type":"NodeParagraph","Properties":{"id":"20260203094844-geae774","updated":"20260203103253"},"Children":[{"Type":"NodeText","Data":"因此基于这上面的一些问题，作者就提出了YoLo算法。将目标检测作为单个回归问题，直接算出边框以及框内物品的类别，一次即可出答案。这就是"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"you only look once"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260203103255-4io3929","Type":"NodeParagraph","Properties":{"id":"20260203103255-4io3929","updated":"20260203193557"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"https://raw.githubusercontent.com/sxq12320/typora_book/main//img_20260203103519052.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260203103249-z8d2syt","Type":"NodeThematicBreak","Properties":{"id":"20260203103249-z8d2syt","updated":"20260203103249"}},{"ID":"20260203103804-5fwtr8f","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20260203103804-5fwtr8f","updated":"20260203193554"},"Children":[{"Type":"NodeText","Data":"2 网络架构设计"}]},{"ID":"20260203111555-s8dbki5","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260203111555-s8dbki5","updated":"20260203193554"},"Children":[{"Type":"NodeText","Data":"2.1 目标检测思路"}]},{"ID":"20260203110945-lcdeiws","Type":"NodeParagraph","Properties":{"id":"20260203110945-lcdeiws","updated":"20260203111013"},"Children":[{"Type":"NodeText","Data":"下面这个图片就代表了YOLO-V1的整体思想，也可以说是最终的原理。"}]},{"ID":"20260203111002-bzjedce","Type":"NodeParagraph","Properties":{"id":"20260203111002-bzjedce","updated":"20260203193554"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"min-width: calc(100% - 0.1em);","style":"height: 50vh;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"https://raw.githubusercontent.com/sxq12320/typora_book/main//img_20260203110936419.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"height: 50vh;\" parent-style=\"min-width: calc(100% - 0.1em);\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20260203111016-j7jejcx","Type":"NodeParagraph","Properties":{"id":"20260203111016-j7jejcx","updated":"20260203111025"},"Children":[{"Type":"NodeText","Data":"那么就简单对这个图片叙述一下："}]},{"ID":"20260203111028-vyithyv","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20260203111028-vyithyv","updated":"20260203111545"},"Children":[{"ID":"20260203111028-rksl6zm","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20260203111028-rksl6zm","updated":"20260203111545"},"Children":[{"ID":"20260203111028-6x2c59i","Type":"NodeParagraph","Properties":{"id":"20260203111028-6x2c59i","updated":"20260203111516"},"Children":[{"Type":"NodeText","Data":"首先我们输入一张任意的图片,现在第一步就是将整个输入的图片切分成"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"S\\times S_esc_newline_"},{"Type":"NodeText","Data":"大小的网格，每个网络我们称之为"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Cell"},{"Type":"NodeText","Data":"。有了这些"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Cell"},{"Type":"NodeText","Data":"之后进行判定，如果某个"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"物体的中心"},{"Type":"NodeText","Data":"落到了某个网格之中，那么该网格也就是该"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Cell"},{"Type":"NodeText","Data":"就负责对该物体进行检测。"}]},{"ID":"20260203111412-tbspekw","Type":"NodeCallout","Properties":{"id":"20260203111412-tbspekw","updated":"20260203111545"},"CalloutType":"TIP","CalloutTitle":"Tip","CalloutIcon":"💡","Children":[{"ID":"20260203111439-urem21a","Type":"NodeParagraph","Properties":{"id":"20260203111439-urem21a","updated":"20260203111545"},"Children":[{"Type":"NodeText","Data":"注意一下，这里的物体中心并非是计算而来的，是人工标注出来的真实值决定的。咱们到现在位置说的全是网络训练环节算法。"}]}]}]}]},{"ID":"20260203111427-d4mc6o1","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20260203111427-d4mc6o1","updated":"20260203112923"},"Children":[{"ID":"20260203111609-du4pin2","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260203111609-du4pin2","updated":"20260203111609"},"Children":[{"ID":"20260203111609-3f8t51s","Type":"NodeParagraph","Properties":{"id":"20260203111609-3f8t51s","updated":"20260203111731"},"Children":[{"Type":"NodeText","Data":"第二部就是需要计算一些数据，也就是最重要的检测部分了，他分成两个步骤来计算出一组向量，这组向量包含两种类型的信息："}]},{"ID":"20260203111643-o9032fr","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20260203111643-o9032fr","updated":"20260203111643"},"Children":[{"ID":"20260203111642-g1ezqzc","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20260203111642-g1ezqzc","updated":"20260203111642"},"Children":[{"ID":"20260203111642-j2qenu5","Type":"NodeParagraph","Properties":{"id":"20260203111642-j2qenu5","updated":"20260203112202"},"Children":[{"Type":"NodeText","Data":"确定框的位置和大小信息，以及框的准确度信息。这里的每个网格都需要预测B个候选框，同时对每个框框都需要求出5个数据分别是："},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"x,y,w,h,confidence"},{"Type":"NodeText","Data":"，这几个数据分别对应了框的中心位置、框的宽度和高度、框的置信度。\n"}]},{"ID":"20260203112205-y6ynhf1","Type":"NodeCallout","Properties":{"id":"20260203112205-y6ynhf1","updated":"20260203112205"},"CalloutType":"TIP","CalloutTitle":"Tip","CalloutIcon":"💡","Children":[{"ID":"20260203112205-s9xuhej","Type":"NodeParagraph","Properties":{"id":"20260203112205-s9xuhej","updated":"20260203112330"},"Children":[{"Type":"NodeText","Data":"框的置信度，代表了两层含义，分别是这个格子里面"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"有没有物体"},{"Type":"NodeText","Data":"，如果有物体那么就是1，若没有那么就是0；其次预测框和真实的框之间的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"重合度"},{"Type":"NodeText","Data":"IOU有多大。"}]},{"ID":"20260203112431-tfxmn0e","Type":"NodeParagraph","Properties":{"id":"20260203112431-tfxmn0e","updated":"20260203112448"},"Children":[{"Type":"NodeText","Data":"这里的框并非是"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Cell而是Proposals"}]}]}]},{"ID":"20260203112334-g4zlxrt","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260203112334-g4zlxrt","updated":"20260203112334"},"Children":[{"ID":"20260203112334-4pv4d9r","Type":"NodeParagraph","Properties":{"id":"20260203112334-4pv4d9r","updated":"20260203112558"},"Children":[{"Type":"NodeText","Data":"判定类别的概率。每个格子"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Cell"},{"Type":"NodeText","Data":"，都需要对应一种条件概率，用来判定如果这个格子里面有物品，那么物品是某个类别的概率究竟是多少。"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"P(Class_i|Object)"},{"Type":"NodeText","Data":"\n"}]}]}]}]},{"ID":"20260203112604-eft09jj","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20260203112604-eft09jj","updated":"20260203112604"},"Children":[{"ID":"20260203112604-nwyswlw","Type":"NodeParagraph","Properties":{"id":"20260203112604-nwyswlw","updated":"20260203112813"},"Children":[{"Type":"NodeText","Data":"那么最后就是将这两个分数相乘即可我们将之前的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"条件概率"},{"Type":"NodeText","Data":"、每个格子都有框框都有一个"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"置信度"},{"Type":"NodeText","Data":"，将条件概率和单个框的置信度相乘，这样的分数，不仅仅包含了是否存在物品的可能性也包含了位置和类别的准确度信息。"}]}]},{"ID":"20260203112816-snmoom2","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"NC4=","Num":4},"Properties":{"id":"20260203112816-snmoom2","updated":"20260203112923"},"Children":[{"ID":"20260203112816-e9fipbn","Type":"NodeParagraph","Properties":{"id":"20260203112816-e9fipbn","updated":"20260203112923"},"Children":[{"Type":"NodeText","Data":"最后使用非极大值抑制的方法，把重叠的、得分低的框去掉，得到得分最高的那个，就是图片中最后的预测结果啦。"}]}]}]},{"ID":"20260203111836-os0zs9n","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260203111836-os0zs9n","updated":"20260203194548"},"Children":[{"Type":"NodeText","Data":"2.2 具体网络结构"}]},{"ID":"20260203163943-zp3l4gv","Type":"NodeParagraph","Properties":{"id":"20260203163943-zp3l4gv","updated":"20260203164001"},"Children":[{"Type":"NodeText","Data":"首先还是展示一下整个网络的基本架构，如下图所示。"}]},{"ID":"20260203145834-dw2gy1n","Type":"NodeParagraph","Properties":{"id":"20260203145834-dw2gy1n","updated":"20260203193651"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"min-width: calc(100% - 0.1em);","style":"height: 50vh;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"https://raw.githubusercontent.com/sxq12320/typora_book/main//img_20260203145835538.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"height: 50vh;\" parent-style=\"min-width: calc(100% - 0.1em);\"}"},{"Type":"NodeText","Data":"​"}]},{"ID":"20260203145836-o5e6zhm","Type":"NodeParagraph","Properties":{"id":"20260203145836-o5e6zhm","updated":"20260203190258"},"Children":[{"Type":"NodeText","Data":"整体的架构还是非常的基本的，主要就是用了一堆卷积神经网络，同时最后使用了两层全连接神经网络进行分类。具体的卷积如下表所示，这里的维度均是一个四维数组"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"Batch\\times Channel \\times width \\times height"}]},{"ID":"20260203185935-4aedc8a","Type":"NodeParagraph","Properties":{"id":"20260203185935-4aedc8a","updated":"20260203190546"},"Children":[{"Type":"NodeText","Data":"这里有几个非常重要的问题需要阐述一下："}]},{"ID":"20260203190546-49o3b8j","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20260203190546-49o3b8j","updated":"20260203193700"},"Children":[{"ID":"20260203190547-m0nshlu","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20260203190547-m0nshlu","updated":"20260203190547"},"Children":[{"ID":"20260203190547-gk6y406","Type":"NodeParagraph","Properties":{"id":"20260203190547-gk6y406","updated":"20260203190801"},"Children":[{"Type":"NodeText","Data":"本文说到，在训练过程中，首先使用ImageNet数据集进行预训练，其中预训练的网络架构也是如此，但是这里使用的图片输入是224×224，因此再输入之前需要使用平均池化层实现图片大小的统一"},{"Type":"NodeTextMark","TextMarkType":"code","TextMarkTextContent":"AveragePool"},{"Type":"NodeText","Data":"​"}]}]},{"ID":"20260203190804-ejpn1l7","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260203190804-ejpn1l7","updated":"20260203193700"},"Children":[{"ID":"20260203190804-p537zke","Type":"NodeParagraph","Properties":{"id":"20260203190804-p537zke","updated":"20260203193700"},"Children":[{"Type":"NodeText","Data":"前向传播之后的结果是一个"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"7\\times7\\times30"},{"Type":"NodeText","Data":"的矩阵，这个矩阵表示的意思如下：\n这里的7很显然就是最基本的S，也就是网格划分的数量"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"cell"},{"Type":"NodeText","Data":"，然后每个cell里面有B个"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"proposals"},{"Type":"NodeText","Data":"这里的B一般设置成2，因此一个"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"cell"},{"Type":"NodeText","Data":"包括两个"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"proposals"},{"Type":"NodeText","Data":"；同时一个"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"proposals"},{"Type":"NodeText","Data":"会产生5个数据，分别为（x，y，w，h，置信度）。此外标注的类别有20个因此会产生20个概率大小。\n总结一下：一张图片分割成7×7的"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"cell"},{"Type":"NodeText","Data":"，每个"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"cell"},{"Type":"NodeText","Data":"有2个"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"proposals"},{"Type":"NodeText","Data":"，每个"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"proposals"},{"Type":"NodeText","Data":"产生5个数据。同时每个cell都包括了一组20维的向量用来判定概率。\n那么一张图片的输出就是（7×7×（2×5+20）"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"="}]},{"Type":"NodeText","Data":"7×7×30），因此就产生了这么多的向量。\n​"},{"Type":"NodeImage","Data":"span","Properties":{"parent-style":"min-width: calc(100% - 0.1em);","style":"height: 50vh;"},"Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"https://raw.githubusercontent.com/sxq12320/typora_book/main//img_20260203191246497.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeKramdownSpanIAL","Data":"{: style=\"height: 50vh;\" parent-style=\"min-width: calc(100% - 0.1em);\"}"},{"Type":"NodeText","Data":"​"}]}]}]},{"ID":"20260203191332-8swdbix","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260203191332-8swdbix","updated":"20260203194548"},"Children":[{"Type":"NodeText","Data":"2.2.1 损失函数问题"}]},{"ID":"20260203191411-18riqp5","Type":"NodeParagraph","Properties":{"id":"20260203191411-18riqp5","updated":"20260203191530"},"Children":[{"Type":"NodeText","Data":"对于损失函数而言，YOLO网络的损失函数应该说是一个非常大的亮点。"}]},{"ID":"20260203192349-ti25opu","Type":"NodeParagraph","Properties":{"id":"20260203192349-ti25opu","updated":"20260203192406"},"Children":[{"Type":"NodeText","Data":"YOLOv1 将目标检测看作是一个"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"回归问题"},{"Type":"NodeText","Data":"，而不是像 R-CNN 那样的分类+微调问题。因此，它的整个损失函数就是把各种错误的平方和加在一起。"}]},{"ID":"20260203191531-wxic3bt","Type":"NodeParagraph","Properties":{"id":"20260203191531-wxic3bt","updated":"20260203191800"},"Children":[{"Type":"NodeText","Data":"之前的"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260203094519-qxx8y9q","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"R-CNN"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260203094626-3i6imtu","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"Fast R-CNN"},{"Type":"NodeText","Data":"、"},{"Type":"NodeTextMark","TextMarkType":"block-ref","TextMarkBlockRefID":"20260203094726-7rhefqi","TextMarkBlockRefSubtype":"d","TextMarkTextContent":"Faster R-CNN"},{"Type":"NodeText","Data":"他们几个的损失函数应该说是有异曲同工之妙，他们几个的损失函数都是由两个部分组成，分别是判断方框内物品类别正确与否的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"分类损失"},{"Type":"NodeText","Data":"以及判断方框准确性的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"回归损失"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260203191801-o7nume0","Type":"NodeMathBlock","Properties":{"id":"20260203191801-o7nume0","updated":"20260203191840"},"Children":[{"Type":"NodeMathBlockOpenMarker"},{"Type":"NodeMathBlockContent","Data":"Loss = Loss_{object}+Loss_{class}"},{"Type":"NodeMathBlockCloseMarker"}]},{"ID":"20260203191849-m4bpqsy","Type":"NodeParagraph","Properties":{"id":"20260203191849-m4bpqsy","updated":"20260203191938"},"Children":[{"Type":"NodeText","Data":"而YOLO这边的损失函数定义可以说是非常复杂的，他是由整整五个部分相加而成"}]},{"ID":"20260203191939-b7rucm2","Type":"NodeMathBlock","Properties":{"id":"20260203191939-b7rucm2","updated":"20260203192031"},"Children":[{"Type":"NodeMathBlockOpenMarker"},{"Type":"NodeMathBlockContent","Data":"Loss = 坐标损失_1+坐标损失_2+置信度损失_1+置信度损失_2+分类损失"},{"Type":"NodeMathBlockCloseMarker"}]},{"ID":"20260203192038-0pimp42","Type":"NodeParagraph","Properties":{"id":"20260203192038-0pimp42","updated":"20260203192154"},"Children":[{"Type":"NodeText","Data":"首先就是坐标损失函数这边的问题，YOLO共有两类坐标损失函数，一个是用来判定方框中心位置的准确性、另一个是用来判定方框大小的准确性的。"}]},{"ID":"20260203192717-uk7ri3w","Type":"NodeMathBlock","Properties":{"id":"20260203192717-uk7ri3w","updated":"20260203193049"},"Children":[{"Type":"NodeMathBlockOpenMarker"},{"Type":"NodeMathBlockContent","Data":"\\begin{equation}\n\\begin{aligned}\n\\text{Loss} = \\quad \u0026 \\lambda_{\\text{coord}} \\sum_{i=0}^{S^2} \\sum_{j=0}^{B} \\mathbb{1}_{ij}^{\\text{obj}} \\left[ (x_i - \\hat{x}_i)^2 + (y_i - \\hat{y}_i)^2 \\right] \\\\\n\u0026 + \\lambda_{\\text{coord}} \\sum_{i=0}^{S^2} \\sum_{j=0}^{B} \\mathbb{1}_{ij}^{\\text{obj}} \\left[ \\left( \\sqrt{w_i} - \\sqrt{\\hat{w}_i} \\right)^2 + \\left( \\sqrt{h_i} - \\sqrt{\\hat{h}_i} \\right)^2 \\right] \\\\\n\u0026 + \\sum_{i=0}^{S^2} \\sum_{j=0}^{B} \\mathbb{1}_{ij}^{\\text{obj}} (C_i - \\hat{C}_i)^2 \\\\\n\u0026 + \\lambda_{\\text{noobj}} \\sum_{i=0}^{S^2} \\sum_{j=0}^{B} \\mathbb{1}_{ij}^{\\text{noobj}} (C_i - \\hat{C}_i)^2 \\\\\n\u0026 + \\sum_{i=0}^{S^2} \\mathbb{1}_{i}^{\\text{obj}} \\sum_{c \\in \\text{classes}} (p_i(c) - \\hat{p}_i(c))^2\n\\end{aligned}\n\\end{equation}"},{"Type":"NodeMathBlockCloseMarker"}]},{"ID":"20260203193037-m0eptzc","Type":"NodeCallout","Properties":{"id":"20260203193037-m0eptzc","updated":"20260203193157"},"CalloutType":"TIP","CalloutTitle":"Tip","CalloutIcon":"💡","Children":[{"ID":"20260203193102-9luwq5s","Type":"NodeParagraph","Properties":{"id":"20260203193102-9luwq5s","updated":"20260203193128"},"Children":[{"Type":"NodeText","Data":"这个公式需要先了解一下他的符号含义："}]},{"ID":"20260203193134-tz3b2fy","Type":"NodeList","ListData":{},"Properties":{"id":"20260203193134-tz3b2fy","updated":"20260203193157"},"Children":[{"ID":"20260203193134-alevmxt","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260203193134-alevmxt","updated":"20260203193134"},"Children":[{"ID":"20260203193134-fjvvwrx","Type":"NodeParagraph","Properties":{"id":"20260203193134-fjvvwrx","updated":"20260203193134"},"Children":[{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"S^2"},{"Type":"NodeText","Data":"：网格数量（YOLO 将图片分为 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"S \\times S"},{"Type":"NodeText","Data":" 个网格，通常是 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"7 \\times 7"},{"Type":"NodeText","Data":"）。"}]}]},{"ID":"20260203193134-u4df7hy","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260203193134-u4df7hy","updated":"20260203193141"},"Children":[{"ID":"20260203193134-6p9de93","Type":"NodeParagraph","Properties":{"id":"20260203193134-6p9de93","updated":"20260203193141"},"Children":[{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"B"},{"Type":"NodeText","Data":"：每个网格预测的边界框数量（通常是 2 个）。"}]}]},{"ID":"20260203193134-bg5vn5s","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260203193134-bg5vn5s","updated":"20260203193157"},"Children":[{"ID":"20260203193134-zkvwzn7","Type":"NodeParagraph","Properties":{"id":"20260203193134-zkvwzn7","updated":"20260203193157"},"Children":[{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"\\mathbb{1}_{ij}^{\\text{obj}}"},{"Type":"NodeText","Data":"：如果第 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"i"},{"Type":"NodeText","Data":" 个网格中的第 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"j"},{"Type":"NodeText","Data":" 个预测框负责预测该物体（即与真实框 IOU 最大），则该值为 1，否则为 0。这意味着"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"只有负责的那个框才计算坐标和尺寸误差"},{"Type":"NodeText","Data":"。"}]}]},{"ID":"20260203193134-9ko2oj2","Type":"NodeListItem","ListData":{"BulletChar":42,"Marker":"Kg=="},"Properties":{"id":"20260203193134-9ko2oj2","updated":"20260203193134"},"Children":[{"ID":"20260203193134-1pjp8lh","Type":"NodeParagraph","Properties":{"id":"20260203193134-1pjp8lh","updated":"20260203193134"},"Children":[{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"\\lambda_{\\text{coord}}"},{"Type":"NodeText","Data":" 和 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"\\lambda_{\\text{noobj}}"},{"Type":"NodeText","Data":"：这是权重系数，用来平衡不同损失的重要性。"}]}]}]}]},{"ID":"20260203193223-qrtlw9e","Type":"NodeParagraph","Properties":{"id":"20260203193223-qrtlw9e","updated":"20260203193732"},"Children":[{"Type":"NodeText","Data":"那么就开始一个个的对公式进行说明：S"}]},{"ID":"20260203193244-xmsnkdx","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20260203193244-xmsnkdx","updated":"20260203194548"},"Children":[{"ID":"20260203193258-3klyhx8","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20260203193258-3klyhx8","updated":"20260203193726"},"Children":[{"ID":"20260203193258-kbnhoer","Type":"NodeParagraph","Properties":{"id":"20260203193258-kbnhoer","updated":"20260203193724"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"中心坐标损失函数"},{"Type":"NodeText","Data":"：用来判定方框中心的准确性。"}]},{"ID":"20260203193724-jn2ppsj","Type":"NodeMathBlock","Properties":{"id":"20260203193724-jn2ppsj","updated":"20260203193726"},"Children":[{"Type":"NodeMathBlockOpenMarker"},{"Type":"NodeMathBlockContent","Data":"\\lambda_{\\text{coord}} \\sum_{i=0}^{S^2} \\sum_{j=0}^{B} \\mathbb{1}_{ij}^{\\text{obj}} \\left[ (x_i - \\hat{x}_i)^2 + (y_i - \\hat{y}_i)^2 \\right]"},{"Type":"NodeMathBlockCloseMarker"}]},{"ID":"20260203193426-02gu5nc","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20260203193426-02gu5nc","updated":"20260203193513"},"Children":[{"ID":"20260203193426-bd9prhx","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20260203193426-bd9prhx","updated":"20260203193426"},"Children":[{"ID":"20260203193426-jvsmrt7","Type":"NodeParagraph","Properties":{"id":"20260203193426-jvsmrt7","updated":"20260203193447"},"Children":[{"Type":"NodeText","Data":"这部分计算的是预测框中心点 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"(x, y)"},{"Type":"NodeText","Data":" 与真实框中心点 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"(\\hat{x}, \\hat{y})"},{"Type":"NodeText","Data":" 之间的误差。"}]}]},{"ID":"20260203193453-dnogqim","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260203193453-dnogqim","updated":"20260203193453"},"Children":[{"ID":"20260203193453-s8gih50","Type":"NodeParagraph","Properties":{"id":"20260203193453-s8gih50","updated":"20260203193453"},"Children":[{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"x, y"},{"Type":"NodeText","Data":" 是相对于当前网格左上角的偏移量（归一化到 0-1 之间）。"}]}]},{"ID":"20260203193503-k3e1jl7","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20260203193503-k3e1jl7","updated":"20260203193513"},"Children":[{"ID":"20260203193503-uu3k2ks","Type":"NodeParagraph","Properties":{"id":"20260203193503-uu3k2ks","updated":"20260203193513"},"Children":[{"Type":"NodeText","Data":"通常 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"\\lambda_{\\text{coord}} = 5"},{"Type":"NodeText","Data":"。因为我们希望模型更重视"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"定位的准确性"},{"Type":"NodeText","Data":"。如果不加权重，分类误差和定位误差混在一起，模型可能还没学会框住物体，就开始瞎猜类别了。"}]}]}]}]},{"ID":"20260203194238-nr96n2b","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260203194238-nr96n2b","updated":"20260203194503"},"Children":[{"ID":"20260203194238-8ol88wq","Type":"NodeParagraph","Properties":{"id":"20260203194238-8ol88wq","updated":"20260203194308"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"宽带尺寸损失"},{"Type":"NodeText","Data":"：大小损失函数，用来判定方框大小的正确性"}]},{"ID":"20260203194308-03ylf9r","Type":"NodeMathBlock","Properties":{"id":"20260203194308-03ylf9r","updated":"20260203194315"},"Children":[{"Type":"NodeMathBlockOpenMarker"},{"Type":"NodeMathBlockContent","Data":"\\lambda_{\\text{coord}} \\sum_{i=0}^{S^2} \\sum_{j=0}^{B} \\mathbb{1}_{ij}^{\\text{obj}} \\left[ (\\sqrt{w_i} - \\sqrt{\\hat{w}_i})^2 + (\\sqrt{h_i} - \\sqrt{\\hat{h}_i})^2 \\right]"},{"Type":"NodeMathBlockCloseMarker"}]},{"ID":"20260203194325-e0q7lrc","Type":"NodeList","ListData":{"Typ":1},"Properties":{"id":"20260203194325-e0q7lrc","updated":"20260203194503"},"Children":[{"ID":"20260203194328-48hmlbh","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"MS4=","Num":1},"Properties":{"id":"20260203194328-48hmlbh","updated":"20260203194328"},"Children":[{"ID":"20260203194328-bmvdf0i","Type":"NodeParagraph","Properties":{"id":"20260203194328-bmvdf0i","updated":"20260203194346"},"Children":[{"Type":"NodeText","Data":"这部分计算的是预测框的宽 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"w"},{"Type":"NodeText","Data":" 和高 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"h"},{"Type":"NodeText","Data":" 与真实值的误差"}]}]},{"ID":"20260203194347-irl7xky","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260203194347-irl7xky","updated":"20260203194503"},"Children":[{"ID":"20260203194347-8255f5z","Type":"NodeParagraph","Properties":{"id":"20260203194347-8255f5z","updated":"20260203194503"},"Children":[{"Type":"NodeText","Data":"同样的像素误差，对于大物体和小物体的影响是不同的。假设预测偏差了 10 个像素：对于一个 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"1000 \\times 1000"},{"Type":"NodeText","Data":" 的大框，差 10 像素微不足道；对于一个 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"20 \\times 20"},{"Type":"NodeText","Data":" 的小框，差 10 像素就是巨大的错误。因此需要加上根号来降低数值的同时使其斜率随数值增大而减小。这意味着"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"小框的偏差会比大框的偏差产生更大的惩罚"},{"Type":"NodeText","Data":"，从而提高小物体检测的精度。"}]}]}]}]},{"ID":"20260203194530-bff94sj","Type":"NodeListItem","ListData":{"Typ":1,"Delimiter":46,"Marker":"My4=","Num":3},"Properties":{"id":"20260203194530-bff94sj","updated":"20260203194548"},"Children":[{"ID":"20260203194530-qd9pek1","Type":"NodeParagraph","Properties":{"id":"20260203194530-qd9pek1","updated":"20260203194548"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"包含物体的置信度损失"},{"Type":"NodeText","Data":"："}]}]}]},{"ID":"20260203191349-fijsata","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260203191349-fijsata","style":"direction: ltr;","updated":"20260203193023"},"Children":[{"Type":"NodeText","Data":"2.2.2 激活函数问题"}]},{"ID":"20260203191122-1s9a4cw","Type":"NodeParagraph","Properties":{"id":"20260203191122-1s9a4cw","updated":"20260203193023"}}]}