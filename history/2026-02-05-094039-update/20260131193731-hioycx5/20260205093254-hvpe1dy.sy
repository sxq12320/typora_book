nlineMathContent":"\\frac{c}{r}\\times c"},{"Type":"NodeText","Data":"这么一个大小的矩阵，用来进行降维度；第一个矩阵"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"W_2"},{"Type":"NodeText","Data":"是一个"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"c \\times \\frac{c}{r} "},{"Type":"NodeText","Data":"这么一个大小的矩阵，用来进行升高维度。"}]},{"ID":"20260205093254-l0w7id0","Type":"NodeParagraph","Properties":{"id":"20260205093254-l0w7id0","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"这东西其实就是一个微形的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"多层感知机"},{"Type":"NodeText","Data":"，只是由于输入和输出的通道数过大直接放进全连接层里面太大了就给他降降维度。"}]},{"ID":"20260205093254-96t7qzy","Type":"NodeParagraph","Properties":{"id":"20260205093254-96t7qzy","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"也可以说是 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"SE Block"},{"Type":"NodeText","Data":" 的大脑。它拿到了那 64 个总结数字，开始思考："},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"“针对现在的任务，哪些特征是重要的”"}]},{"ID":"20260205093254-22c8se0","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260205093254-22c8se0","updated":"20260205093254"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"2.3 加权"}]},{"ID":"20260205093254-gc1f9i3","Type":"NodeParagraph","Properties":{"id":"20260205093254-gc1f9i3","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"将学习的权重用到原始的特征图上面。把刚才算出来的 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"C"},{"Type":"NodeText","Data":" 个权重，分别乘到原始输入特征图的 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"C"},{"Type":"NodeText","Data":" 个通道上"}]},{"ID":"20260205093254-ehu581e","Type":"NodeMathBlock","Properties":{"id":"20260205093254-ehu581e","updated":"20260205093254"},"Children":[{"Type":"NodeMathBlockOpenMarker"},{"Type":"NodeMathBlockContent"},{"Type":"NodeMathBlockCloseMarker"}]},{"ID":"20260205093254-1y2n5k1","Type":"NodeThematicBreak","Properties":{"id":"20260205093254-1y2n5k1","updated":"20260205093254"}},{"ID":"20260205093254-95sr9ff","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260205093254-95sr9ff","updated":"20260205093254"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"3.SEBLOCK结构框图和基本代码展示"}]},{"ID":"20260205093254-uj0m84v","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260205093254-uj0m84v","updated":"20260205093254"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"3.1 结构框图"}]},{"ID":"20260205093254-mifwelf","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bWVybWFpZA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260205093254-mifwelf","updated":"20260205093254"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bWVybWFpZA=="},{"Type":"NodeCodeBlockCode","Data":"graph TB\n    %% 定义节点样式\n    classDef input fill:#e1f5fe,stroke:#01579b,stroke-width:2px;\n    classDef process fill:#f5f5f5,stroke:#333,stroke-width:1px;\n    %% 全连接层高亮样式\n    classDef fc fill:#fff9c4,stroke:#fbc02d,stroke-width:2px;\n    %% 操作符高亮样式\n    classDef op fill:#ffccbc,stroke:#bf360c,stroke-width:2px;\n\n    subgraph SE_Block [Squeeze-and-Excitation Block]\n        direction TB\n        \n        %% 1. 输入部分\n        Input(输入特征图 U\u003cbr/\u003eH × W × C):::input\n        \n        %% 2. Squeeze 部分\n        GAP[全局平均池化\u003cbr/\u003eGlobal Avg Pool]:::process\n        \n        %% 3. Excitation 部分 (核心瓶颈结构)\n        subgraph Bottleneck [Excitation: 瓶颈结构]\n            direction TB\n            FC1[FC Layer 1 \u003cbr/\u003e降维矩阵 W1\u003cbr/\u003eC → C/r]:::fc\n            ReLU[ReLU 激活]:::process\n            FC2[FC Layer 2 \u003cbr/\u003e升维矩阵 W2\u003cbr/\u003eC/r → C]:::fc\n            Sigmoid[Sigmoid 激活\u003cbr/\u003e归一化到 0~1]:::process\n        end\n        \n        %% 4. Scale 部分\n        Scale((X\u003cbr/\u003eScale操作)):::op\n        \n        %% 5. 输出部分\n        Output(重标定后的特征图\u003cbr/\u003eH × W × C):::input\n\n        %% --- 连线逻辑 ---\n        \n        %% 路径 A: 权重生成路径 (Squeeze \u0026 Excitation)\n        Input --\u003e GAP\n        GAP --\u003e|1×1×C| FC1\n        FC1 --\u003e|1×1×C/r| ReLU\n        ReLU --\u003e FC2\n        FC2 --\u003e|1×1×C| Sigmoid\n        Sigmoid --\u003e|生成权重 s| Scale\n\n        %% 路径 B: 原始特征路径 (直接连到 Scale)\n        %% 为了美观，通常画在侧边，但在垂直流中直接连即可\n        Input --\u003e|原始特征路径| Scale\n        \n        %% 最终输出\n        Scale --\u003e Output\n    end\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260205093254-38bk9i6","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260205093254-38bk9i6","updated":"20260205093254"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"3.2"}]},{"ID":"20260205093254-9p23u8d","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"cHl0aG9u","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260205093254-9p23u8d","updated":"20260205093254"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"cHl0aG9u"},{"Type":"NodeCodeBlockCode","Data":"import torch \nimport torch.nn as nn\nimport matplotlib.pyplot as plt\nimport torch.nn.functional as F\nimport torch.optim as optim\nfrom torchvision import datasets, transforms\nfrom torch.utils.data import DataLoader\nimport os\nimport numpy as np\nimport gzip\nimport sys\n\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprint(f\"Using device: {device}\")\n\nclass SEBlock(nn.Module):\n    '''SEBlock: Squeeze-and-Excitation Block 注意力机制模块\n        Args:\n            out_channels:   输入特征图的通道数\n            reduction:      压缩比例,默认值为4\n    '''\n    def __init__(self ,out_channels , reduction = 4):\n        super(SEBlock, self).__init__()\n        self.global_avg_pool  = nn.AdaptiveAvgPool2d(1)\n        self.fc1 = nn.Linear(out_channels, out_channels // reduction , bias=False)\n        self.relu = nn.ReLU()\n        self.fc2 = nn.Linear(out_channels // reduction , out_channels , bias=False)\n        self.sigmoid = nn.Sigmoid()\n    \n    def forward(self , x):\n        b , c , h , w = x.size()                    # 获取输入特征的尺寸，b:batch_size,c:channels,h:height,w:width\n\n        y  = self.global_avg_pool(x).view(b , c)    # 第一步：全局平均池化，得到每个通道的全局特征Sequence，[b, c, 1, 1] -\u003e [b, c]\n\n        y = self.fc1(y)\n        y = self.relu(y)\n        y = self.fc2(y)\n        y = self.sigmoid(y).view(b , c , 1 , 1)     # 第二步：通过两个全连接层和激活函数，得到每个通道的权重,先降低维度后上升维度[b,c] -\u003e [b,c,1,1]\n\n        out = x * y                                 # 第三步：将权重与原始特征图相乘，进行通道的重新校准        \n\n        return out\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]}]}