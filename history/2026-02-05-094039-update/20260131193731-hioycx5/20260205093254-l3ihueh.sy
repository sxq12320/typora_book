{"ID":"20260205093254-l3ihueh","Spec":"2","Type":"NodeDocument","Properties":{"id":"20260205093254-l3ihueh","title":"9_GoogleNet","type":"doc","updated":"20260205093254"},"Children":[{"ID":"20260205093254-srir6xa","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20260205093254-srir6xa","updated":"20260205093254"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"# "},{"Type":"NodeText","Data":"GoogleNet"}]},{"ID":"20260205093254-2t5sfwl","Type":"NodeBlockquote","Properties":{"id":"20260205093254-2t5sfwl","updated":"20260205093254"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260205093254-h0syl74","Type":"NodeParagraph","Properties":{"id":"20260205093254-h0syl74","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"[!NOTE]"}]},{"ID":"20260205093254-xkqpdem","Type":"NodeParagraph","Properties":{"id":"20260205093254-xkqpdem","updated":"20260205093254"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"GoogleNet"},{"Type":"NodeText","Data":"是"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Google"},{"Type":"NodeText","Data":"公司于2014年在论文"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Going Deeper with Convolutions"},{"Type":"NodeText","Data":"中提出的。"}]},{"ID":"20260205093254-netgc3y","Type":"NodeParagraph","Properties":{"id":"20260205093254-netgc3y","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"他的网络架构可以说是开创新的一种网络架构，不仅仅是前一代"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"NIN"},{"Type":"NodeText","Data":"网络的延续同时也是神经网络模型在宽度方面开枝散叶的第一人。是神经网络向着宽度领域迈出的一大步。"}]}]},{"ID":"20260205093254-kqjpcfu","Type":"NodeThematicBreak","Properties":{"id":"20260205093254-kqjpcfu","updated":"20260205093254"}},{"ID":"20260205093254-6bbplm9","Type":"NodeParagraph","Properties":{"id":"20260205093254-6bbplm9","updated":"20260205093254"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260124143144695"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"https://img2024.cnblogs.com/blog/3693258/202601/3693258-20260124160207837-1299537957.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260205093254-vn6e5zp","Type":"NodeThematicBreak","Properties":{"id":"20260205093254-vn6e5zp","updated":"20260205093254"}},{"ID":"20260205093254-8kfogpt","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260205093254-8kfogpt","updated":"20260205093254"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"1 模型设计背景"}]},{"ID":"20260205093254-kxwwd9a","Type":"NodeParagraph","Properties":{"id":"20260205093254-kxwwd9a","updated":"20260205093254"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"2014"},{"Type":"NodeText","Data":"年前后那个时代应该说是卷积神经网络大爆发的一个时代，各种新点子层出不穷，人们在目标检测以及分类工作上取得了巨大的成功。"}]},{"ID":"20260205093254-a0zignz","Type":"NodeBlockquote","Properties":{"id":"20260205093254-a0zignz","updated":"20260205093254"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260205093254-c9whoen","Type":"NodeParagraph","Properties":{"id":"20260205093254-c9whoen","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"在论文中也提到了“现在的目标检测和目标分类的任务获得如此好的效果不仅仅归功于好的硬件，大的数据集等；最主要的还是大家的想法，算法，模型等的创新”"}]}]},{"ID":"20260205093254-t39jqgj","Type":"NodeParagraph","Properties":{"id":"20260205093254-t39jqgj","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"当时的阶段人们在提高神经网络模型效果主要是采用两种方式："}]},{"ID":"20260205093254-tiyi8e6","Type":"NodeList","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260205093254-tiyi8e6","updated":"20260205093254"},"Children":[{"ID":"20260205093254-j9cugry","Type":"NodeListItem","Data":"1.","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260205093254-j9cugry","updated":"20260205093254"},"Children":[{"ID":"20260205093254-ptw90d4","Type":"NodeParagraph","Properties":{"id":"20260205093254-ptw90d4","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"提高网络层数-深度"}]}]},{"ID":"20260205093254-gy50dio","Type":"NodeListItem","Data":"2.","ListData":{"Typ":1,"Tight":true,"Start":2,"Delimiter":46,"Padding":3,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260205093254-gy50dio","updated":"20260205093254"},"Children":[{"ID":"20260205093254-jx0gh5e","Type":"NodeParagraph","Properties":{"id":"20260205093254-jx0gh5e","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"提高单层网络的通道数量-宽度"}]}]}]},{"ID":"20260205093254-vv7q5xp","Type":"NodeBlockquote","Properties":{"id":"20260205093254-vv7q5xp","updated":"20260205093254"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260205093254-tb8kppz","Type":"NodeParagraph","Properties":{"id":"20260205093254-tb8kppz","updated":"20260205093254"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260124144728773"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"https://img2024.cnblogs.com/blog/3693258/202601/3693258-20260124160206250-551855185.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260205093254-scswgrl","Type":"NodeParagraph","Properties":{"id":"20260205093254-scswgrl","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"上面的图片可以看成是一个神经网络系统模型。"}]},{"ID":"20260205093254-0j4csem","Type":"NodeParagraph","Properties":{"id":"20260205093254-0j4csem","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"宽度就是单个层最大的红色圈圈的数量，也就是有几行。"}]},{"ID":"20260205093254-kuhw7g5","Type":"NodeParagraph","Properties":{"id":"20260205093254-kuhw7g5","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"深度就是总共的层数，也就是有几列。"}]}]},{"ID":"20260205093254-1urnrc2","Type":"NodeParagraph","Properties":{"id":"20260205093254-1urnrc2","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"但是如果仅仅一味的提高模型深度会导致训练的参数量过大，出现过拟合的现象；同时不断地拉高宽度会导致模型的计算量过大，造成计算资源的极大浪费。"}]},{"ID":"20260205093254-i4xi8o2","Type":"NodeParagraph","Properties":{"id":"20260205093254-i4xi8o2","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"因此趁着"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"2014"},{"Type":"NodeText","Data":" 年 "},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"ImageNet"},{"Type":"NodeText","Data":" 大规模视觉识别挑战赛 "},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"(ILSVRC14)"},{"Type":"NodeTextMark","TextMarkType":"em em","TextMarkTextContent":"开赛的关节之上，Google公司带着他的巨作"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"GoogleNet"},{"Type":"NodeText","Data":"来了。"}]},{"ID":"20260205093254-pdjtnb8","Type":"NodeParagraph","Properties":{"id":"20260205093254-pdjtnb8","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"该网络整体采用分支的结构，在增强特征融合以及信息采集的同时降低计算量。"}]},{"ID":"20260205093254-gw87h6m","Type":"NodeParagraph","Properties":{"id":"20260205093254-gw87h6m","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"并且在前人"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"NIN"},{"Type":"NodeText","Data":"网络的启发之下，非常启发性的使用"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"1×1"},{"Type":"NodeText","Data":"的卷积神经网络不仅仅为了一部分的特征提取，更为了使用它来降低运算过程中的维度过大的问题。"}]},{"ID":"20260205093254-ze2g6fe","Type":"NodeParagraph","Properties":{"id":"20260205093254-ze2g6fe","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"另外在"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"VGG"},{"Type":"NodeText","Data":"和"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"NIN"},{"Type":"NodeText","Data":"的启发之下，也使用了一种块而来完美的集成在网络之中。可以说是卷"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"积神经网络中的卷积神经网络"},{"Type":"NodeText","Data":"了。"}]},{"ID":"20260205093254-tspdo5d","Type":"NodeBlockquote","Properties":{"id":"20260205093254-tspdo5d","updated":"20260205093254"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260205093254-hibkl2y","Type":"NodeParagraph","Properties":{"id":"20260205093254-hibkl2y","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"站在当时的角度想一想看，这个GoogleNet主要就是解决了当时的其中的几个问题，并且将之前人们模型的好处进行了提取，融入自己的同时发散思维大力创新。"}]}]},{"ID":"20260205093254-1qy8jo3","Type":"NodeThematicBreak","Properties":{"id":"20260205093254-1qy8jo3","updated":"20260205093254"}},{"ID":"20260205093254-v9fv2x3","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260205093254-v9fv2x3","updated":"20260205093254"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"2 模型整体框架"}]},{"ID":"20260205093254-8mf9w3d","Type":"NodeParagraph","Properties":{"id":"20260205093254-8mf9w3d","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"这个模型最重要的我认为并不是他的整体架构是如何设计的，更重要的是其中一个模块的设计，在论文中对该模块的命名为"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Inception"},{"Type":"NodeText","Data":"这个模块也是整个模型最重要的创新点。"}]},{"ID":"20260205093254-3vebio9","Type":"NodeParagraph","Properties":{"id":"20260205093254-3vebio9","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"现在对该模块进行剖析。"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Inception"},{"Type":"NodeText","Data":"模块如下图所示"}]},{"ID":"20260205093254-39j23zs","Type":"NodeParagraph","Properties":{"id":"20260205093254-39j23zs","updated":"20260205093254"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260124145310983"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"https://img2024.cnblogs.com/blog/3693258/202601/3693258-20260124160209961-211430197.png"},{"Type":"NodeCloseParen","Data":")"}]},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"首先偏向理性的对这个模块进行说明：这个模块的信息流流向是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"从下到上"},{"Type":"NodeText","Data":"的上一步骤的图片进入的模型之中形成产生了四个分支，从左往右分别为："}]},{"ID":"20260205093254-m52ybjl","Type":"NodeList","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260205093254-m52ybjl","updated":"20260205093254"},"Children":[{"ID":"20260205093254-2ffxzf3","Type":"NodeListItem","Data":"1.","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260205093254-2ffxzf3","updated":"20260205093254"},"Children":[{"ID":"20260205093254-yvzbhsq","Type":"NodeParagraph","Properties":{"id":"20260205093254-yvzbhsq","updated":"20260205093254"},"Children":[{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"1\\times 1 "},{"Type":"NodeText","Data":"大小的一次小型卷积操作；"}]}]},{"ID":"20260205093254-nebse10","Type":"NodeListItem","Data":"2.","ListData":{"Typ":1,"Tight":true,"Start":2,"Delimiter":46,"Padding":3,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260205093254-nebse10","updated":"20260205093254"},"Children":[{"ID":"20260205093254-cwt445z","Type":"NodeParagraph","Properties":{"id":"20260205093254-cwt445z","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"先进行"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"1\\times 1 "},{"Type":"NodeText","Data":"大小的一次小型卷积操作，然后进行"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"3\\times 3 "},{"Type":"NodeText","Data":"大小的一次中型卷积操作；"}]}]},{"ID":"20260205093254-vb6i4z7","Type":"NodeListItem","Data":"3.","ListData":{"Typ":1,"Tight":true,"Start":3,"Delimiter":46,"Padding":3,"Marker":"My4=","Num":3},"Properties":{"id":"20260205093254-vb6i4z7","updated":"20260205093254"},"Children":[{"ID":"20260205093254-2k8kdjr","Type":"NodeParagraph","Properties":{"id":"20260205093254-2k8kdjr","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"先进行"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"1\\times 1 "},{"Type":"NodeText","Data":"大小的一次小型卷积操作，然后进行"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"5\\times 5 "},{"Type":"NodeText","Data":"大小的一次大型卷积操作；"}]}]},{"ID":"20260205093254-62ek7n0","Type":"NodeListItem","Data":"4.","ListData":{"Typ":1,"Tight":true,"Start":4,"Delimiter":46,"Padding":3,"Marker":"NC4=","Num":4},"Properties":{"id":"20260205093254-62ek7n0","updated":"20260205093254"},"Children":[{"ID":"20260205093254-bk73hc2","Type":"NodeParagraph","Properties":{"id":"20260205093254-bk73hc2","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"先进行"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"3\\times 3 "},{"Type":"NodeText","Data":"大小的一次最大池化操作，然后进行"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"1\\times 1 "},{"Type":"NodeText","Data":"大小的一次小型卷积操作；"}]}]}]},{"ID":"20260205093254-37ug9a8","Type":"NodeParagraph","Properties":{"id":"20260205093254-37ug9a8","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"每个分支操作完毕之后，得到了四组矩阵然后将这四组矩阵进行拼接即可得到模块的输出。"}]},{"ID":"20260205093254-zqtru27","Type":"NodeParagraph","Properties":{"id":"20260205093254-zqtru27","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"那么为什么要这么设计呢，现在用偏向感性的想法进行思考，可能有点不对，但应该有助于理解吧。"}]},{"ID":"20260205093254-eo81kk5","Type":"NodeList","ListData":{"Typ":1,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260205093254-eo81kk5","updated":"20260205093254"},"Children":[{"ID":"20260205093254-38zlkio","Type":"NodeListItem","Data":"1.","ListData":{"Typ":1,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260205093254-38zlkio","updated":"20260205093254"},"Children":[{"ID":"20260205093254-385e6xs","Type":"NodeParagraph","Properties":{"id":"20260205093254-385e6xs","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"左侧蓝色的"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"1\\times 1 "},{"Type":"NodeText","Data":"大小的一次小型卷积操作，在这个分支"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"1\\times 1 "},{"Type":"NodeText","Data":"的卷积核有了"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"第一个"},{"Type":"NodeText","Data":"用处，这个东西是可以实现跨通道融合的一个事情。实际上它可以用一个公式表示一下"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"Y_{c_out,h,w} = Σ_{c_in=1}^{C_in} W_{c_out,c_in} · X_{c_in,h,w} + b_{c_out}"},{"Type":"NodeText","Data":"这个的本质其实就是，基本卷积运算。这个操作就想到把各个通道融合在一起做了一件事情。"}]},{"ID":"20260205093254-gcmuhdu","Type":"NodeBlockquote","Properties":{"id":"20260205093254-gcmuhdu","updated":"20260205093254"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260205093254-jymk5vl","Type":"NodeParagraph","Properties":{"id":"20260205093254-jymk5vl","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"相当于对输入的图片做了通道处理，以及特征重组操作，并没有对空间做事情。"}]},{"ID":"20260205093254-8nf363f","Type":"NodeParagraph","Properties":{"id":"20260205093254-8nf363f","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"这里也可以说，小的视野关注小的物体，主要就是为了较小目标的识别"}]}]}]},{"ID":"20260205093254-5msyut2","Type":"NodeListItem","Data":"2.","ListData":{"Typ":1,"Tight":true,"Start":2,"Delimiter":46,"Padding":3,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260205093254-5msyut2","updated":"20260205093254"},"Children":[{"ID":"20260205093254-hwjy0oi","Type":"NodeParagraph","Properties":{"id":"20260205093254-hwjy0oi","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"第二个分支也就是中间的先"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"1"},{"Type":"NodeText","Data":"后"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"3"},{"Type":"NodeText","Data":".这里的"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"1×1"},{"Type":"NodeText","Data":"卷积的目的已经不再是为了进行通道混合出特征了，而是为了降低维度也就是降低通道数，降低后续"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"3×3"},{"Type":"NodeText","Data":"的计算量。"}]},{"ID":"20260205093254-6wte9he","Type":"NodeBlockquote","Properties":{"id":"20260205093254-6wte9he","updated":"20260205093254"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260205093254-pczr4oi","Type":"NodeParagraph","Properties":{"id":"20260205093254-pczr4oi","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"这里也可以说，中等目标关注的就是中等目标的事情"}]}]}]},{"ID":"20260205093254-k0i8yuo","Type":"NodeListItem","Data":"3.","ListData":{"Typ":1,"Tight":true,"Start":3,"Delimiter":46,"Padding":3,"Marker":"My4=","Num":3},"Properties":{"id":"20260205093254-k0i8yuo","updated":"20260205093254"},"Children":[{"ID":"20260205093254-l9ovzk1","Type":"NodeParagraph","Properties":{"id":"20260205093254-l9ovzk1","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"第三个分支与第二个分支有异曲同工之妙。只不过换个大视野的玩意儿罢了"}]}]},{"ID":"20260205093254-axv4g2x","Type":"NodeListItem","Data":"4.","ListData":{"Typ":1,"Tight":true,"Start":4,"Delimiter":46,"Padding":3,"Marker":"NC4=","Num":4},"Properties":{"id":"20260205093254-axv4g2x","updated":"20260205093254"},"Children":[{"ID":"20260205093254-h3wb915","Type":"NodeParagraph","Properties":{"id":"20260205093254-h3wb915","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"第四个分支先进行最大池化，然后进行"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"1×1"},{"Type":"NodeText","Data":"的卷积操作。池化就两个事情，第一个下采样，找到最显著的特征，第二个降低空间尺寸大小。"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"1×1"},{"Type":"NodeText","Data":"卷积就不再多说了也是老生常谈的更改维度的作用。"}]}]}]},{"ID":"20260205093254-xke36p2","Type":"NodeBlockquote","Properties":{"id":"20260205093254-xke36p2","updated":"20260205093254"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260205093254-l031hj0","Type":"NodeParagraph","Properties":{"id":"20260205093254-l031hj0","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"这就是"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Inception"},{"Type":"NodeText","Data":"整体模块的一些事情他其实就是在一个模块中探索多种可能行，用不同的视野不同的方式来看世界"}]},{"ID":"20260205093254-jist4pg","Type":"NodeParagraph","Properties":{"id":"20260205093254-jist4pg","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"可谓是优雅"}]}]},{"ID":"20260205093254-waa6478","Type":"NodeParagraph","Properties":{"id":"20260205093254-waa6478","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"到这里"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"GoogleNet"},{"Type":"NodeText","Data":"的最值得说的也就说完了。他的整体框架就放在下面，可以复现一下试试效果。"}]},{"ID":"20260205093254-ze9tog0","Type":"NodeParagraph","Properties":{"id":"20260205093254-ze9tog0","updated":"20260205093254"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260124154033397"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"https://img2024.cnblogs.com/blog/3693258/202601/3693258-20260124160212384-1029974768.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260205093254-c68z0ad","Type":"NodeThematicBreak","Properties":{"id":"20260205093254-c68z0ad","updated":"20260205093254"}},{"ID":"20260205093254-19044zm","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260205093254-19044zm","updated":"20260205093254"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"3 代码实现"}]},{"ID":"20260205093254-9jsve35","Type":"NodeParagraph","Properties":{"id":"20260205093254-9jsve35","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"首先就是"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Inception"},{"Type":"NodeText","Data":"的代码实现"}]},{"ID":"20260205093254-y6g9rdg","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"cHl0aG9u","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260205093254-y6g9rdg","updated":"20260205093254"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"cHl0aG9u"},{"Type":"NodeCodeBlockCode","Data":"import torch \nimport torch.nn as nn\n\nclass InceptionBlock(nn.Module):\n    '''Googlenet 的 Inception 模块\n    Args:\n        in_channels: 输入的通道数\n    Returns: \n    '''\n    def __init__(self , in_channels , out_1x1 ,  out_3x3_reduce , out_3x3 , out_5x5_reduce , out_5x5 , out_pool_proj):\n        super(InceptionBlock, self).__init__()\n        '''inception 模块包含四个并行的分支：\n            Args:\n                in_channels: 输入的通道数\n                out_1x1: 1x1 卷积层输出的通道数\n                out_3x3_reduce: 3x3 卷积层前的降维 1x1 卷积层输出的通道数\n                out_3x3: 3x3 卷积层输出的通道数\n                out_5x5_reduce: 5x5 卷积层前的降维 1x1 卷积层输出的通道数\n                out_5x5: 5x5 卷积层输出的通道数\n                out_pool_proj: 池化层后 1x1 卷积层输出的通道数 \n        '''\n\n        # 1x1 卷积层\n        self.branch1x1 = nn.Sequential(\n            nn.Conv2d(in_channels = in_channels , out_channels = out_1x1 , kernel_size = 1),\n            nn.BatchNorm2d(out_1x1),\n            nn.ReLU(inplace=True)\n        )\n\n        # 3x3 卷积层\n        self.branch3x3 = nn.Sequential(\n            nn.Conv2d(in_channels = in_channels , out_channels = out_3x3_reduce , kernel_size=1), # 用1x1 卷积进行降维\n            nn.BatchNorm2d(out_3x3_reduce),\n            nn.ReLU(inplace=True),\n            nn.Conv2d(in_channels = out_3x3_reduce , out_channels = out_3x3 , kernel_size=3 , padding=1),\n            nn.BatchNorm2d(out_3x3),\n            nn.ReLU(inplace=True)\n        )\n\n        # 5x5 卷积层\n        self.branch5x5 = nn.Sequential(\n            nn.Conv2d(in_channels = in_channels , out_channels = out_5x5_reduce , kernel_size=1), # 用1x1 卷积进行降维\n            nn.BatchNorm2d(out_5x5_reduce),\n            nn.ReLU(inplace=True),\n            nn.Conv2d(in_channels = out_5x5_reduce , out_channels = out_5x5 , kernel_size=5 , padding=2),\n            nn.BatchNorm2d(out_5x5),\n            nn.ReLU(inplace=True)\n        )\n\n        # 最大池化层\n        self.poolbranch = nn.Sequential(\n            nn.MaxPool2d(kernel_size=3 , stride=1 , padding=1),\n            nn.Conv2d(in_channels = in_channels , out_channels = out_pool_proj , kernel_size=1),\n            nn.BatchNorm2d(out_pool_proj),\n            nn.ReLU(inplace=True)\n        )\n        \n    def forward(self , x):\n        branch1x1 = self.branch1x1(x)\n        branch3x3 = self.branch3x3(x)\n        branch5x5 = self.branch5x5(x)\n        branchpool = self.poolbranch(x)\n\n        out = torch.cat([branch1x1 , branch3x3 , branch5x5 , branchpool], dim=1) # (batch_size, channels, height, width) ,channels维度拼接\n\n        return out\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260205093254-ivaplek","Type":"NodeParagraph","Properties":{"id":"20260205093254-ivaplek","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"再来就是基于原论文的"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"GoogleNet"},{"Type":"NodeText","Data":"代码框架实现"}]},{"ID":"20260205093254-jlp45pg","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"cHl0aG9u","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260205093254-jlp45pg","updated":"20260205093254"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"cHl0aG9u"},{"Type":"NodeCodeBlockCode","Data":"import torch \nimport torch.nn as nn\n\nclass GoogleNet(nn.Module):\n    def __init__(self , num_classes=1000):\n        super(GoogleNet , self).__init__()\n        '''Googlenet 网络结构\n        '''\n        self.googleNet = nn.Sequential(\n            nn.Conv2d(in_channels = 3 , out_channels = 64 , kernel_size = 7 , stride = 2 , padding = 3),\n            nn.BatchNorm2d(64),\n            nn.ReLU(inplace=True),\n            nn.MaxPool2d(kernel_size=3 , stride=2 , padding=1),\n\n            nn.Conv2d(in_channels = 64 , out_channels = 192 , kernel_size = 3 , stride = 1 , padding = 1),\n            nn.BatchNorm2d(192),\n            nn.ReLU(inplace=True),\n            nn.MaxPool2d(kernel_size=3 , stride=2 , padding=1),\n\n            InceptionBlock(192 , 64 , 96 , 128 , 16 , 32 , 32),#3a\n            InceptionBlock(256 , 128 , 128 , 192 , 32 , 96 , 64),#3b\n            nn.MaxPool2d(kernel_size=3 , stride=2 , padding=1),\n\n            InceptionBlock(480 , 192 , 96 , 208 , 16 , 48 , 64),#4a\n            InceptionBlock(512 , 160 , 112 , 224 , 24 , 64 , 64),#4b\n            InceptionBlock(512 , 128 , 128 , 256 , 24 , 64 , 64),#4c\n            InceptionBlock(512 , 112 , 144 , 288 , 32 , 64 , 64),#4d\n            InceptionBlock(528 , 256 , 160 , 320 , 32 , 128 , 128),#4e\n            nn.MaxPool2d(kernel_size=3 , stride=2 , padding=1),\n\n            InceptionBlock(832 , 256 , 160 , 320 , 32 , 128 , 128),#5a\n            InceptionBlock(832 , 384 , 192 , 384 , 48 , 128 , 128),#5b\n\n            nn.AdaptiveAvgPool2d((1,1)),    \n            nn.Dropout(0.4),\n            nn.Flatten(),\n            nn.Linear(1024 , num_classes)\n        )\n    def forward(self , x):\n        return self.googleNet(x)\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260205093254-85xqroy","Type":"NodeParagraph","Properties":{"id":"20260205093254-85xqroy","updated":"20260205093254"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"GoogleNet"},{"Type":"NodeText","Data":"的代码是依据上面的表格的，这个相关的流程图也放一下吧。"}]},{"ID":"20260205093254-wbvmw68","Type":"NodeBlockquote","Properties":{"id":"20260205093254-wbvmw68","updated":"20260205093254"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260205093254-bcyf6z0","Type":"NodeParagraph","Properties":{"id":"20260205093254-bcyf6z0","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"实在是太长了"}]}]},{"ID":"20260205093254-m24rp3e","Type":"NodeParagraph","Properties":{"id":"20260205093254-m24rp3e","updated":"20260205093254"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260124154357179"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"assets/image-20260124154357179.png"},{"Type":"NodeCloseParen","Data":")"}]}]}]}