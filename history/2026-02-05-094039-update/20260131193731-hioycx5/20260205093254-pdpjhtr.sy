{"ID":"20260205093254-pdpjhtr","Spec":"2","Type":"NodeDocument","Properties":{"id":"20260205093254-pdpjhtr","title":"12_ConvNeXt","type":"doc","updated":"20260205093254"},"Children":[{"ID":"20260205093254-iswem3h","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20260205093254-iswem3h","updated":"20260205093254"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"# "},{"Type":"NodeText","Data":"ConvNeXt"}]},{"ID":"20260205093254-iy5vdsb","Type":"NodeBlockquote","Properties":{"id":"20260205093254-iy5vdsb","updated":"20260205093254"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260205093254-m1o8xmg","Type":"NodeParagraph","Properties":{"id":"20260205093254-m1o8xmg","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"卷积神经网络最后的荣光"}]},{"ID":"20260205093254-pc2hnb1","Type":"NodeParagraph","Properties":{"id":"20260205093254-pc2hnb1","updated":"20260205093254"},"Children":[{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"ConvNeXt"},{"Type":"NodeText","Data":"是"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"FaceBook"},{"Type":"NodeText","Data":"于"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"2022"},{"Type":"NodeText","Data":"年在论文"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"A ConvNet for 2020s"},{"Type":"NodeText","Data":"中提出的，全文非常硬气的使用纯粹的卷积神经网络，希望曾经盛极一时的卷积神经网路能够重现往日的荣光。"}]}]},{"ID":"20260205093254-tstlpmv","Type":"NodeParagraph","Properties":{"id":"20260205093254-tstlpmv","updated":"20260205093254"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260127085723019"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"https://img2024.cnblogs.com/blog/3693258/202601/3693258-20260127195820526-2080966440.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260205093254-5w6cnph","Type":"NodeThematicBreak","Properties":{"id":"20260205093254-5w6cnph","updated":"20260205093254"}},{"ID":"20260205093254-w6unczq","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260205093254-w6unczq","updated":"20260205093254"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"1 模型创作背景"}]},{"ID":"20260205093254-gvlky4y","Type":"NodeParagraph","Properties":{"id":"20260205093254-gvlky4y","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"放眼整个神经网络在计算机视觉方面的进程，不外乎三个阶段：1. 全连接神经网络的探索期；2. 卷积神经网络的爆发期；3. 由"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"TransFormer"},{"Type":"NodeText","Data":"引起的大语言模型的改革期。"}]},{"ID":"20260205093254-j2xkd17","Type":"NodeParagraph","Properties":{"id":"20260205093254-j2xkd17","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"现在"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"21"},{"Type":"NodeText","Data":"世纪"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"20"},{"Type":"NodeText","Data":"年代，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"VIT"},{"Type":"NodeText","Data":"的产生引起的神经网络在计算机视觉方面的应用朝着自注意力机制展开。曾经的"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"NLP"},{"Type":"NodeText","Data":"与"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"CV"},{"Type":"NodeText","Data":"是一门两家，但是现在这两个被巧妙的融合了起来。"}]},{"ID":"20260205093254-q79c9dx","Type":"NodeParagraph","Properties":{"id":"20260205093254-q79c9dx","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"正是如此，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"VIT"},{"Type":"NodeText","Data":"基本上刷新了计算机视觉的各类榜单，它迅速的取代了传统的卷积神经网络，称为最先进的图像处理模型工具。"}]},{"ID":"20260205093254-ovd71kl","Type":"NodeParagraph","Properties":{"id":"20260205093254-ovd71kl","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"同年代，"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Swin TransFormer"},{"Type":"NodeText","Data":"的出现打破了"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"VIT"},{"Type":"NodeText","Data":"模型架构在处理对象检测以及语义分割上面的诸多困难，称为了当时最强的架构，没有之一。"}]},{"ID":"20260205093254-buhejya","Type":"NodeParagraph","Properties":{"id":"20260205093254-buhejya","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"那么，在这个前提之下，卷积神经网络真的是一无是处吗？卷积神经网络在今后就没有超越"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"TransFormer"},{"Type":"NodeText","Data":"的可能性吗？基于此作者认为，纯粹的卷积神经网络依然由提升的空间，毕竟Swin TransFormer的一些设计也是向着卷积神经网络的思路来借鉴的，那么我们也可以借鉴一下人家的设计思路。"}]},{"ID":"20260205093254-me0xllp","Type":"NodeParagraph","Properties":{"id":"20260205093254-me0xllp","updated":"20260205093254"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image-20260127092546015"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"https://img2024.cnblogs.com/blog/3693258/202601/3693258-20260127200019475-2007027951.png"},{"Type":"NodeCloseParen"}]}]},{"ID":"20260205093254-rl2ox8f","Type":"NodeParagraph","Properties":{"id":"20260205093254-rl2ox8f","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"由此"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"ConvNeXt"},{"Type":"NodeText","Data":"就油然而生了"}]},{"ID":"20260205093254-i0v0s58","Type":"NodeThematicBreak","Properties":{"id":"20260205093254-i0v0s58","updated":"20260205093254"}},{"ID":"20260205093254-m9v3d6r","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260205093254-m9v3d6r","updated":"20260205093254"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"2 模型整体架构"}]},{"ID":"20260205093254-qh0wao5","Type":"NodeParagraph","Properties":{"id":"20260205093254-qh0wao5","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"卷积神经网络最强的一届大爆发显然就是"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"2016"},{"Type":"NodeText","Data":"年提出"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"ResNet"},{"Type":"NodeText","Data":"的那一次 ，因此本文就用"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"ResNet"},{"Type":"NodeText","Data":"作为基线并借鉴"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Swin TransFormer"},{"Type":"NodeText","Data":"上面的一些想法对传统的"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"ResNet"},{"Type":"NodeText","Data":"网络架构进行修改，并将其命名为"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"ConvNeXt"},{"Type":"NodeText","Data":"来和当今最强大的神经网络架构"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Swin TranFromer"},{"Type":"NodeText","Data":"扳扳手腕。"}]},{"ID":"20260205093254-qhsh3t1","Type":"NodeBlockquote","Properties":{"id":"20260205093254-qhsh3t1","updated":"20260205093254"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260205093254-mgm9u5s","Type":"NodeParagraph","Properties":{"id":"20260205093254-mgm9u5s","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"ResNet是2016年提出的残差连接结构，使用短接的方式大大提高了模型的精度水平等等，成为了当时乃至现在最著名的一种网络架构。"}]}]},{"ID":"20260205093254-40b2kth","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260205093254-40b2kth","updated":"20260205093254"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"2.1 宏观方面的改进"}]},{"ID":"20260205093254-4h2u2oz","Type":"NodeParagraph","Properties":{"id":"20260205093254-4h2u2oz","updated":"20260205093254"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"改进一："},{"Type":"NodeText","Data":"修改原本"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"ResNet"},{"Type":"NodeText","Data":"每一层的区块数量，原本的区块数量为"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"3:4:6:3"},{"Type":"NodeText","Data":"，改成现在的"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"3:3:9:3"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260205093254-yob18fy","Type":"NodeBlockquote","Properties":{"id":"20260205093254-yob18fy","updated":"20260205093254"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260205093254-rmeujux","Type":"NodeParagraph","Properties":{"id":"20260205093254-rmeujux","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"原先的设计主要是基于经验注意的一种设计思路，因此这里借鉴了"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Swin-T"},{"Type":"NodeText","Data":"中的比例"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"1:1:3:1"},{"Type":"NodeText","Data":"。并扩大3倍来进行现在的改进比例，防止和原本的差距过大产生奇怪的问题。"}]}]},{"ID":"20260205093254-1d3x5xr","Type":"NodeParagraph","Properties":{"id":"20260205093254-1d3x5xr","updated":"20260205093254"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"改进二："},{"Type":"NodeText","Data":"修改原本ResNet的初始主干结构，原本的进入网络前的结构为一层"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"7 \\times 7"},{"Type":"NodeText","Data":"的卷积加上一个最大池化层来实现模型的下采样操作，现在改成了单个"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"4 \\times 4"},{"Type":"NodeText","Data":"的卷积并且步长为"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"4"},{"Type":"NodeText","Data":"的卷积运算直接进行下采样"}]},{"ID":"20260205093254-z4df3fv","Type":"NodeBlockquote","Properties":{"id":"20260205093254-z4df3fv","updated":"20260205093254"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260205093254-ar0qzko","Type":"NodeParagraph","Properties":{"id":"20260205093254-ar0qzko","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"这个没有什么好说的，他这个就是模拟原本的"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"TransFormer"},{"Type":"NodeText","Data":"的一些思路进行的"}]}]},{"ID":"20260205093254-4s0hmjb","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260205093254-4s0hmjb","updated":"20260205093254"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"2.2  ResNeXt-tify的改进"}]},{"ID":"20260205093254-quml9cp","Type":"NodeParagraph","Properties":{"id":"20260205093254-quml9cp","updated":"20260205093254"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"改进三："},{"Type":"NodeText","Data":"在深度卷积部分，不再使用原本的基本卷积操作，而是采用一种计算量更加低的深度可分离卷积来进行。"}]},{"ID":"20260205093254-nbe70r5","Type":"NodeBlockquote","Properties":{"id":"20260205093254-nbe70r5","updated":"20260205093254"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260205093254-v243ylw","Type":"NodeParagraph","Properties":{"id":"20260205093254-v243ylw","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"深度可分离卷积是"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"MobileNet-V1"},{"Type":"NodeText","Data":"中提出的一种卷积方式，它大大降低了普通卷积操作的运算量，但随之而来的确实精度的降低，不过计算量的下降实在是太多了，因此可以用它，并提高宽度，来拉高精度的同时降低计算成本。"}]}]},{"ID":"20260205093254-8xdtz5d","Type":"NodeParagraph","Properties":{"id":"20260205093254-8xdtz5d","updated":"20260205093254"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"改进四："},{"Type":"NodeText","Data":"使用深度可分离卷积的情况下提高模型的整体宽度。"}]},{"ID":"20260205093254-uf8u6nz","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260205093254-uf8u6nz","updated":"20260205093254"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"2.3 卷积核的改进策略"}]},{"ID":"20260205093254-5wkq2j4","Type":"NodeParagraph","Properties":{"id":"20260205093254-5wkq2j4","updated":"20260205093254"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"改进五："},{"Type":"NodeText","Data":"将原本所谓的瓶颈结构，变成了倒瓶颈结构，也可以称之为倒残差结构。从原本的吸纳进行"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"1\\times 1"},{"Type":"NodeText","Data":"降低维度后升高维度的操作，变成了现在的先进行"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"1\\times 1"},{"Type":"NodeText","Data":"升高维度后降低维度的操作。"}]},{"ID":"20260205093254-hkci7gq","Type":"NodeBlockquote","Properties":{"id":"20260205093254-hkci7gq","updated":"20260205093254"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260205093254-0zmedvg","Type":"NodeParagraph","Properties":{"id":"20260205093254-0zmedvg","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"这个操作是借鉴了"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"MobileNet-V2"},{"Type":"NodeText","Data":"里面的到残差结构的思想"}]}]},{"ID":"20260205093254-fi59zmo","Type":"NodeParagraph","Properties":{"id":"20260205093254-fi59zmo","updated":"20260205093254"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"改进六："},{"Type":"NodeText","Data":"上拉原本的深度卷积核，从"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"1\\times 1"},{"Type":"NodeText","Data":"卷积之后，放到了"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"1\\times 1"},{"Type":"NodeText","Data":"卷积之前。"}]},{"ID":"20260205093254-64cz3es","Type":"NodeBlockquote","Properties":{"id":"20260205093254-64cz3es","updated":"20260205093254"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260205093254-cwt3tun","Type":"NodeParagraph","Properties":{"id":"20260205093254-cwt3tun","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"这个操作就是借鉴了"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"TransFormer"},{"Type":"NodeText","Data":"中的多头注意力位于"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"FeedForwad"},{"Type":"NodeText","Data":"也就是全连接网络前的这种思想"}]}]},{"ID":"20260205093254-vpd0aok","Type":"NodeParagraph","Properties":{"id":"20260205093254-vpd0aok","updated":"20260205093254"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"改进七："},{"Type":"NodeText","Data":"使用"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"7\\times 7"},{"Type":"NodeText","Data":"的大卷积核来替换掉原本深度卷积的"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"3\\times 3"},{"Type":"NodeText","Data":"的小卷积核。"}]},{"ID":"20260205093254-0xt9sz5","Type":"NodeBlockquote","Properties":{"id":"20260205093254-0xt9sz5","updated":"20260205093254"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260205093254-7feejwc","Type":"NodeParagraph","Properties":{"id":"20260205093254-7feejwc","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"这个操作是借鉴了"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"TransFormer"},{"Type":"NodeText","Data":"的注意力是全局注意力而非局部注意力的一种思想，试试看拉大卷积核的作用大不大。"}]}]},{"ID":"20260205093254-of4eurp","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260205093254-of4eurp","updated":"20260205093254"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"2.4 微观层面上的改进"}]},{"ID":"20260205093254-0df1qmv","Type":"NodeParagraph","Properties":{"id":"20260205093254-0df1qmv","updated":"20260205093254"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"改进八："},{"Type":"NodeText","Data":"使用"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"GELU"},{"Type":"NodeText","Data":"激活函数来替换掉原本的"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"ReLU"},{"Type":"NodeText","Data":"激活函数。"}]},{"ID":"20260205093254-a8dvphr","Type":"NodeBlockquote","Properties":{"id":"20260205093254-a8dvphr","updated":"20260205093254"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260205093254-guwnpno","Type":"NodeParagraph","Properties":{"id":"20260205093254-guwnpno","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"没啥好说的应该就是试试看看效果如何，效果好就用上了。"}]}]},{"ID":"20260205093254-zmh0r1v","Type":"NodeParagraph","Properties":{"id":"20260205093254-zmh0r1v","updated":"20260205093254"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"改进九："},{"Type":"NodeText","Data":"减少激活函数以及归一化层的使用，同时使用单独的下采样层。"}]},{"ID":"20260205093254-tz1wqog","Type":"NodeParagraph","Properties":{"id":"20260205093254-tz1wqog","updated":"20260205093254"},"Children":[{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"改进十："},{"Type":"NodeText","Data":"将原本的批量归一化"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"BN"},{"Type":"NodeText","Data":"变成了现在的层归一化"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"LN"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260205093254-g3v3kan","Type":"NodeBlockquote","Properties":{"id":"20260205093254-g3v3kan","updated":"20260205093254"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260205093254-dwvv0wf","Type":"NodeParagraph","Properties":{"id":"20260205093254-dwvv0wf","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"这一块的具体改进论文中的附图非常好的显示出来了。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260127094549313"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"assets/image-20260127094549313.png"},{"Type":"NodeCloseParen","Data":")"}]}]}]},{"ID":"20260205093254-cmhb8pj","Type":"NodeParagraph","Properties":{"id":"20260205093254-cmhb8pj","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"经过这一系列的改进，原本的"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"ResNet"},{"Type":"NodeText","Data":"就焕然一新，重新成为现在的"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"ConvNeXt"},{"Type":"NodeText","Data":"了，他的精度甚至打败了当时最强的网络架构"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Swin-T"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260205093254-vlnbn66","Type":"NodeBlockquote","Properties":{"id":"20260205093254-vlnbn66","updated":"20260205093254"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260205093254-1acdjyx","Type":"NodeParagraph","Properties":{"id":"20260205093254-1acdjyx","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"从这里就可以看出来，大家只是站在巨人的肩膀上看世界，将前人厉害的思想，强大的智慧放在哪怕很多年前的事情上，也会有很多很好的效果。这个作者一定是时常积累的人。"}]},{"ID":"20260205093254-vvbky4e","Type":"NodeParagraph","Properties":{"id":"20260205093254-vvbky4e","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"哪有什么一蹴而就，不过是努力之后的水到渠成。"}]}]},{"ID":"20260205093254-iftywb7","Type":"NodeThematicBreak","Properties":{"id":"20260205093254-iftywb7","updated":"20260205093254"}},{"ID":"20260205093254-qm4udje","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260205093254-qm4udje","updated":"20260205093254"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"3 模型代码实现"}]},{"ID":"20260205093254-zs7fa53","Type":"NodeParagraph","Properties":{"id":"20260205093254-zs7fa53","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"这里我认为，代码的实现是一个非常好的复现工程，这个网络集合了前人的几乎所有智慧。"}]},{"ID":"20260205093254-2knlqw4","Type":"NodeParagraph","Properties":{"id":"20260205093254-2knlqw4","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"下面的表格中就是整体的模型框架图"}]},{"ID":"20260205093254-0gqw7or","Type":"NodeParagraph","Properties":{"id":"20260205093254-0gqw7or","updated":"20260205093254"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260127094815882"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"assets/image-20260127094815882.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260205093254-9ydwrnv","Type":"NodeParagraph","Properties":{"id":"20260205093254-9ydwrnv","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"首先就是导入具体的一些库，这里主要还是使用"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Pytorch"},{"Type":"NodeText","Data":"模块的。"}]},{"ID":"20260205093254-vlipek0","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"cHl0aG9u","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260205093254-vlipek0","updated":"20260205093254"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"cHl0aG9u"},{"Type":"NodeCodeBlockCode","Data":"import torch \nimport torch.nn as nn\nimport torch.nn.functional as F\nimport torch.optim as optim\nfrom torchvision import datasets, transforms\nfrom torch.utils.data import DataLoader\nimport time\nimport math\nimport copy\nimport matplotlib.pyplot as plt\nimport numpy as np\nimport os \nfrom tqdm import tqdm\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260205093254-0mtav4y","Type":"NodeParagraph","Properties":{"id":"20260205093254-0mtav4y","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"根据文章内容，最开始就要将原本的深度卷积换成所谓的深度可分离卷积。"}]},{"ID":"20260205093254-y0pzk13","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"cHl0aG9u","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260205093254-y0pzk13","updated":"20260205093254"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"cHl0aG9u"},{"Type":"NodeCodeBlockCode","Data":"class DepthWiseConv(nn.Module):\n    def __init__(self , in_channels , kernel_size , stride = 1 , padding = 0):\n        super(DepthWiseConv , self).__init__()\n        self.depthwise_conv = nn.Conv2d(\n            in_channels = in_channels ,\n            out_channels = in_channels ,\n            kernel_size = kernel_size ,\n            stride = stride ,\n            padding = padding ,\n            groups = in_channels,\n            bias= False\n        )\n        self.pointwise_conv = nn.Conv2d(\n            in_channels = in_channels ,\n            out_channels = in_channels ,\n            kernel_size = 1 ,\n            stride = 1 ,\n            padding = 0,\n            bias = False\n        )\n    def forward(self , x):\n        out = self.depthwise_conv(x)\n        out = self.pointwise_conv(out)\n        return out\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260205093254-wejzktz","Type":"NodeParagraph","Properties":{"id":"20260205093254-wejzktz","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"其次建立单个"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"ConvNeXt"},{"Type":"NodeText","Data":"网络的基本块儿"}]},{"ID":"20260205093254-z7nxdyl","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"cHl0aG9u","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260205093254-z7nxdyl","updated":"20260205093254"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"cHl0aG9u"},{"Type":"NodeCodeBlockCode","Data":"class ConvNeXt_Block(nn.Module):\n    '''ConvNeXt的基本块'''\n    def __init__(self , in_channels , stride=1 , feature_size = 224):\n        super(ConvNeXt_Block , self).__init__()\n        expansion = 4\n        self.layer1 = DepthWiseConv(in_channels , kernel_size=7 , stride=1 , padding=3)\n        self.layer2 = nn.LayerNorm(in_channels)\n\n        self.layer3 = nn.Conv2d(in_channels , in_channels * expansion , kernel_size= 1 , padding= 0 , bias=False)\n        self.gelu = nn.GELU()\n\n        self.layer4 = nn.Conv2d(in_channels * expansion , in_channels , kernel_size=1 , padding=0 , bias = False)\n\n    def forward(self , x):\n        identity = x\n        out = self.layer1(x)\n        out = out.permute(0, 2, 3, 1)\n        out = self.layer2(out)\n        out = out.permute(0, 3, 1, 2)\n        out = self.layer3(out)\n        out = self.gelu(out)\n        out = self.layer4(out)\n        out = out + x\n        return out\nx = torch.randn(4 , 3 , 224 , 224)\nmodels = ConvNeXt_Block(3 , stride=1 , feature_size=224)\nout = models(x)\nout.size()\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260205093254-lld5q2l","Type":"NodeParagraph","Properties":{"id":"20260205093254-lld5q2l","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"然后定义单独的下采样层，方式通道数不对。"}]},{"ID":"20260205093254-m2tln4x","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"cHl0aG9u","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260205093254-m2tln4x","updated":"20260205093254"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"cHl0aG9u"},{"Type":"NodeCodeBlockCode","Data":"class Downsample_Layer(nn.Module):\n    def __init__(self, in_dims, out_dims):\n        super().__init__()\n        self.downsample = nn.Sequential(\n            nn.LayerNorm(in_dims), \n        )\n        self.conv = nn.Conv2d(in_dims, out_dims, kernel_size=2, stride=2)\n\n    def forward(self, x):\n        # 1. 调整维度以适配 LayerNorm: (N, C, H, W) -\u003e (N, H, W, C)\n        x = x.permute(0, 2, 3, 1)\n        x = self.downsample[0](x)\n        # 2. 转换回卷积格式: (N, H, W, C) -\u003e (N, C, H, W)\n        x = x.permute(0, 3, 1, 2)\n        # 3. 执行下采样卷积\n        x = self.conv(x)\n        return x\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260205093254-r1xtpr9","Type":"NodeParagraph","Properties":{"id":"20260205093254-r1xtpr9","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"最后就是"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"ConvNeXt"},{"Type":"NodeText","Data":"的整体网络架构实现"}]},{"ID":"20260205093254-jptkyy5","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"cHl0aG9u","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260205093254-jptkyy5","updated":"20260205093254"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"cHl0aG9u"},{"Type":"NodeCodeBlockCode","Data":"class ConvNeXt_Net(nn.Module):\n    def __init__(self , in_channels = 96 , num_classes = 1000):\n        # 第1个改进层数的比例更改3:3:9:3\n        super(ConvNeXt_Net, self).__init__()\n        # 第2个改进使用4x4卷积替换掉原来的卷积加上池化处理\n        # self.pre_downsample = nn.Conv2d(kernel_size=4 , stride = 4 , in_channels = 3 , out_channels = 96 , padding = 1)\n        # 基于CIFAR-10数据集的图片大小32x32，所以这里改成2x2卷积替换掉原来的卷积加上池化处理\n        self.pre_downsample = nn.Conv2d(kernel_size=2 , stride = 2 , in_channels = 3 , out_channels = 96 , padding = 0)\n        self.layer1 = nn.Sequential(\n            ConvNeXt_Block(in_channels , stride = 1 , feature_size = 224),\n            ConvNeXt_Block(in_channels , stride = 1 , feature_size = 224),\n            ConvNeXt_Block(in_channels , stride = 1 , feature_size = 224)\n        )\n        self.downsample1 = Downsample_Layer(in_dims=in_channels, out_dims=in_channels * 2)\n        self.layer2 = nn.Sequential(\n            ConvNeXt_Block(in_channels * 2 , stride = 1 , feature_size = 112),\n            ConvNeXt_Block(in_channels * 2 , stride = 1 , feature_size = 112),\n            ConvNeXt_Block(in_channels * 2 , stride = 1 , feature_size = 112)\n        )\n        self.downsample2 = Downsample_Layer(in_dims=in_channels * 2, out_dims=in_channels * 4)\n        self.layer3 = nn.Sequential(\n            ConvNeXt_Block(in_channels * 4 , stride = 1 , feature_size = 56),\n            ConvNeXt_Block(in_channels * 4 , stride = 1 , feature_size = 56),\n            ConvNeXt_Block(in_channels * 4 , stride = 1 , feature_size = 56),\n            ConvNeXt_Block(in_channels * 4 , stride = 1 , feature_size = 56),\n            ConvNeXt_Block(in_channels * 4 , stride = 1 , feature_size = 56),\n            ConvNeXt_Block(in_channels * 4 , stride = 1 , feature_size = 56),\n            ConvNeXt_Block(in_channels * 4 , stride = 1 , feature_size = 56),\n            ConvNeXt_Block(in_channels * 4 , stride = 1 , feature_size = 56),\n            ConvNeXt_Block(in_channels * 4 , stride = 1 , feature_size = 56)\n        )\n        self.downsample3 = Downsample_Layer(in_dims=in_channels * 4, out_dims=in_channels * 8)\n        self.layer4 = nn.Sequential(\n            ConvNeXt_Block(in_channels * 8 , stride = 1 , feature_size = 28),\n            ConvNeXt_Block(in_channels * 8 , stride = 1 , feature_size = 28),\n            ConvNeXt_Block(in_channels * 8 , stride = 1 , feature_size = 28)\n        )\n\n        self.layer5 = nn.Sequential(\n            nn.AdaptiveAvgPool2d((1, 1)),\n            nn.Flatten(),\n            nn.Linear(in_channels * 8, num_classes)\n        )\n    def forward(self , x):\n        out = self.pre_downsample(x)\n        out = self.layer1(out)\n        out = self.downsample1(out)\n        out = self.layer2(out)\n        out = self.downsample2(out)\n        out = self.layer3(out)\n        out = self.downsample3(out)\n        out = self.layer4(out)\n        out = self.layer5(out)\n        return out \n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]}]}