ing":3,"Marker":"My4=","Num":3},"Properties":{"id":"20260205093254-75bnb6c","updated":"20260205093254"},"Children":[{"ID":"20260205093254-o0qux6q","Type":"NodeParagraph","Properties":{"id":"20260205093254-o0qux6q","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"经过"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"sigmoid"},{"Type":"NodeText","Data":"函数归一化后和原始输入相乘。"}]}]}]},{"ID":"20260205093254-luwibbz","Type":"NodeParagraph","Properties":{"id":"20260205093254-luwibbz","updated":"20260205093254"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260114205225033"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"https://img2024.cnblogs.com/blog/3693258/202601/3693258-20260114205233458-910657922.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260205093254-shr6ebr","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260205093254-shr6ebr","updated":"20260205093254"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"2.2.空间注意力"}]},{"ID":"20260205093254-iwsdiu3","Type":"NodeParagraph","Properties":{"id":"20260205093254-iwsdiu3","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"解决了看什么，接下来要推导解决看哪里的空间注意力。"}]},{"ID":"20260205093254-x1dxy61","Type":"NodeParagraph","Properties":{"id":"20260205093254-x1dxy61","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"这时候输入的是"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"已经经过通道注意力加权后的特征图"},{"Type":"NodeText","Data":" "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"F'"},{"Type":"NodeText","Data":"。"}]},{"ID":"20260205093254-6nbhu1w","Type":"NodeMathBlock","Properties":{"id":"20260205093254-6nbhu1w","updated":"20260205093254"},"Children":[{"Type":"NodeMathBlockOpenMarker"},{"Type":"NodeMathBlockContent","Data":"F_s = M_s(F')=\\sigma(f^{7\\times 7}([AvgPool(F),MaxPool(F)]))=\\sigma(f^{7\\times 7}([F^{S}_{avg},F^{S}_{max}]))"},{"Type":"NodeMathBlockCloseMarker"}]},{"ID":"20260205093254-vkledbf","Type":"NodeParagraph","Properties":{"id":"20260205093254-vkledbf","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"具体步骤："}]},{"ID":"20260205093254-5g6vk54","Type":"NodeList","ListData":{"Typ":1,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260205093254-5g6vk54","updated":"20260205093254"},"Children":[{"ID":"20260205093254-dsnvpfm","Type":"NodeListItem","Data":"1.","ListData":{"Typ":1,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260205093254-dsnvpfm","updated":"20260205093254"},"Children":[{"ID":"20260205093254-ebjjln7","Type":"NodeParagraph","Properties":{"id":"20260205093254-ebjjln7","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"压缩通道：这次我们要把通道维数压缩，所以在通道维度上分别做平均池化和最大池化。"}]},{"ID":"20260205093254-q797ibi","Type":"NodeList","ListData":{"BulletChar":45,"Padding":2,"MarkerOffset":1,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260205093254-q797ibi","updated":"20260205093254"},"Children":[{"ID":"20260205093254-6vf514c","Type":"NodeListItem","Data":"-","ListData":{"BulletChar":45,"Padding":2,"MarkerOffset":1,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260205093254-6vf514c","updated":"20260205093254"},"Children":[{"ID":"20260205093254-2gf7lej","Type":"NodeParagraph","Properties":{"id":"20260205093254-2gf7lej","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"这就好比把厚厚的一叠相册(多个通道)压扁，看透视图。"}]}]},{"ID":"20260205093254-2w13dx2","Type":"NodeListItem","Data":"-","ListData":{"Tight":true,"BulletChar":45,"Padding":2,"MarkerOffset":1,"Marker":"LQ==","Num":-1},"Properties":{"id":"20260205093254-2w13dx2","updated":"20260205093254"},"Children":[{"ID":"20260205093254-7ypvl61","Type":"NodeParagraph","Properties":{"id":"20260205093254-7ypvl61","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"这就得到了两个二维的特征图："},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"F_{avg}^s"},{"Type":"NodeText","Data":" 和 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"F_{max}^s"},{"Type":"NodeText","Data":"(大小都是 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"1 \\times H \\times W"},{"Type":"NodeText","Data":")。"}]}]}]}]},{"ID":"20260205093254-4hi5kn9","Type":"NodeListItem","Data":"2.","ListData":{"Typ":1,"Tight":true,"Start":2,"Delimiter":46,"Padding":3,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260205093254-4hi5kn9","updated":"20260205093254"},"Children":[{"ID":"20260205093254-mgbn7a3","Type":"NodeParagraph","Properties":{"id":"20260205093254-mgbn7a3","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"通道拼接"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"concat"},{"Type":"NodeText","Data":"。"}]}]},{"ID":"20260205093254-2tsoe7m","Type":"NodeListItem","Data":"3.","ListData":{"Typ":1,"Tight":true,"Start":3,"Delimiter":46,"Padding":3,"Marker":"My4=","Num":3},"Properties":{"id":"20260205093254-2tsoe7m","updated":"20260205093254"},"Children":[{"ID":"20260205093254-xadhhv8","Type":"NodeParagraph","Properties":{"id":"20260205093254-xadhhv8","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"卷积提取： 使用一个 "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"7 \\times 7"},{"Type":"NodeText","Data":" 的卷积核对拼接后的图进行卷积操作。"}]}]},{"ID":"20260205093254-q4mcanl","Type":"NodeListItem","Data":"4.","ListData":{"Typ":1,"Tight":true,"Start":4,"Delimiter":46,"Padding":3,"Marker":"NC4=","Num":4},"Properties":{"id":"20260205093254-q4mcanl","updated":"20260205093254"},"Children":[{"ID":"20260205093254-19pe3f8","Type":"NodeParagraph","Properties":{"id":"20260205093254-19pe3f8","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"经过"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"sigmoid"},{"Type":"NodeText","Data":"函数归一化后和原始输入相乘。"}]}]}]},{"ID":"20260205093254-k9jitbe","Type":"NodeParagraph","Properties":{"id":"20260205093254-k9jitbe","updated":"20260205093254"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"image-20260114210309726"},{"Type":"NodeCloseBracket","Data":"]"},{"Type":"NodeOpenParen","Data":"("},{"Type":"NodeLinkDest","Data":"https://img2024.cnblogs.com/blog/3693258/202601/3693258-20260114210317343-1642602464.png"},{"Type":"NodeCloseParen","Data":")"}]}]},{"ID":"20260205093254-8534746","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260205093254-8534746","updated":"20260205093254"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"2.3.一些小问题"}]},{"ID":"20260205093254-d03zyeo","Type":"NodeParagraph","Properties":{"id":"20260205093254-d03zyeo","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"为什么通道注意力是使用直接相加的方式进行特征融合而空间注意力却是使用"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"concat"},{"Type":"NodeText","Data":"叠加的方式进行特征融合?"}]},{"ID":"20260205093254-d7dxprz","Type":"NodeThematicBreak","Properties":{"id":"20260205093254-d7dxprz","updated":"20260205093254"}},{"ID":"20260205093254-vos936k","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260205093254-vos936k","updated":"20260205093254"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"3.CBAM结构框图和代码展示"}]},{"ID":"20260205093254-acnhzw5","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260205093254-acnhzw5","updated":"20260205093254"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"3.1.结构框图"}]},{"ID":"20260205093254-gapz3x2","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bWVybWFpZA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260205093254-gapz3x2","updated":"20260205093254"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bWVybWFpZA=="},{"Type":"NodeCodeBlockCode","Data":"graph TB\n    %% 定义整体方向为从上到下\n    Input(\"输入特征图 F\u003cbr\u003e(H x W x C)\") --\u003e Channel_Attn_Block\n\n    subgraph Channel_Attn_Block [\"通道注意力模块 (关注 What)\"]\n        direction TB\n        %% 这里的逻辑流\n        CAB_In(输入 F) --\u003e GAP(全局平均池化)\n        CAB_In --\u003e GMP(全局最大池化)\n        \n        GAP --\u003e MLP_A[共享 MLP]\n        GMP --\u003e MLP_B[共享 MLP]\n        \n        MLP_A --\u003e Sum_C((相加 +))\n        MLP_B --\u003e Sum_C\n        \n        Sum_C --\u003e Sig_C[Sigmoid 激活]\n        Sig_C --\u003e Mc(通道权重 Mc)\n        \n        CAB_In --\u003e Mul_C((乘 x))\n        Mc --\u003e Mul_C\n        Mul_C --\u003e F_prime(\"通道细化特征 F'\")\n    end\n\n    F_prime --\u003e Spatial_Attn_Block\n\n    subgraph Spatial_Attn_Block [\"空间注意力模块 (关注 Where)\"]\n        direction TB\n        SAB_In(输入 F') --\u003e CAP(通道平均池化)\n        SAB_In --\u003e CMP(通道最大池化)\n        \n        CAP --\u003e Concat([拼接 Concat])\n        CMP --\u003e Concat\n        \n        Concat -- \"2 x H x W\" --\u003e Conv[7x7 卷积]\n        Conv --\u003e Sig_S[Sigmoid 激活]\n        Sig_S --\u003e Ms(空间权重 Ms)\n        \n        SAB_In --\u003e Mul_S((乘 x))\n        Ms --\u003e Mul_S\n        Mul_S --\u003e F_final(\"最终特征 F''\")\n    end\n\n    F_final --\u003e Output(\"输出特征图\")\n\n    %% 样式美化\n    classDef dataNode fill:#e1f5fe,stroke:#0288d1,stroke-width:2px;\n    classDef weightNode fill:#fff9c4,stroke:#fbc02d,stroke-width:2px;\n    classDef processNode fill:#fff,stroke:#333,stroke-width:1px;\n\n    class Input,Output,F_prime,F_final dataNode;\n    class Mc,Ms weightNode;\n    class GAP,GMP,MLP_A,MLP_B,Sum_C,Sig_C,Mul_C,CAP,CMP,Concat,Conv,Sig_S,Mul_S processNode;\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260205093254-edfsetv","Type":"NodeHeading","HeadingLevel":3,"Properties":{"id":"20260205093254-edfsetv","updated":"20260205093254"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"### "},{"Type":"NodeText","Data":"3.2.代码展示"}]},{"ID":"20260205093254-9a6prtv","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"cHl0aG9u","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260205093254-9a6prtv","updated":"20260205093254"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"cHl0aG9u"},{"Type":"NodeCodeBlockCode","Data":"import torch \nimport torch.nn as nn\nimport matplotlib.pyplot as plt\nimport torch.nn.functional as F\nimport torch.optim as optim\nfrom torchvision import datasets, transforms\nfrom torch.utils.data import DataLoader\nimport numpy as np\n\nclass CBAMBlock(nn.Module):\n    '''CBAM注意力机制模块\n        包含通道注意力机制模块以及空间注意力机制模块\n        Args:\n            outchannels: 输入特征图的通道数\n            reduction: 通道注意力机制模块中全连接层的缩减比例\n    '''\n    def __init__(self , outchannels , reduction = 4):\n        super(CBAMBlock , self).__init__()\n        # 通道注意力机制模块 channel attention module\n        self.maxpool = nn.AdaptiveMaxPool2d(1)\n        self.avgpool = nn.AdaptiveAvgPool2d(1)\n        self.fc1 = nn.Linear(outchannels , outchannels // reduction , bias = False)\n        self.relu = nn.ReLU()\n        self.fc2 = nn.Linear(outchannels // reduction , outchannels , bias = False)\n        self.sigmoid = nn.Sigmoid()\n\n        # 空间注意力机制模块 spatial attention module\n        self.conv = nn.Conv2d(in_channels=2 , out_channels = 1 , kernel_size = 7 , stride = 1 , padding = 3 , bias = False)\n\n    def forward(self , x):\n        '''\n            前向传播函数\n            1. 通道注意力机制模块\n                a. 分别进行最大池化以及平均池化\n                b. 通过全连接层进行特征提取(分别)\n                c. 将两个特征直接相加，然后sigmoid归一化\n            2. 空间注意力机制模块\n                a. 对通道注意力机制模块的输出进行最大池化以及平均池化\n                b. 将两个池化结果在通道维度上进行拼接\n                c. 通过卷积层进行特征提取，然后sigmoid归一化\n        '''\n        # 通道注意力机制模块\n        maxpool_out = self.maxpool(x)\n        avgpool_out = self.avgpool(x)\n\n        maxpool_out = maxpool_out.view(-1 , x.size(1)) \n        avgpool_out = avgpool_out.view(-1 , x.size(1))\n\n        F_max = self.fc2(self.relu(self.fc1(maxpool_out)))       \n        F_avg = self.fc2(self.relu(self.fc1(avgpool_out)))\n\n        channel_attention_out = self.sigmoid(F_max+F_avg).unsqueeze(2).unsqueeze(3)  # [B , C , 1 , 1] , add操作\n        F_1 = channel_attention_out * x\n\n        # 空间注意力机制模块\n        spatial_maxpool , _ = torch.max(F_1 , dim=1 , keepdim = True)                       # [B , 1 , H , W]\n        spatial_avgpool = torch.mean(F_1 , dim=1 , keepdim = True)                          # [B , 1 , H , W]\n        spatial_attention_out = torch.cat([spatial_maxpool , spatial_avgpool] , dim = 1)    # [B , 2 , H , W] , concat操作\n        spatial_attention_out = self.sigmoid(self.conv(spatial_attention_out))              # [B , 1 , H , W]\n        F_2 = spatial_attention_out * F_1\n\n        return F_2\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]},{"ID":"20260205093254-b4zynh9","Type":"NodeCodeBlock","IsFencedCodeBlock":true,"CodeBlockFenceChar":96,"CodeBlockFenceLen":3,"CodeBlockOpenFence":"YGBg","CodeBlockInfo":"bWVybWFpZA==","CodeBlockCloseFence":"YGBg","Properties":{"id":"20260205093254-b4zynh9","updated":"20260205093254"},"Children":[{"Type":"NodeCodeBlockFenceOpenMarker","Data":"```","CodeBlockFenceLen":3},{"Type":"NodeCodeBlockFenceInfoMarker","CodeBlockInfo":"bWVybWFpZA=="},{"Type":"NodeCodeBlockCode","Data":"graph LR\n    %% 定义整体为水平布局\n    direction LR\n\n    %% 输入\n    F_prime[\"Channel-refined\u003cbr\u003eFeature F'\u003cbr\u003e(H x W x C)\"]\n\n    %% 空间池化\n    subgraph ChannelPooling [\"Channel-wise Pooling\"]\n        direction TB\n        MaxPool_S[\"MaxPool\"]\n        AvgPool_S[\"AvgPool\"]\n    end\n\n    %% 拼接与卷积\n    Concat[\"Concatenate\"]\n    Conv[\"Conv Layer\u003cbr\u003e(7x7)\"]\n    Sigmoid_S((\"Sigmoid\u003cbr\u003eσ\"))\n\n    %% 输出\n    Ms[\"Spatial Attention Ms\u003cbr\u003e(H x W x 1)\"]\n\n    %% 连线关系\n    F_prime --\u003e MaxPool_S\n    F_prime --\u003e AvgPool_S\n\n    MaxPool_S -- \"HxWx1\" --\u003e Concat\n    AvgPool_S -- \"HxWx1\" --\u003e Concat\n\n    Concat -- \"HxWx2\" --\u003e Conv\n    Conv --\u003e Sigmoid_S\n    Sigmoid_S --\u003e Ms\n\n    %% 样式美化\n    style F_prime fill:#e3f2fd,stroke:#1565c0,stroke-width:2px\n    style MaxPool_S fill:#90caf9,stroke:#0d47a1\n    style AvgPool_S fill:#ffcc80,stroke:#e65100\n    style Concat fill:#eeeeee,stroke:#616161\n    style Conv fill:#f5f5f5,stroke:#424242\n    style Sigmoid_S fill:#ffffff,stroke:#000000,stroke-width:2px\n    style Ms fill:#e1bee7,stroke:#7b1fa2,stroke-width:2px\n"},{"Type":"NodeCodeBlockFenceCloseMarker","Data":"```","CodeBlockFenceLen":3}]}]}