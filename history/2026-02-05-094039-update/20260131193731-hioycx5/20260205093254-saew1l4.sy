{"ID":"20260205093254-saew1l4","Spec":"2","Type":"NodeDocument","Properties":{"id":"20260205093254-saew1l4","title":"2_CBAM","type":"doc","updated":"20260205093254"},"Children":[{"ID":"20260205093254-xhb6glw","Type":"NodeHeading","HeadingLevel":1,"Properties":{"id":"20260205093254-xhb6glw","updated":"20260205093254"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"# "},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"CBAM(Convolutional Block Attention Module)"}]},{"ID":"20260205093254-gqex4da","Type":"NodeBlockquote","Properties":{"id":"20260205093254-gqex4da","updated":"20260205093254"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260205093254-12geztr","Type":"NodeParagraph","Properties":{"id":"20260205093254-12geztr","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"[!NOTE]"}]},{"ID":"20260205093254-ua0382e","Type":"NodeParagraph","Properties":{"id":"20260205093254-ua0382e","updated":"20260205093254"},"Children":[{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"CBAM"},{"Type":"NodeText","Data":"注意力机制模块他本来的名字是卷积注意力机制模块"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"-Convolutional Block Attention Module"},{"Type":"NodeText","Data":"，该注意力机制是"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Sanghyun Woo"},{"Type":"NodeText","Data":"等人在"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"2018"},{"Type":"NodeText","Data":"年在论文"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"CBAM: Convolutional Block Attention Module"},{"Type":"NodeText","Data":"提出来的。"}]},{"ID":"20260205093254-xq1qawa","Type":"NodeParagraph","Properties":{"id":"20260205093254-xq1qawa","updated":"20260205093254"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://arxiv.org/abs/1807.06521","TextMarkTextContent":"CBAM论文地址"}]}]},{"ID":"20260205093254-9zuzygx","Type":"NodeParagraph","Properties":{"id":"20260205093254-9zuzygx","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"现在就对该算法进行一些解读和自己的理解，我将从原理，公式推导，以及代码结构进行阐述。"}]},{"ID":"20260205093254-dka89vu","Type":"NodeHeading","HeadingLevel":2,"Properties":{"id":"20260205093254-dka89vu","updated":"20260205093254"},"Children":[{"Type":"NodeHeadingC8hMarker","Data":"## "},{"Type":"NodeText","Data":"1. 背景原理"}]},{"ID":"20260205093254-nq1ewvp","Type":"NodeParagraph","Properties":{"id":"20260205093254-nq1ewvp","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"在很多的图像处理相关的领域卷积神经网络发挥了极为重要的作用，卷积神经网络以其强大的表征能力，极大的提高了视觉任务的性能。那么卷积神经网络的性能主要研究的三大因素是什么呢？什么是影响卷积神经网络性能的主要因素呢？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"不难猜到就是下面三个："}]},{"ID":"20260205093254-pbnuxes","Type":"NodeList","ListData":{"Typ":1,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260205093254-pbnuxes","updated":"20260205093254"},"Children":[{"ID":"20260205093254-vdzofvc","Type":"NodeListItem","Data":"1.","ListData":{"Typ":1,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260205093254-vdzofvc","updated":"20260205093254"},"Children":[{"ID":"20260205093254-clmjdee","Type":"NodeParagraph","Properties":{"id":"20260205093254-clmjdee","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"深度"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"(depth)"},{"Type":"NodeText","Data":"：卷积神经网络"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"串联的总体层数"},{"Type":"NodeText","Data":"。"}]}]},{"ID":"20260205093254-igobqah","Type":"NodeListItem","Data":"2.","ListData":{"Typ":1,"Tight":true,"Start":2,"Delimiter":46,"Padding":3,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260205093254-igobqah","updated":"20260205093254"},"Children":[{"ID":"20260205093254-44yy9jc","Type":"NodeParagraph","Properties":{"id":"20260205093254-44yy9jc","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"宽度"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"(width)"},{"Type":"NodeText","Data":"：卷积神经网络的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"通道个数"},{"Type":"NodeText","Data":"。"}]}]},{"ID":"20260205093254-r259zta","Type":"NodeListItem","Data":"3.","ListData":{"Typ":1,"Tight":true,"Start":3,"Delimiter":46,"Padding":3,"Marker":"My4=","Num":3},"Properties":{"id":"20260205093254-r259zta","updated":"20260205093254"},"Children":[{"ID":"20260205093254-nzwtti7","Type":"NodeParagraph","Properties":{"id":"20260205093254-nzwtti7","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"基数"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"(cardinality)"},{"Type":"NodeText","Data":"：卷积神经网络的"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"分支个数"},{"Type":"NodeText","Data":"。"}]}]}]},{"ID":"20260205093254-tyksbwz","Type":"NodeParagraph","Properties":{"id":"20260205093254-tyksbwz","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"对于深度这个方面，在之前"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"2016"},{"Type":"NodeText","Data":"年由何凯明大神提出的"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"ResNet"},{"Type":"NodeText","Data":"残差连接就已经实现了非常深的网络进行训练；"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对于宽度这个方面，在之前"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"2015"},{"Type":"NodeText","Data":"年由"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"google"},{"Type":"NodeText","Data":"公司提出的"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"GoogleNet"},{"Type":"NodeText","Data":"网络也已经实现。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"对于基数这个方面，有更多的人都在进行努力。"}]},{"ID":"20260205093254-b2zgkd1","Type":"NodeParagraph","Properties":{"id":"20260205093254-b2zgkd1","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"但是除了这上面的几个因素之外，还引入了一个注意力的机制，可以让网络自动调节自己所重要的特征的权重。之前的"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"SE"},{"Type":"NodeText","Data":"注意力机制主要关注的通道这方面的问题，但是我们是不是可以将通道和空间的注意力机制相互融合以实现一种新的注意力机制模块呢？"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"那么"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"CBAM"},{"Type":"NodeText","Data":"模块油然而生。"}]},{"ID":"20260205093254-t34fkdz","Type":"NodeBlockquote","Properties":{"id":"20260205093254-t34fkdz","updated":"20260205093254"},"Children":[{"Type":"NodeBlockquoteMarker","Data":"\u003e "},{"ID":"20260205093254-zpwolgg","Type":"NodeParagraph","Properties":{"id":"20260205093254-zpwolgg","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"这里就简单的讲一下什么是通道注意力，什么是空间注意力机制吧！"}]},{"ID":"20260205093254-8r5asg8","Type":"NodeParagraph","Properties":{"id":"20260205093254-8r5asg8","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"大家都知道在深度学习网络过程中，每个过程的图像批量实际上是四个维度的东西，分别是"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"(B-Batch，C-channel，H-hight，W-width)"},{"Type":"NodeText","Data":"，这四个维度就是每一次输入输出的玩意儿。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"用大白话来说就是，一箱相册，一个箱子有很多图片册，而每个图片册有很多张图片，每个图片又有长度和宽度。之前我们主要关注的是图片册中每张图片整体的感觉；但是忽略了图片中的一些细节问题。"}]},{"ID":"20260205093254-v70o7hs","Type":"NodeParagraph","Properties":{"id":"20260205093254-v70o7hs","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"通道注意力主要就是在"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"-channel"},{"Type":"NodeText","Data":"也就是"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"C"},{"Type":"NodeText","Data":"上做操作。"},{"Type":"NodeSoftBreak","Data":"\n"},{"Type":"NodeText","Data":"空间注意力主要就是在"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"-H"},{"Type":"NodeText","Data":"和"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"W"},{"Type":"NodeText","Data":"上面做操作。"}]}]},{"ID":"20260205093254-ttdgg5y","Type":"NodeList","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260205093254-ttdgg5y","updated":"20260205093254"},"Children":[{"ID":"20260205093254-yl0gsnt","Type":"NodeListItem","Data":"1.","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260205093254-yl0gsnt","updated":"20260205093254"},"Children":[{"ID":"20260205093254-uu9tr5f","Type":"NodeParagraph","Properties":{"id":"20260205093254-uu9tr5f","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"通道注意力机制：关注"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"是什么"}]}]},{"ID":"20260205093254-0dizquz","Type":"NodeListItem","Data":"2.","ListData":{"Typ":1,"Tight":true,"Start":2,"Delimiter":46,"Padding":3,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260205093254-0dizquz","updated":"20260205093254"},"Children":[{"ID":"20260205093254-0cnnvoe","Type":"NodeParagraph","Properties":{"id":"20260205093254-0cnnvoe","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"空间注意力机制：关注"},{"Type":"NodeTextMark","TextMarkType":"strong","TextMarkTextContent":"在哪里"}]}]}]},{"ID":"20260205093254-bq4nzd3","Type":"NodeParagraph","Properties":{"id":"20260205093254-bq4nzd3","updated":"20260205093254"},"Children":[{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"ok"},{"Type":"NodeText","Data":"那么到现在我们就将"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"通道"},{"Type":"NodeText","Data":"和"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"空间"},{"Type":"NodeText","Data":"两个维度进行了很好的区分，"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"CBAM"},{"Type":"NodeText","Data":"的核心思想就是将这两个维度结合起来。"}]},{"ID":"20260205093254-lczzxjo","Type":"NodeParagraph","Properties":{"id":"20260205093254-lczzxjo","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"但是"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"CBAM"},{"Type":"NodeText","Data":"并没有把它们一股脑混在一起处理，而是采用了"},{"Type":"NodeTextMark","TextMarkType":"inline-math","TextMarkInlineMathContent":"串联"},{"Type":"NodeText","Data":"的方式。"}]},{"ID":"20260205093254-sbqlh66","Type":"NodeParagraph","Properties":{"id":"20260205093254-sbqlh66","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"这就好比我们找东西的逻辑："}]},{"ID":"20260205093254-2am4dnf","Type":"NodeList","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260205093254-2am4dnf","updated":"20260205093254"},"Children":[{"ID":"20260205093254-2c854c2","Type":"NodeListItem","Data":"1.","ListData":{"Typ":1,"Tight":true,"Start":1,"Delimiter":46,"Padding":3,"Marker":"MS4=","Num":1},"Properties":{"id":"20260205093254-2c854c2","updated":"20260205093254"},"Children":[{"ID":"20260205093254-p5noovv","Type":"NodeParagraph","Properties":{"id":"20260205093254-p5noovv","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"先想找什么先过通道注意力模块"}]}]},{"ID":"20260205093254-uz1ewhr","Type":"NodeListItem","Data":"2.","ListData":{"Typ":1,"Tight":true,"Start":2,"Delimiter":46,"Padding":3,"Marker":"Mi4=","Num":2},"Properties":{"id":"20260205093254-uz1ewhr","updated":"20260205093254"},"Children":[{"ID":"20260205093254-l4x6p13","Type":"NodeParagraph","Properties":{"id":"20260205093254-l4x6p13","updated":"20260205093254"},"Children":[{"Type":"NodeText","Data":"再看在哪里再过空间注意力模块"}]}]}]},{"ID":"20260205093254-bqogx46","Type":"NodeParagraph","Properties":{"id":"20260205093254-bqogx46","updated":"20260205093254"},"Children":[{"Type":"NodeImage","Children":[{"Type":"NodeBang","Data":"!"},{"Type":"NodeOpenBracket","Data":"["},{"Type":"NodeLinkText","Data":"