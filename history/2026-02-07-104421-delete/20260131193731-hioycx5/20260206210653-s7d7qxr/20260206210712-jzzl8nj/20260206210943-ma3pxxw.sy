260206210943-940uo7t","Type":"NodeParagraph","Properties":{"id":"20260206210943-940uo7t","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"亿级月活的社交 APP，陌陌如何做到 3 分钟定位故障？"}]},{"ID":"20260206210943-42jpw5o","Type":"NodeParagraph","Properties":{"id":"20260206210943-42jpw5o","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"8558"}]},{"ID":"20260206210943-ib6rifz","Type":"NodeParagraph","Properties":{"id":"20260206210943-ib6rifz","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"60页PPT全解：DeepSeek系列论文技术要点整理"}]},{"ID":"20260206210943-myfuzkr","Type":"NodeParagraph","Properties":{"id":"20260206210943-myfuzkr","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"9955"}]},{"ID":"20260206210943-201uzsx","Type":"NodeParagraph","Properties":{"id":"20260206210943-201uzsx","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/2100133?policyId=1003","TextMarkTextContent":"【目标检测】从YOLOv1到YOLOX(理论梳理)"}]},{"ID":"20260206210943-n2cis6j","Type":"NodeParagraph","Properties":{"id":"20260206210943-n2cis6j","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10180","TextMarkTextContent":".net"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10332","TextMarkTextContent":"神经网络"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10333","TextMarkTextContent":"深度学习"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10539","TextMarkTextContent":"人工智能"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10687","TextMarkTextContent":"图像识别"}]},{"ID":"20260206210943-25gze9d","Type":"NodeParagraph","Properties":{"id":"20260206210943-25gze9d","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/2100133?policyId=1003","TextMarkTextContent":"YOLO系列应该是目标领域知名度最高的算法，其凭借出色的实时检测性能在不同的领域均有广泛应用。 目前，YOLO共有6个版本，YOLOv1-v5和YOLOX，除了YOLOv5外，其它都有相应的论文，5篇论文我已上传到资源中，可自行下载：https://www.aliyundrive.com/s/ofcnrxjzsFE 工程上使用最多的版本是YOLOv3和YOLOv5，Pytorch版本均由ultralytics公司开发，YOLOv5仍在进行维护，截至目前，已经更新到YOLOv5-6.1版本。 项目地址：https://github.com/ultralytics/yolov5 在上篇博文中，详细记录了如何用YOLOv5来跑通VOC2007数据集，本篇博文旨在对YOLO系列算法的演化进行简单梳理，更多详细的内容可以看文末的参考资料。"}]},{"ID":"20260206210943-5biciwc","Type":"NodeParagraph","Properties":{"id":"20260206210943-5biciwc","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"zstar"}]},{"ID":"20260206210943-feuezs9","Type":"NodeParagraph","Properties":{"id":"20260206210943-feuezs9","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"2022/09/08"}]},{"ID":"20260206210943-ctr8hb1","Type":"NodeParagraph","Properties":{"id":"20260206210943-ctr8hb1","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"2.8K0"}]},{"ID":"20260206210943-l316mpi","Type":"NodeParagraph","Properties":{"id":"20260206210943-l316mpi","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/2408273?policyId=1003","TextMarkTextContent":"杀疯了！YOLO再突破，提速20倍！！"}]},{"ID":"20260206210943-ajp0644","Type":"NodeParagraph","Properties":{"id":"20260206210943-ajp0644","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/17373","TextMarkTextContent":"论文"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/17381","TextMarkTextContent":"模型"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/17423","TextMarkTextContent":"设计"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/17525","TextMarkTextContent":"性能"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/17146","TextMarkTextContent":"yolo"}]},{"ID":"20260206210943-axh7rs3","Type":"NodeParagraph","Properties":{"id":"20260206210943-axh7rs3","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/2408273?policyId=1003","TextMarkTextContent":"YOLO再一次突破，新变体YOLO-World在目标检测领域的表现非常的出色。开集检测速度提升20倍！"}]},{"ID":"20260206210943-yxzkg2i","Type":"NodeParagraph","Properties":{"id":"20260206210943-yxzkg2i","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"Python编程爱好者"}]},{"ID":"20260206210943-vmq4gd6","Type":"NodeParagraph","Properties":{"id":"20260206210943-vmq4gd6","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"2024/04/12"}]},{"ID":"20260206210943-t80yadi","Type":"NodeParagraph","Properties":{"id":"20260206210943-t80yadi","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"1.5K0"}]},{"ID":"20260206210943-44fxa3q","Type":"NodeParagraph","Properties":{"id":"20260206210943-44fxa3q","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"杀疯了！YOLO再突破，提速20倍！！"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/b18e46b4b43b1510e910b718c13560cc-20260206210943-mqg10e8.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210943-6y8qzt4","Type":"NodeParagraph","Properties":{"id":"20260206210943-6y8qzt4","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/1728283?policyId=1003","TextMarkTextContent":"YOLO算法最全综述：从YOLOv1到YOLOv5"}]},{"ID":"20260206210943-4unaynn","Type":"NodeParagraph","Properties":{"id":"20260206210943-4unaynn","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10687","TextMarkTextContent":"图像识别"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10813","TextMarkTextContent":"https"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10681","TextMarkTextContent":"网络安全"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10332","TextMarkTextContent":"神经网络"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10333","TextMarkTextContent":"深度学习"}]},{"ID":"20260206210943-p4sis1a","Type":"NodeParagraph","Properties":{"id":"20260206210943-p4sis1a","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/1728283?policyId=1003","TextMarkTextContent":"来源丨https://zhuanlan.zhihu.com/p/136382095"}]},{"ID":"20260206210943-syhzcq8","Type":"NodeParagraph","Properties":{"id":"20260206210943-syhzcq8","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"Datawhale"}]},{"ID":"20260206210943-u1ighut","Type":"NodeParagraph","Properties":{"id":"20260206210943-u1ighut","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"2020/10/23"}]},{"ID":"20260206210943-b9qr0wj","Type":"NodeParagraph","Properties":{"id":"20260206210943-b9qr0wj","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"3.3K0"}]},{"ID":"20260206210943-pi2s2vz","Type":"NodeParagraph","Properties":{"id":"20260206210943-pi2s2vz","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"YOLO算法最全综述：从YOLOv1到YOLOv5"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/mal9petbg3-20260206210943-o7cvr7c.jpeg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210943-4nrswis","Type":"NodeParagraph","Properties":{"id":"20260206210943-4nrswis","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/2037102?policyId=1003","TextMarkTextContent":"深入浅出Yolo系列之Yolov3\u0026amp;Yolov4\u0026amp;Yolov5\u0026amp;Yolox核心基础知识完整讲解"}]},{"ID":"20260206210943-3nfrogt","Type":"NodeParagraph","Properties":{"id":"20260206210943-3nfrogt","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10813","TextMarkTextContent":"https"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10681","TextMarkTextContent":"网络安全"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10687","TextMarkTextContent":"图像识别"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10332","TextMarkTextContent":"神经网络"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10333","TextMarkTextContent":"深度学习"}]},{"ID":"20260206210943-7z977g2","Type":"NodeParagraph","Properties":{"id":"20260206210943-7z977g2","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/2037102?policyId=1003","TextMarkTextContent":"因为工作原因，项目中经常遇到目标检测的任务，因此对目标检测算法会经常使用和关注，比如Yolov3、Yolov4算法、Yolov5算法、Yolox算法。"}]},{"ID":"20260206210943-5iwa253","Type":"NodeParagraph","Properties":{"id":"20260206210943-5iwa253","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"全栈程序员站长"}]},{"ID":"20260206210943-b8m8u7g","Type":"NodeParagraph","Properties":{"id":"20260206210943-b8m8u7g","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"2022/07/01"}]},{"ID":"20260206210943-cv7kh7y","Type":"NodeParagraph","Properties":{"id":"20260206210943-cv7kh7y","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"9990"}]},{"ID":"20260206210943-6gn06z3","Type":"NodeParagraph","Properties":{"id":"20260206210943-6gn06z3","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"深入浅出Yolo系列之Yolov3\u0026Yolov4\u0026Yolov5\u0026Yolox核心基础知识完整讲解"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/3ae1e21601384b25426994db24903f55-20260206210943-ilolgzd.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210943-cdkjn38","Type":"NodeParagraph","Properties":{"id":"20260206210943-cdkjn38","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/2611333?policyId=1003","TextMarkTextContent":"YOLO基础原理与演进脉络：从v1到v10的技术飞跃"}]},{"ID":"20260206210943-8npa1pk","Type":"NodeParagraph","Properties":{"id":"20260206210943-8npa1pk","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/17460","TextMarkTextContent":"算法"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/17484","TextMarkTextContent":"网络"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/17566","TextMarkTextContent":"原理"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/17146","TextMarkTextContent":"yolo"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/17302","TextMarkTextContent":"基础"}]},{"ID":"20260206210943-q2za8cg","Type":"NodeParagraph","Properties":{"id":"20260206210943-q2za8cg","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/2611333?policyId=1003","TextMarkTextContent":"作者：HOS(安全风信子) 日期：2025-12-31 来源平台：GitHub 摘要： 本文全面梳理了YOLO（You Only Look Once）系列算法从v1到最新v10版本的演进脉络，深入解析了各版本的核心创新点、技术突破与性能提升。通过对比分析YOLO算法在检测精度、速度、参数量等关键指标上的变化，揭示了目标检测领域的发展趋势。文章不仅介绍了YOLO的基础原理，还深入探讨了其在架构设计、特征处理、损失函数等方面的演进，为读者提供了一个完整的YOLO知识体系框架。最后，本文展望了YOLO算法未来的发展方向，包括多模态融合、轻量化部署、特定场景优化等，为研究者和工程师提供了有价值的参考。"}]},{"ID":"20260206210943-6xesybh","Type":"NodeParagraph","Properties":{"id":"20260206210943-6xesybh","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"安全风信子"}]},{"ID":"20260206210943-ihtb0se","Type":"NodeParagraph","Properties":{"id":"20260206210943-ihtb0se","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"2026/01/01"}]},{"ID":"20260206210943-1nyf35r","Type":"NodeParagraph","Properties":{"id":"20260206210943-1nyf35r","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"1.7K0"}]},{"ID":"20260206210943-1xsfhts","Type":"NodeParagraph","Properties":{"id":"20260206210943-1xsfhts","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/1820939?policyId=1003","TextMarkTextContent":"基于深度学习的目标检测算法面试必备（RCNN~YOLOv5）"}]},{"ID":"20260206210943-tv9xrn6","Type":"NodeParagraph","Properties":{"id":"20260206210943-tv9xrn6","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10149","TextMarkTextContent":"机器学习"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10333","TextMarkTextContent":"深度学习"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10539","TextMarkTextContent":"人工智能"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10663","TextMarkTextContent":"编程算法"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10687","TextMarkTextContent":"图像识别"}]},{"ID":"20260206210943-c47n3ck","Type":"NodeParagraph","Properties":{"id":"20260206210943-c47n3ck","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/1820939?policyId=1003","TextMarkTextContent":"目标检测算法主要包括：【两阶段】目标检测算法、【多阶段】目标检测算法、【单阶段】目标检测算法"}]},{"ID":"20260206210943-7hswyr3","Type":"NodeParagraph","Properties":{"id":"20260206210943-7hswyr3","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"AI算法与图像处理"}]},{"ID":"20260206210943-gctly34","Type":"NodeParagraph","Properties":{"id":"20260206210943-gctly34","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"2021/05/07"}]},{"ID":"20260206210943-bybtxpj","Type":"NodeParagraph","Properties":{"id":"20260206210943-bybtxpj","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"4.1K0"}]},{"ID":"20260206210943-ursztxa","Type":"NodeParagraph","Properties":{"id":"20260206210943-ursztxa","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/2463012?policyId=1003","TextMarkTextContent":"YOLO 系列目标检测大合集"}]},{"ID":"20260206210943-sw8jpeq","Type":"NodeParagraph","Properties":{"id":"20260206210943-sw8jpeq","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/17525","TextMarkTextContent":"性能"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/17146","TextMarkTextContent":"yolo"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/17248","TextMarkTextContent":"对象"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/17381","TextMarkTextContent":"模型"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/17516","TextMarkTextContent":"效率"}]},{"ID":"20260206210943-6mop1ih","Type":"NodeParagraph","Properties":{"id":"20260206210943-6mop1ih","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/2463012?policyId=1003","TextMarkTextContent":"YOLO（You Only Look Once，你只看一次）是一系列开创性的实时目标检测模型，它们彻底改变了计算机视觉领域。由Joseph Redmon开发，后续版本由不同研究人员迭代，YOLO模型以其在图像中检测对象的高速度和准确性而闻名。以下是对每个YOLO版本的详细查看："}]},{"ID":"20260206210943-dhni72f","Type":"NodeParagraph","Properties":{"id":"20260206210943-dhni72f","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"小白学视觉"}]},{"ID":"20260206210943-mhqa0kt","Type":"NodeParagraph","Properties":{"id":"20260206210943-mhqa0kt","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"2024/11/01"}]},{"ID":"20260206210943-outepqj","Type":"NodeParagraph","Properties":{"id":"20260206210943-outepqj","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"1K0"}]},{"ID":"20260206210943-8udn6xi","Type":"NodeParagraph","Properties":{"id":"20260206210943-8udn6xi","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"YOLO 系列目标检测大合集"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/71ccbfa4c497f5d8e1dc45841c64f182-20260206210943-n82vkdp.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210943-b1vi7xa","Type":"NodeParagraph","Properties":{"id":"20260206210943-b1vi7xa","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/1867530?policyId=1003","TextMarkTextContent":"深入浅出Yolo系列之Yolox核心基础完整讲解"}]},{"ID":"20260206210943-a6mxggo","Type":"NodeParagraph","Properties":{"id":"20260206210943-a6mxggo","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10332","TextMarkTextContent":"神经网络"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10333","TextMarkTextContent":"深度学习"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10539","TextMarkTextContent":"人工智能"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10687","TextMarkTextContent":"图像识别"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10663","TextMarkTextContent":"编程算法"}]},{"ID":"20260206210943-3xrchuo","Type":"NodeParagraph","Properties":{"id":"20260206210943-3xrchuo","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/1867530?policyId=1003","TextMarkTextContent":"在Yolov4、Yolov5刚出来时，大白就写过关于Yolov3、Yolov4、Yolov5的文章，并且做了一些讲解的视频，反响都还不错。"}]},{"ID":"20260206210943-8lk5r83","Type":"NodeParagraph","Properties":{"id":"20260206210943-8lk5r83","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"AIWalker"}]},{"ID":"20260206210943-ftmjfhv","Type":"NodeParagraph","Properties":{"id":"20260206210943-ftmjfhv","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"2021/08/25"}]},{"ID":"20260206210943-xrxfkl8","Type":"NodeParagraph","Properties":{"id":"20260206210943-xrxfkl8","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"3.8K0"}]},{"ID":"20260206210943-ye6zb9s","Type":"NodeParagraph","Properties":{"id":"20260206210943-ye6zb9s","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"深入浅出Yolo系列之Yolox核心基础完整讲解"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/e2b81be61c3cf4fb252d1b1c2438ce8a-20260206210943-d7er6bv.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210943-s2mo6p0","Type":"NodeParagraph","Properties":{"id":"20260206210943-s2mo6p0","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/1713619?policyId=1003","TextMarkTextContent":"yolo系列检测模型回顾"}]},{"ID":"20260206210943-1sos6j4","Type":"NodeParagraph","Properties":{"id":"20260206210943-1sos6j4","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10332","TextMarkTextContent":"神经网络"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10333","TextMarkTextContent":"深度学习"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10539","TextMarkTextContent":"人工智能"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10687","TextMarkTextContent":"图像识别"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10573","TextMarkTextContent":"企业"}]},{"ID":"20260206210943-8qpxtmu","Type":"NodeParagraph","Properties":{"id":"20260206210943-8qpxtmu","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/1713619?policyId=1003","TextMarkTextContent":"前面一篇文章写了如何使用yolov3进行检测的上手文章https://cloud.tencent.com/developer/article/1703521，其中简单介绍了下yolo的历史，很不过瘾，这里开一篇，再详细介绍下，yolo系列（v1, v2 , v3）的主要技术特点。希望对大家能够有所帮助。"}]},{"ID":"20260206210943-my6wk4d","Type":"NodeParagraph","Properties":{"id":"20260206210943-my6wk4d","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"用户7680342"}]},{"ID":"20260206210943-9hr25iy","Type":"NodeParagraph","Properties":{"id":"20260206210943-9hr25iy","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"2020/10/12"}]},{"ID":"20260206210943-vt51imq","Type":"NodeParagraph","Properties":{"id":"20260206210943-vt51imq","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"8650"}]},{"ID":"20260206210943-8zphknx","Type":"NodeParagraph","Properties":{"id":"20260206210943-8zphknx","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/1626755?policyId=1003","TextMarkTextContent":"YOLO系列：V1,V2,V3,V4简介"}]},{"ID":"20260206210943-nnnexzt","Type":"NodeParagraph","Properties":{"id":"20260206210943-nnnexzt","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10687","TextMarkTextContent":"图像识别"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10813","TextMarkTextContent":"https"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10681","TextMarkTextContent":"网络安全"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10332","TextMarkTextContent":"神经网络"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10333","TextMarkTextContent":"深度学习"}]},{"ID":"20260206210943-rumyve2","Type":"NodeParagraph","Properties":{"id":"20260206210943-rumyve2","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/1626755?policyId=1003","TextMarkTextContent":"YOLO系列是基于深度学习的回归方法。 RCNN， Fast-RCNN，Faster-RCNN是基于深度学习的分类方法。"}]},{"ID":"20260206210943-gram389","Type":"NodeParagraph","Properties":{"id":"20260206210943-gram389","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"马上科普尚尚"}]},{"ID":"20260206210943-64qohjf","Type":"NodeParagraph","Properties":{"id":"20260206210943-64qohjf","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"2020/05/11"}]},{"ID":"20260206210943-4fw311b","Type":"NodeParagraph","Properties":{"id":"20260206210943-4fw311b","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"3K0"}]},{"ID":"20260206210943-rx86n5d","Type":"NodeParagraph","Properties":{"id":"20260206210943-rx86n5d","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/1538848?policyId=1003","TextMarkTextContent":"YOLO 目标检测实战项目『原理篇』"}]},{"ID":"20260206210943-cubvi6b","Type":"NodeParagraph","Properties":{"id":"20260206210943-cubvi6b","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10813","TextMarkTextContent":"https"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10687","TextMarkTextContent":"图像识别"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10332","TextMarkTextContent":"神经网络"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10333","TextMarkTextContent":"深度学习"}]},{"ID":"20260206210943-epibigh","Type":"NodeParagraph","Properties":{"id":"20260206210943-epibigh","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/1538848?policyId=1003","TextMarkTextContent":"在目标检测中，IoU 为预测框 (Prediction) 和真实框 (Ground truth) 的交并比。如下图所示，在关于小猫的目标检测中，紫线边框为预测框 (Prediction)，红线边框为真实框 (Ground truth)。"}]},{"ID":"20260206210943-dcg618t","Type":"NodeParagraph","Properties":{"id":"20260206210943-dcg618t","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"机器视觉CV"}]},{"ID":"20260206210943-tqaohe2","Type":"NodeParagraph","Properties":{"id":"20260206210943-tqaohe2","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"2019/11/14"}]},{"ID":"20260206210943-rm1ojwv","Type":"NodeParagraph","Properties":{"id":"20260206210943-rm1ojwv","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"8.3K1"}]},{"ID":"20260206210943-u3nhvx8","Type":"NodeParagraph","Properties":{"id":"20260206210943-u3nhvx8","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"YOLO 目标检测实战项目『原理篇』"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/b5hjxd3dqh-20260206210943-qmv08ui.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210943-i2o6957","Type":"NodeParagraph","Properties":{"id":"20260206210943-i2o6957","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/2490901?policyId=1003","TextMarkTextContent":"简单聊一聊 YOLO 系列的发展历程，对于每一次改进，改进的点在哪？"}]},{"ID":"20260206210943-ojgqdx1","Type":"NodeParagraph","Properties":{"id":"20260206210943-ojgqdx1","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10539","TextMarkTextContent":"人工智能"}]},{"ID":"20260206210943-47txm5k","Type":"NodeParagraph","Properties":{"id":"20260206210943-47txm5k","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/2490901?policyId=1003","TextMarkTextContent":"YOLO（You Only Look Once）是由 Joseph Redmon 等人在 2016 年首次提出的实时目标检测算法。自那时起，YOLO 经历了多次迭代和改进，每个版本都在性能、速度和精度方面有所提升。以下是 YOLO 系列的主要版本及其改进点："}]},{"ID":"20260206210943-w8h4el6","Type":"NodeParagraph","Properties":{"id":"20260206210943-w8h4el6","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"代码小李"}]},{"ID":"20260206210943-07uul0g","Type":"NodeParagraph","Properties":{"id":"20260206210943-07uul0g","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"2025/01/23"}]},{"ID":"20260206210943-cvhszyw","Type":"NodeParagraph","Properties":{"id":"20260206210943-cvhszyw","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"2K0"}]},{"ID":"20260206210943-p6moig9","Type":"NodeParagraph","Properties":{"id":"20260206210943-p6moig9","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/2495896?policyId=1003","TextMarkTextContent":"《探秘目标检测算法：YOLO与Faster R-CNN的原理及发展之旅》"}]},{"ID":"20260206210943-qf0ijxe","Type":"NodeParagraph","Properties":{"id":"20260206210943-qf0ijxe","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/17984","TextMarkTextContent":"第二期热点征文-人工智能"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/18102","TextMarkTextContent":"腾讯技术创作特训营S11#重启人生"}]},{"ID":"20260206210943-kzjid2m","Type":"NodeParagraph","Properties":{"id":"20260206210943-kzjid2m","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/2495896?policyId=1003","TextMarkTextContent":"目标检测作为计算机视觉领域的重要任务，旨在从图像或视频中找出目标的位置和类别。下面将为你介绍YOLO、Faster R-CNN等目标检测算法的原理和发展历程。"}]},{"ID":"20260206210943-kd501e1","Type":"NodeParagraph","Properties":{"id":"20260206210943-kd501e1","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"程序员阿伟"}]},{"ID":"20260206210943-uvh6imu","Type":"NodeParagraph","Properties":{"id":"20260206210943-uvh6imu","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"2025/02/12"}]},{"ID":"20260206210943-79rpsqk","Type":"NodeParagraph","Properties":{"id":"20260206210943-79rpsqk","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"5590"}]},{"ID":"20260206210943-2sgyqna","Type":"NodeParagraph","Properties":{"id":"20260206210943-2sgyqna","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"《探秘目标检测算法：YOLO与Faster R-CNN的原理及发展之旅》"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/b610f119a9971a7177bee2e3dea60e3a-20260206210943-11h1hzd.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210943-dj6sqvw","Type":"NodeParagraph","Properties":{"id":"20260206210943-dj6sqvw","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/1757629?policyId=1003","TextMarkTextContent":"死嗑YOLO系列(三),YOLOv3风月无边"}]},{"ID":"20260206210943-9mg3ctd","Type":"NodeParagraph","Properties":{"id":"20260206210943-9mg3ctd","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10548","TextMarkTextContent":"网站"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10332","TextMarkTextContent":"神经网络"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10333","TextMarkTextContent":"深度学习"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10539","TextMarkTextContent":"人工智能"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10687","TextMarkTextContent":"图像识别"}]},{"ID":"20260206210943-806swkx","Type":"NodeParagraph","Properties":{"id":"20260206210943-806swkx","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/1757629?policyId=1003","TextMarkTextContent":"YOLOv2 的时候，作者在 YOLOv1 的基础上运用了许多有效的 tricks，所以展示了它的 better、faster、stronger 因素，到了 YOLOv3 的时候，这个模型仍然在进化，保持速度的同时，把准确率给提升了许多。"}]},{"ID":"20260206210943-tmg06an","Type":"NodeParagraph","Properties":{"id":"20260206210943-tmg06an","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"Frank909"}]},{"ID":"20260206210943-igockv2","Type":"NodeParagraph","Properties":{"id":"20260206210943-igockv2","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"2020/12/08"}]},{"ID":"20260206210943-3uyjk7b","Type":"NodeParagraph","Properties":{"id":"20260206210943-3uyjk7b","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"8760"}]},{"ID":"20260206210943-kduqq1q","Type":"NodeParagraph","Properties":{"id":"20260206210943-kduqq1q","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/2414854?policyId=1003","TextMarkTextContent":"深度学习500问——Chapter08：目标检测（5）"}]},{"ID":"20260206210943-vvyzdmj","Type":"NodeParagraph","Properties":{"id":"20260206210943-vvyzdmj","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/17302","TextMarkTextContent":"基础"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/17381","TextMarkTextContent":"模型"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/17440","TextMarkTextContent":"数据"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/17484","TextMarkTextContent":"网络"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10333","TextMarkTextContent":"深度学习"}]},{"ID":"20260206210943-lmjc6o4","Type":"NodeParagraph","Properties":{"id":"20260206210943-lmjc6o4","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/2414854?policyId=1003","TextMarkTextContent":"YOLOv1虽然检测速度快，但在定位方面不够准确，并且召回率较低。为了提升定位准确度。改善召回率，YOLOv2在YOLOv1的基础上提出了几种改进策略，如下图所示。可以看到，一些改进方法能有效提高模型的mAP。"}]},{"ID":"20260206210943-wdh2rdh","Type":"NodeParagraph","Properties":{"id":"20260206210943-wdh2rdh","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"JOYCE"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"_"}]},{"Type":"NodeText","Data":"Leo16"}]},{"ID":"20260206210943-6616uyk","Type":"NodeParagraph","Properties":{"id":"20260206210943-6616uyk","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"2024/05/05"}]},{"ID":"20260206210943-3kodu6t","Type":"NodeParagraph","Properties":{"id":"20260206210943-3kodu6t","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"4430"}]},{"ID":"20260206210943-0rody86","Type":"NodeParagraph","Properties":{"id":"20260206210943-0rody86","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"深度学习500问——Chapter08：目标检测（5）"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/727d5d8c52ddca8c6d17ad31df816713-20260206210943-pl0bhuk.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210943-ylushye","Type":"NodeParagraph","Properties":{"id":"20260206210943-ylushye","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/2212232?policyId=1003","TextMarkTextContent":"YOLO家族系列模型的演变：从v1到v8（上）"}]},{"ID":"20260206210943-m2sjhkl","Type":"NodeParagraph","Properties":{"id":"20260206210943-m2sjhkl","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10333","TextMarkTextContent":"深度学习"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10539","TextMarkTextContent":"人工智能"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10687","TextMarkTextContent":"图像识别"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10332","TextMarkTextContent":"神经网络"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10180","TextMarkTextContent":".net"}]},{"ID":"20260206210943-px4be9u","Type":"NodeParagraph","Properties":{"id":"20260206210943-px4be9u","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/2212232?policyId=1003","TextMarkTextContent":"YOLO V8已经在本月发布了，我们这篇文章的目的是对整个YOLO家族进行比较分析。了解架构的演变可以更好地知道哪些改进提高了性能，并且明确哪些版本是基于那些版本的改进，因为YOLO的版本和变体的命名是目前来说最乱的，希望看完这篇文章之后你能对整个家族有所了解。"}]},{"ID":"20260206210943-oony2an","Type":"NodeParagraph","Properties":{"id":"20260206210943-oony2an","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"deephub"}]},{"ID":"20260206210943-pa1thgh","Type":"NodeParagraph","Properties":{"id":"20260206210943-pa1thgh","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"2023/02/01"}]},{"ID":"20260206210943-lnzddag","Type":"NodeParagraph","Properties":{"id":"20260206210943-lnzddag","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"8.7K0"}]},{"ID":"20260206210943-fmzdrxq","Type":"NodeParagraph","Properties":{"id":"20260206210943-fmzdrxq","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/1958081?policyId=1003","TextMarkTextContent":"Yolo目标检测算法综述"}]},{"ID":"20260206210943-drnyx5w","Type":"NodeParagraph","Properties":{"id":"20260206210943-drnyx5w","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10687","TextMarkTextContent":"图像识别"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10735","TextMarkTextContent":"pytorch"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10332","TextMarkTextContent":"神经网络"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10333","TextMarkTextContent":"深度学习"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10539","TextMarkTextContent":"人工智能"}]},{"ID":"20260206210943-t5xroli","Type":"NodeParagraph","Properties":{"id":"20260206210943-t5xroli","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/1958081?policyId=1003","TextMarkTextContent":"YOLO9000 使用 YOLOv2 模型，采用联合训练算法训练，拥有9000类的分类信息。"}]},{"ID":"20260206210943-xrq4bo4","Type":"NodeParagraph","Properties":{"id":"20260206210943-xrq4bo4","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"杨丝儿"}]},{"ID":"20260206210943-cg1kyov","Type":"NodeParagraph","Properties":{"id":"20260206210943-cg1kyov","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"2022/03/17"}]},{"ID":"20260206210943-5ahrjgx","Type":"NodeParagraph","Properties":{"id":"20260206210943-5ahrjgx","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"1.3K0"}]},{"ID":"20260206210943-zk9ly4q","Type":"NodeParagraph","Properties":{"id":"20260206210943-zk9ly4q","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"Yolo目标检测算法综述"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/93bba0748ce2860576638b571dbb5b65-20260206210943-kfmrv0d.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210943-fk6r7pz","Type":"NodeParagraph","Properties":{"id":"20260206210943-fk6r7pz","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/1640624?policyId=1003","TextMarkTextContent":"知识精讲 | Yolov3和Yolov4核心内容、代码梳理"}]},{"ID":"20260206210943-ocnqedn","Type":"NodeParagraph","Properties":{"id":"20260206210943-ocnqedn","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10813","TextMarkTextContent":"https"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10681","TextMarkTextContent":"网络安全"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10687","TextMarkTextContent":"图像识别"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10332","TextMarkTextContent":"神经网络"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10333","TextMarkTextContent":"深度学习"}]},{"ID":"20260206210943-o4dtyq2","Type":"NodeParagraph","Properties":{"id":"20260206210943-o4dtyq2","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/1640624?policyId=1003","TextMarkTextContent":"从2018年Yolov3年提出的两年后，在原作者声名放弃更新Yolo算法后，俄罗斯的Alexey大神扛起了Yolov4的大旗。"}]},{"ID":"20260206210943-9lne9hx","Type":"NodeParagraph","Properties":{"id":"20260206210943-9lne9hx","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"新智元"}]},{"ID":"20260206210943-m5f2a4x","Type":"NodeParagraph","Properties":{"id":"20260206210943-m5f2a4x","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"2020/06/09"}]},{"ID":"20260206210943-a7bra9w","Type":"NodeParagraph","Properties":{"id":"20260206210943-a7bra9w","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"2.1K0"}]},{"ID":"20260206210943-cxuezy6","Type":"NodeParagraph","Properties":{"id":"20260206210943-cxuezy6","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"知识精讲 | Yolov3和Yolov4核心内容、代码梳理"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/pt2gd9p22d-20260206210943-0fl7nug.jpeg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210943-4dxcncd","Type":"NodeParagraph","Properties":{"id":"20260206210943-4dxcncd","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/1948639?policyId=1003","TextMarkTextContent":"【深度学习】目标检测"}]},{"ID":"20260206210943-vsup275","Type":"NodeParagraph","Properties":{"id":"20260206210943-vsup275","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10687","TextMarkTextContent":"图像识别"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10149","TextMarkTextContent":"机器学习"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10333","TextMarkTextContent":"深度学习"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10539","TextMarkTextContent":"人工智能"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10663","TextMarkTextContent":"编程算法"}]},{"ID":"20260206210943-ema9cxk","Type":"NodeParagraph","Properties":{"id":"20260206210943-ema9cxk","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/1948639?policyId=1003","TextMarkTextContent":"目标检测（Object Detection）的任务是找出图像中所有感兴趣的目标（物体），确定它们的类别和位置，是计算机视觉领域的核心问题之一。由于各类物体有不同的外观、形状和姿态，加上成像时光照、遮挡等因素的干扰，目标检测一直是计算机视觉领域最具有挑战性的问题。"}]},{"ID":"20260206210943-1b9z8tv","Type":"NodeParagraph","Properties":{"id":"20260206210943-1b9z8tv","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"杨丝儿"}]},{"ID":"20260206210943-blyem3o","Type":"NodeParagraph","Properties":{"id":"20260206210943-blyem3o","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"2022/03/01"}]},{"ID":"20260206210943-ab2maw4","Type":"NodeParagraph","Properties":{"id":"20260206210943-ab2maw4","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"3.6K0"}]},{"ID":"20260206210943-y9dgqox","Type":"NodeParagraph","Properties":{"id":"20260206210943-y9dgqox","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"【深度学习】目标检测"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/383a1aff8db12f1fbe583c70333406c5-20260206210943-5v2cz71.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210943-nr5rb20","Type":"NodeParagraph","Properties":{"id":"20260206210943-nr5rb20","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/2251423?policyId=1003","TextMarkTextContent":"超越全系列YOLO、Anchor-free+技巧组合，旷视开源性能更强的YOLOX"}]},{"ID":"20260206210943-j7jzi1n","Type":"NodeParagraph","Properties":{"id":"20260206210943-j7jzi1n","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/10667","TextMarkTextContent":"开源"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/17304","TextMarkTextContent":"技巧"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/17381","TextMarkTextContent":"模型"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/17440","TextMarkTextContent":"数据"},{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/tag/17525","TextMarkTextContent":"性能"}]},{"ID":"20260206210943-nry0xxb","Type":"NodeParagraph","Properties":{"id":"20260206210943-nry0xxb","updated":"20260206210943"},"Children":[{"Type":"NodeTextMark","TextMarkType":"a","TextMarkAHref":"https://cloud.tencent.com/developer/article/2251423?policyId=1003","TextMarkTextContent":"机器之心报道 编辑：杜伟、陈萍 在本文中，来自旷视的研究者提出高性能检测器 YOLOX，并对 YOLO 系列进行了经验性改进，将 Anchor-free、数据增强等目标检测领域先进技术引入 YOLO。获得了超越 YOLOv3、YOLOv4 和 YOLOv5 的 AP，而且取得了极具竞争力的推理速度。 随着目标检测技术的发展，YOLO 系列始终追寻可以实时应用的最佳速度和准确率权衡。学界人士不断提取当时最先进的检测技术（如 YOLOv2 的 anchor、YOLOv3 的残差网络），并对这些检测技术进行优化以"}]},{"ID":"20260206210943-cxveqxm","Type":"NodeParagraph","Properties":{"id":"20260206210943-cxveqxm","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"机器之心"}]},{"ID":"20260206210943-jt6pzxe","Type":"NodeParagraph","Properties":{"id":"20260206210943-jt6pzxe","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"2023/03/29"}]},{"ID":"20260206210943-1s8hsx0","Type":"NodeParagraph","Properties":{"id":"20260206210943-1s8hsx0","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"1.1K0"}]},{"ID":"20260206210943-f3yufnn","Type":"NodeParagraph","Properties":{"id":"20260206210943-f3yufnn","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"超越全系列YOLO、Anchor-free+技巧组合，旷视开源性能更强的YOLOX"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/afc1660a00662b38ebf4046da3bbe287-20260206210943-0tfe2gy.jpg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260206210943-11bt2gc","Type":"NodeParagraph","Properties":{"id":"20260206210943-11bt2gc","updated":"20260206210943"},"Children":[{"Type":"NodeText","Data":"推荐阅读"}]},{"ID":"20260206