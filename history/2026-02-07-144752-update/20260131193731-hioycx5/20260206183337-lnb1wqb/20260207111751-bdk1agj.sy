"Data":"_"}]},{"Type":"NodeText","Data":"i呼应上了吧！"}]},{"ID":"20260207144729-8kixary","Type":"NodeParagraph","Properties":{"id":"20260207144729-8kixary","updated":"20260207144729"},"Children":[{"Type":"NodeText","Data":"这里的W们也是训练得到的三个矩阵，没啥好说的。"}]}]},{"ID":"20260207144729-5abploa","Type":"NodeParagraph","Properties":{"id":"20260207144729-5abploa","updated":"20260207144729"},"Children":[{"Type":"NodeText","Data":"然后分别通过单头注意力机制模块输入各自输出一个矩阵，每个矩阵的大小是3"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"\\"}]},{"Type":"NodeText","Data":"times 2的矩阵，总共得到这样相同的三个矩阵，分别是out"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"_"}]},{"Type":"NodeText","Data":"1,out"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"_"}]},{"Type":"NodeText","Data":"2,out"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"_"}]},{"Type":"NodeText","Data":"3。"}]},{"ID":"20260207144729-2tq9jpo","Type":"NodeParagraph","Properties":{"id":"20260207144729-2tq9jpo","updated":"20260207144729"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/image-20260207144729-r6xyn43.svg"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260207144729-plqxfyq","Type":"NodeParagraph","Properties":{"id":"20260207144729-plqxfyq","updated":"20260207144729"},"Children":[{"Type":"NodeText","Data":"有了这三个表征不同类型特征的矩阵之后，就需要对着三个矩阵进行合成，这里的合成方法是耳熟能详的"},{"Type":"NodeTextMark","TextMarkType":"em","TextMarkTextContent":"Concat"},{"Type":"NodeText","Data":"方法，如下图所示。"}]},{"ID":"20260207144729-ewkivl2","Type":"NodeParagraph","Properties":{"id":"20260207144729-ewkivl2","updated":"20260207144729"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image-20260128152139319"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/network-asset-image-20260128152139319-20260207144734-qwgi1jk.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260207144729-8xrs3r4","Type":"NodeParagraph","Properties":{"id":"20260207144729-8xrs3r4","updated":"20260207144729"},"Children":[{"Type":"NodeText","Data":"拼接后得到的矩阵是一个更大的矩阵，矩阵的大小是3"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"\\"}]},{"Type":"NodeText","Data":"times 6。也就是经过concat拼接操作后得到的矩阵，现在进行一次线性变换就得到了多头注意力真正的输出。"}]},{"ID":"20260207144729-eoaplgs","Type":"NodeParagraph","Properties":{"id":"20260207144729-eoaplgs","updated":"20260207144729"},"Children":[{"Type":"NodeText","Data":"​"},{"Type":"NodeImage","Data":"span","Children":[{"Type":"NodeBang"},{"Type":"NodeOpenBracket"},{"Type":"NodeLinkText","Data":"image-20260128153443736"},{"Type":"NodeCloseBracket"},{"Type":"NodeOpenParen"},{"Type":"NodeLinkDest","Data":"assets/network-asset-image-20260128153443736-20260207144734-s40eqqf.png"},{"Type":"NodeCloseParen"}]},{"Type":"NodeText","Data":"​"}]},{"ID":"20260207144729-gquzdp6","Type":"NodeParagraph","Properties":{"id":"20260207144729-gquzdp6","updated":"20260207144729"},"Children":[{"Type":"NodeText","Data":"其中经过线性变换过程中的矩阵为W"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"^"}]},{"Type":"NodeText","Data":"o这个矩阵的大小也是一个6 "},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"\\"}]},{"Type":"NodeText","Data":"times 6大小的矩阵，经过这个矩阵后将原本的这个矩阵就进行特征融合的操作，最后就获得了一个和输入矩阵维度完全相同的一个矩阵。"}]},{"ID":"20260207144729-kv9efln","Type":"NodeParagraph","Properties":{"id":"20260207144729-kv9efln","updated":"20260207144729"},"Children":[{"Type":"NodeText","Data":"最后输出的矩阵大小为6"},{"Type":"NodeBackslash","Data":"span","Children":[{"Type":"NodeText","Data":"\\"}]},{"Type":"NodeText","Data":"times 6和输入矩阵的